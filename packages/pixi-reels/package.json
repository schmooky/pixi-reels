{
  "name": "pixi-reels",
  "version": "1.2.0",
  "description": "A batteries-included slot machine reel engine for PixiJS v8 — fluent builder, typed events, spin phases, speed modes, win spotlight, and a headless testing harness.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./spine": {
      "import": {
        "types": "./dist/spine/index.d.ts",
        "default": "./dist/spine.js"
      },
      "require": {
        "types": "./dist/spine/index.d.cts",
        "default": "./dist/spine.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "spine": ["./dist/spine/index.d.ts"],
      "testing": ["./dist/testing/index.d.ts"]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vite build && node scripts/postbuild-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "check:pkg": "publint --strict && attw --pack"
  },
  "peerDependencies": {
    "@esotericsoftware/spine-pixi-v8": "~4.2.110",
    "gsap": "^3.15.0",
    "pixi.js": "^8.18.1"
  },
  "peerDependenciesMeta": {
    "@esotericsoftware/spine-pixi-v8": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@esotericsoftware/spine-pixi-v8": "~4.2.110",
    "gsap": "^3.15.0",
    "pixi.js": "^8.18.1",
    "publint": "^0.3.21",
    "typescript": "^6.0.3",
    "vite": "^8.0.9",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.7"
  },
  "license": "MIT",
  "author": "schmooky",
  "homepage": "https://pixi-reels.schmooky.dev",
  "bugs": {
    "url": "https://github.com/schmooky/pixi-reels/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmooky/pixi-reels.git",
    "directory": "packages/pixi-reels"
  },
  "keywords": [
    "pixi",
    "pixijs",
    "pixi.js",
    "slot",
    "reel",
    "reels",
    "casino",
    "slot-machine",
    "game",
    "gamedev",
    "html5-game",
    "spine",
    "animation",
    "gsap",
    "typescript"
  ]
}
