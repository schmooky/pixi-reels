{
  "name": "pixi-reels-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "pixi-reels monorepo \u2014 open-source slot machine reel engine for PixiJS v8.",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter pixi-reels build",
    "build:all": "node scripts/build-all-publishable.mjs",
    "test": "pnpm check:lint && pnpm --filter pixi-reels test && pnpm --filter pixi-reels-codemod test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "pnpm --filter pixi-reels typecheck && pnpm typecheck:fixtures",
    "lint": "pnpm --filter pixi-reels lint",
    "check:no-fancy-unicode": "node scripts/check-no-fancy-unicode.mjs",
    "check:imports": "biome lint packages/pixi-reels/src",
    "check:lint": "pnpm check:no-fancy-unicode && pnpm check:imports && pnpm check:recipe-globals && pnpm check:v1-keys && pnpm check:recipe-syntax && pnpm check:codemod-parity && pnpm check:migration-coverage && pnpm check:api-surface",
    "commitlint": "commitlint --edit",
    "site:dev": "pnpm --filter @pixi-reels/site dev",
    "site:build": "pnpm --filter @pixi-reels/site build",
    "site:preview": "pnpm --filter @pixi-reels/site preview",
    "share-api:dev": "pnpm --filter @pixi-reels/share-api dev",
    "share-api:build": "pnpm --filter @pixi-reels/share-api build",
    "share-api:start": "pnpm --filter @pixi-reels/share-api start",
    "share-api:typecheck": "pnpm --filter @pixi-reels/share-api typecheck",
    "symbols:build": "pnpm --filter pixi-reels-symbol-gen build",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build:all && changeset publish",
    "snapshot": "node scripts/snapshot-release.mjs",
    "size": "node scripts/size-check.mjs",
    "size:check": "node scripts/size-check.mjs --check",
    "size:update": "node scripts/size-check.mjs --update",
    "prepare": "husky || true",
    "check:recipe-globals": "node scripts/check-recipe-globals.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:v1-keys": "node scripts/check-v1-keys.mjs",
    "check:recipe-syntax": "node scripts/check-recipe-syntax.mjs",
    "check:codemod-parity": "node scripts/check-codemod-parity.mjs",
    "check:publish-contents": "node scripts/check-publish-contents.mjs",
    "check:migration-coverage": "node scripts/check-migration-coverage.mjs",
    "check:api-surface": "node scripts/check-api-surface.mjs",
    "typecheck:fixtures": "pnpm --filter @pixi-reels/cheats typecheck && pnpm --filter orientation-matrix typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,md,mdx,astro,yml,yaml,json}": [
      "node scripts/check-no-fancy-unicode.mjs"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.60.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
