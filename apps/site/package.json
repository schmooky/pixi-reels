{
  "name": "@pixi-reels/site",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-assets": "node -e \"const fs=require('fs');fs.mkdirSync('src/generated',{recursive:true});fs.copyFileSync('../../packages/pixi-reels/CHANGELOG.md','src/generated/CHANGELOG.md');\"",
    "llms:gen": "node scripts/build-llms.mjs",
    "api:gen": "typedoc && node scripts/postprocess-api.mjs",
    "api:check-sync": "node scripts/check-api-sync.mjs",
    "predev": "pnpm sync-assets && pnpm api:gen && pnpm llms:gen",
    "prebuild": "pnpm sync-assets && pnpm api:gen && pnpm llms:gen",
    "prepreview": "pnpm sync-assets && pnpm api:gen && pnpm llms:gen",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^6.0.5",
    "@esotericsoftware/spine-pixi-v8": "~4.2.110",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.57.0",
    "mermaid": "^11.17.2",
    "pixi-reels": "workspace:*",
    "pixi-silk": "^0.1.0",
    "pixi.js": "^8.20.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "yaml": "^2.9.1",
    "@pixi-reels/cheats": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.5.2",
    "satori": "^0.60.0",
    "sharp": "^0.35.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.0",
    "typescript": "^6.0.3"
  }
}
