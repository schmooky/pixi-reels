---
import Architecture from '../../layouts/Architecture.astro';
import Diagram from '../../components/arch/Diagram.astro';
import Box from '../../components/arch/Box.astro';
import Edge from '../../components/arch/Edge.astro';
import Group from '../../components/arch/Group.astro';
import Label from '../../components/arch/Label.astro';
import Legend from '../../components/arch/Legend.astro';

const th = 'text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground';

const LAYERS: [string, string, string, string][] = [
  ['mask', 'red', 'A 2px box around the viewport mask, plus dashed green per-reel maskRects.', 'What the viewport clips; whether the strategy is shared or per reel.'],
  ['cells', 'cyan', 'Every visible cell from getCellBounds, or the trapezoid from getCellQuad on a curved reel, each with a "reel,cell" chip.', 'Cell geometry and indexing (visibleCells per reel).'],
  ['buffers', 'amber, dashed, alpha 0.6', 'The bufferStart and bufferEnd cells, following the drum curve.', 'Buffer indexing: which off-screen slots exist.'],
  ['thresholds', 'red, dashed', 'The two wrap lines at main = -(bufferStart + 1) × pitch and (visibleCells + bufferEnd) × pitch.', 'L7 periodicity and L9 boundedness of the motion contract.'],
  ['axis', 'green', 'One arrow per reel from 20% to 80% of the span, pointing by polarity; reversed reels point backwards.', 'Travel direction per reel.'],
  ['feed', 'sky', 'A bar at the feed edge, derived from polarity. It must agree with the axis arrow.', 'L14, the feed edge: where new symbols enter.'],
  ['bounds', 'pink', 'World getBounds() of every visible symbol, mapped to local space.', 'Spine or sprite overrun past the cell.'],
  ['blocks', 'yellow', 'Big-symbol getBlockBounds, drawn once at the anchor.', 'Block geometry and anchoring.'],
  ['pins', 'purple', 'The pin cell outline plus a green diagonal cross on the overlay.', 'A cross off its cell means movePin and the overlay disagree.'],
  ['hud', 'plaque', 'A DebugPlaque in the mask top-left: one row per reel, r<i> VF feed=... spd=... <phase> cells=..., with a phase swatch and a |speedNormalized| meter.', 'Live per-reel state without a console.'],
  ['metrics', 'plaque, 232px', 'A fixed-width plaque below the mask: title ROUND n profile live|skipped|done [boosted]; rows time (first stop), land order (max gap), tease per reel, skip (mode, reels, partial, @t, ×count or queued), swaps and events, fps/pins/spotlight, wins/chains. Placeholder rows before the first round keep its height fixed.', 'The SpinMetrics round as text.'],
  ['timeline', 'panel', 'Below the mask: a legend of phases seen, a time grid (niceStep), one lane per reel (7px lanes, 4px gaps) with phase spans, an amber tease underline, a speed polyline clamped to 1.25 and downsampled to about a point per pixel, a tick at stoppingAt and a dot at landedAt, dashed skip lines (slam red, quicken yellow) and a live cursor. Minimum span 500 ms.', 'Stagger, tease and skip timing per reel.'],
];

const NOTICES: [string, string, string][] = [
  ['error', 'phase-chain-threw', 'spin/SpinController.ts; the engine slams to recover'],
  ['error', 'refill-threw', 'SpinController.ts refill'],
  ['error', 'pin-hook-threw', 'core/ReelSet.ts movePin hooks'],
  ['warn', 'destroy-rejected', 'ReelSet.ts destroySymbols'],
  ['warn', 'anticipation-cells-unreachable', 'SpinController.ts; a final curve leg at speed 0'],
  ['warn', 'hw-coin-<anim>-failed', 'board/HoldAndWinBoard.ts'],
  ['warnOnce', 'buffer-clamped', 'core/ReelSetBuilder.ts'],
  ['warnOnce', 'mask-rounded-touching', 'core/maskStrategies.ts'],
  ['warnOnce', 'mask-silhouette-disjoint', 'core/maskStrategies.ts'],
  ['warnOnce', 'shared-mask-jagged', 'ReelSet.ts _setColumn'],
  ['warnOnce', 'quicken-cascade', 'SpinController.ts; a quicken press in cascade mode becomes a slam'],
  ['warnOnce', 'anticipation-curve-cascade', 'SpinController.ts'],
  ['warnOnce', 'wide-block-misaligned', 'SpinController.ts'],
  ['warnOnce', 'anticipation-drive-budget', 'spin/phases/AnticipationPhase.ts'],
  ['warnOnce', 'profile-step-<phase>-<name>', 'spin/phases/ReelPhase.ts; an unknown step in a speed profile section'],
  ['info', 'mask-auto-shared', 'ReelSetBuilder.ts; an unmask symbol with a cross gap picked SharedRectMaskStrategy'],
  ['info', 'warp-skips-unmask', 'ReelSetBuilder.ts'],
];

const PLAQUE_OPTS: [string, string][] = [
  ['title · rows · text', "rows are strings or { text, color, swatch, meter 0-1, meterColor }; text is a drop-in for a Text"],
  ['fontSize · color · fill · fillAlpha', '11 · 0xe7e5e4 · 0x0b0e14 · 0.84'],
  ['radius', "fontSize × 0.7, or 'pill'"],
  ['padding · anchor · align · minWidth · maxWidth', 'maxWidth enables word wrap'],
  ['reserveRows · shadow · accent', 'shadow defaults to true; hitArea and boundsArea exclude it'],
];
---
<Architecture
  title="Debug tooling"
  subtitle="Snapshots for agents, the silk overlay, SpinMetrics, notices."
  eyebrow="Instruments"
>
  <p>
    PixiJS draws to a canvas, and a canvas is invisible to an AI agent, to a
    CI runner and to a log file. ADR 006 therefore made the first debug tools
    data-only: <code>debugSnapshot()</code> returns plain JSON with no PixiJS
    types and no cycles, <code>debugGrid()</code> returns an ASCII table, and
    <code>enableDebug()</code> puts both on <code>window</code> so an agent
    can <code>eval('__PIXI_REELS_DEBUG.log()')</code> in a console. The
    drawing tools came later, in a separate subpath on pixi-silk (ADR 022,
    <code>docs/adr/022-debug-subpath-on-pixi-silk.md</code>), so the
    main entry never pulls in a renderer-dependent dependency. The
    <a href="/guides/debugging/">debugging guide</a> shows the tools in use;
    this page is how they are built.
  </p>

  <h2>Two halves</h2>

  <p>
    The main entry is JSON and text. The <code>pixi-reels/debug</code>
    subpath draws with pixi-silk. Both only read from the <code>ReelSet</code>:
    its events through <code>onAny</code>, and its geometry through
    <code>getCellBounds</code>, <code>getCellQuad</code>, the reels, the pins
    and the viewport. Neither writes to it.
  </p>

  <Diagram height={430} caption="The main entry, data only. enableDebug() installs a global whose methods return plain JSON and ASCII; it is a no-op without window and keeps one SpinMetrics per set.">
    <Box x={20} y={20} w={300} h={60} title="enableDebug(reelSet, key?)" sub="installs the global, data only" />
    <Box x={20} y={116} w={300} h={78} title="window.__PIXI_REELS_DEBUG" kind="code" sub={['snapshot() · grid() · log() · trace()', 'metrics() · start/stopRecording()']} />
    <Box x={20} y={242} w={300} h={60} title="debugSnapshot(reelSet)" sub="plain JSON, no PixiJS types, no cycles" />
    <Box x={20} y={350} w={300} h={60} title="debugGrid(reelSet)" sub="an ASCII box table" />
    <Edge from={[170, 80]} to={[170, 116]} />
    <Edge from={[170, 194]} to={[170, 242]} label="snapshot()" />
    <Edge from={[170, 302]} to={[170, 350]} label="grid()" />
    <Box x={440} y={116} w={220} h={78} title="ReelSet" kind="primary" sub={['events, via onAny', 'reels · pins · viewport']} />
    <Edge from={[320, 155]} to={[440, 155]} style="dashed" label="reads" />
  </Diagram>

  <Diagram height={280} caption="The pixi-reels/debug subpath, which needs pixi-silk. debugOverlay() draws twelve layers at zIndex 1e6 with eventMode none, owns a SpinMetrics unless you pass one, and draws its hud and metrics panels on DebugPlaque.">
    <Box x={20} y={29} w={130} h={60} title="ReelSet" kind="primary" sub="read only" />
    <Box x={260} y={20} w={320} h={78} title="debugOverlay(reelSet, opts)" kind="accent" sub={['12 silk layers, in draw order', 'root zIndex 1e6, eventMode none']} />
    <Edge from={[260, 59]} to={[150, 59]} style="dashed" label="reads" />
    <Box x={20} y={170} w={200} h={78} title="SpinMetrics" sub={['rounds, spans, skips, speed', 'onAny on every bus']} />
    <Box x={240} y={170} w={200} h={78} title="DebugPlaque" sub={['mono rows on a silk plate', 'behind hud and metrics']} />
    <Box x={460} y={170} w={240} h={78} title="roundRectPath · WinLines" sub={['dashable rounded rects', 'paylines and payways']} />
    <Edge from={[300, 98]} via={[[300, 134], [120, 134]]} to={[120, 170]} label="owns or borrows" />
    <Edge from={[340, 98]} to={[340, 170]} />
    <Edge from={[500, 98]} via={[[500, 134], [580, 134]]} to={[580, 170]} />
  </Diagram>

  <div class="not-prose my-8">
    <Legend items={[
      { kind: 'primary', label: 'ReelSet', note: 'the thing being observed' },
      { kind: 'accent', label: 'debugOverlay', note: 'the drawing entry point' },
      { kind: 'subtle', label: 'tools', note: 'data on the left, silk on the right' },
    ]} />
  </div>

  <h2>The main-entry tools</h2>

  <p>
    <code>debug/debug.ts</code>. <code>DebugSnapshot</code> is
    <code>{'{ timestamp, isSpinning, currentSpeed, availableSpeeds, spotlightActive, reelCount, visibleCells: number[], reels: DebugReelSnapshot[], grid: string[][] }'}</code>.
    <code>visibleCells</code> is one entry per reel (a breaking change since
    v0.3). Each <code>DebugReelSnapshot</code> has <code>index</code>,
    <code>speed</code>, <code>isStopping</code>, <code>orientation</code>,
    <code>direction</code>, <code>allSymbols: {'{ cell, symbolId, main }[]'}</code>
    and <code>visibleSymbols</code>. <code>main</code> is the rounded
    position along the travel axis; it used to be a hard-coded <code>y</code>,
    which read 0 on horizontal sets. <code>grid</code> comes from
    <code>reelSet.getVisibleGrid()</code>, so big-symbol OCCUPIED cells show
    the anchor's id. <code>debugGrid()</code> returns an ASCII box table with
    8-character columns, blank cells for jagged reels, and
    <code>'(empty grid)'</code> for an empty set.
  </p>

  <p>
    <code>enableDebug(reelSet, key?)</code> installs the surface on
    <code>window.__PIXI_REELS_DEBUG</code> and on
    <code>__PIXI_REELS_DEBUG_INSTANCES[key]</code>, where the key defaults to
    <code>reelset_&lt;n&gt;</code> and the bare global points at the most
    recently enabled set. It creates one <code>SpinMetrics</code> per set
    (kept in a WeakMap, so re-enabling reuses it) with no ticker, so rounds
    are recorded from that moment on. <code>log()</code> prints the spinning
    flag, speed and grid and returns the snapshot; <code>trace()</code> logs
    every set-bus event through <code>onAny</code> and returns a stop
    function; <code>metrics()</code> is <code>SpinMetrics.snapshot()</code>.
    ADR 022 removed its drawing helpers (<code>showMask()</code>,
    <code>overlay()</code>), so it is data only. The snapshot is not
    semver-protected: do not wire telemetry to it.
  </p>

  <h3>The frame recorder</h3>

  <p>
    <code>startRecording(reelSet, tag = 'default', {'{ maxFrames }'})</code>
    captures a <code>RecordedFrame {'{ tag, trigger, snapshot }'}</code> on
    <code>spin:start</code>, <code>spin:reelLanded</code>,
    <code>spin:allLanded</code> and <code>spin:complete</code>, and detaches
    itself on <code>destroyed</code>. Calling it again on the same set
    replaces the recorder. The buffer is one process-wide rolling log with
    <code>DEFAULT_MAX_FRAMES = 1000</code>; <code>maxFrames</code> changes
    that cap globally, not per session. <code>stopRecording(reelSet)</code>,
    <code>getFrames(tag?)</code> (a copy, filtered by tag) and
    <code>clearFrames()</code> complete the set. Recorders are tracked in a
    <code>WeakMap&lt;ReelSet&gt;</code>.
  </p>

  <h2>The overlay</h2>

  <p>
    <code>debugOverlay(reelSet, options) → DebugOverlayHandle</code> in
    <code>debug/debugOverlay.ts</code>. Why pixi-silk: Pixi <code>Graphics</code>
    tessellates, so 1px lines crawl and corners facet when the set is scaled
    down. SilkGraphics renders shapes as exact signed distance fields,
    anti-aliased at any scale, with dashes drawn in the shader and one draw
    call per object. pixi-silk 0.1 is WebGL2 only; on WebGPU only the plaque
    text renders, and headless tests need a <code>DOMAdapter</code> canvas
    without WebGL. The packaging follows <code>pixi-reels/spine</code> (ADR 011).
  </p>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60"><tr><th class={th}>Layer</th><th class={th}>Colour</th><th class={th}>Draws</th><th class={th}>Makes visible</th></tr></thead>
        <tbody>
          {LAYERS.map(([name, color, draws, shows]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs">{name}</td>
              <td class="px-4 py-2 text-xs text-muted-foreground whitespace-nowrap">{color}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{draws}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{shows}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p>
    Options: <code>layers</code> (a <code>DebugOverlayLayer[]</code> or
    <code>'all'</code>, default <code>'all'</code>), <code>live</code> (default
    false), <code>ticker</code> (default <code>Ticker.shared</code> when live;
    pass the set's own ticker or a <code>FakeTicker</code> to stay in
    lock-step) and <code>metrics</code> (a <code>SpinMetrics</code> you keep
    ownership of; without one the overlay records its own from now on,
    sampling speed on the live ticker, and destroys it with itself).
  </p>

  <Diagram height={304} caption="Two redraw schedules. The static layers are cleared and redrawn together on redraw(), setLayers() and the geometry events (shape:changed, adjust:complete, rows:*, column:set, reels:*). The live layers redraw every tick when live; when not live, the three panels follow every set event and bounds, blocks and pins wait for redraw().">
    <Box x={20} y={20} w={324} h={60} title="redraw() · setLayers()" kind="ghost" sub="and the geometry events" />
    <Box x={376} y={20} w={324} h={60} title="ticker tick" kind="ghost" mono={false} sub="when live, else any set event" />
    <Edge from={[182, 80]} to={[182, 116]} kind="primary" />
    <Edge from={[538, 80]} to={[538, 116]} kind="primary" />

    <Group x={20} y={116} w={324} h={168} kind="solid" label="static layers" note="redrawn together" />
    {[['mask', 52, 64], ['cells', 132, 72], ['buffers', 220, 92]].map(([t, x, w]) => (
      <Box x={x as number} y={164} w={w as number} h={40} title={t as string} size={13} />
    ))}
    {[['thresholds', 44, 116], ['axis', 176, 64], ['feed', 256, 64]].map(([t, x, w]) => (
      <Box x={x as number} y={220} w={w as number} h={40} title={t as string} size={13} />
    ))}

    <Group x={376} y={116} w={324} h={168} kind="solid" label="live layers" />
    {[['bounds', 412, 80], ['blocks', 508, 80], ['pins', 604, 60]].map(([t, x, w]) => (
      <Box x={x as number} y={164} w={w as number} h={40} title={t as string} size={13} kind="accent" />
    ))}
    {[['hud', 402, 56], ['metrics', 474, 88], ['timeline', 578, 96]].map(([t, x, w]) => (
      <Box x={x as number} y={220} w={w as number} h={40} title={t as string} size={13} kind="accent" />
    ))}
  </Diagram>

  <p>
    Layers switched off by <code>setLayers()</code> are cleared and hidden,
    and the overlay destroys itself on the set's <code>destroyed</code> event.
    The handle has <code>setLayers()</code>, <code>redraw()</code>,
    <code>describe()</code>, <code>metrics</code>, <code>destroy()</code> and
    <code>isDestroyed</code>. <code>describe()</code> returns a
    <code>DebugOverlaySnapshot {'{ layers, reels: DebugOverlayReelInfo[], round: DebugRound | null }'}</code>;
    each reel info has <code>reel</code>, <code>orientation</code>,
    <code>direction</code>, <code>feedEdge</code>,
    <code>axisArrow {'{ fromMain, toMain }'}</code> (signed, so it encodes
    direction), <code>feedMain</code>, <code>thresholds {'{ start, end }'}</code>,
    <code>visibleCells</code> and <code>phase</code>. The drawing and
    <code>describe()</code> share the same helpers (<code>_arrowMains</code>,
    <code>_feedMain</code>), so the picture and the numbers cannot disagree.
    Each reel's phase is tracked from <code>phase:enter</code> and
    <code>phase:exit</code>; there is no <code>reel.phase</code> accessor.
    Nudge draws pink; the other phase colours come from
    <code>PHASE_CARD_COLORS</code> in <code>symbols/PhaseCardSymbol.ts</code>.
  </p>

  <p>
    The root container sits in the ReelSet at zIndex <code>1_000_000</code>
    with <code>eventMode 'none'</code>, labelled
    <code>OVERLAY_LABEL = 'pixi-reels:debugOverlay'</code>; layers are
    labelled <code>pixi-reels:debugOverlay:&lt;layer&gt;</code> and z-ordered
    by index × 10. The metrics and timeline panels sit side by side when the
    mask leaves at least <code>TIMELINE_MIN_WIDTH = 200</code> px beside the
    232px metrics plaque, otherwise they stack, with <code>PANEL_GAP = 8</code>.
    Both panels are outside the mask, so they enlarge the reel set's bounds:
    re-fit the camera after enabling them.
  </p>

  <h3>DebugPlaque</h3>

  <p>
    A <code>Container</code> and <code>Disposable</code>: rows of monospace
    <code>Text</code> on a SilkGraphics plate, in <code>DEBUG_FONT</code>
    ("Fira Code" with fallbacks). Its size is computed from character count
    times <code>MONO_ADVANCE = 0.6em</code>, not by measuring text, which
    keeps it deterministic in headless tests and cheap enough to update every
    frame. API: <code>update(opts)</code> merges options, <code>setRows()</code>,
    a <code>text</code> getter and setter, <code>plateWidth</code> and
    <code>plateHeight</code>. <code>destroy()</code> destroys its children and
    later writes are ignored.
  </p>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60"><tr><th class={th}>DebugPlaque option</th><th class={th}>Default / meaning</th></tr></thead>
        <tbody>
          {PLAQUE_OPTS.map(([k, v]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs">{k}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p>
    <code>roundRectPath(g, x, y, w, h, radius = 0)</code> traces a rounded
    rectangle as a closed path with quadratic corners because pixi-silk 0.1
    does not dash <code>rect</code> or <code>roundRect</code> strokes. The
    radius is clamped to half the width and height, and strokes are centred
    on the line, so inset by half the stroke width. ADR 022 says it goes once
    silk dashes rect strokes itself. <code>WinLines</code> draws a payline
    through one cell per reel, or a payway joining every winning cell to every
    winning cell on the next reel, at <code>getCellBounds()</code> centres,
    reading the cells at draw time so a board that grew is drawn where it is.
  </p>

  <h2>SpinMetrics</h2>

  <p>
    <code>debug/SpinMetrics.ts</code>, a <code>Disposable</code>. It is
    event-driven: <code>onAny</code> on the set bus and on every reel bus, so
    it costs nothing between spins. It follows <code>reels:added</code> and
    <code>reels:removed</code> and destroys itself on <code>destroyed</code>.
  </p>

  <Diagram height={236} caption="One reel's lane in one round. A round runs from one spin:start to the next, so every cascade refill is its own round; the phase spans and the six marks are stamped in ms since the round opened, and speed samples ride along the lane at about 30 Hz.">
    <Label x={20} y={128} text="r0" mono tone="fg" weight={600} />
    <rect x={60} y={100} width={600} height={48} rx="8" class="lane-bg" />
    <g class="span-start"><rect x={60} y={108} width={80} height={32} rx="4" class="span-start" /><text x={100} y={128.5} text-anchor="middle" font-size="13" class="span-text">start</text></g>
    <g class="span-spin"><rect x={140} y={108} width={240} height={32} class="span-spin" /><text x={260} y={128.5} text-anchor="middle" font-size="13" class="span-text">spin</text></g>
    <g class="span-anticipation"><rect x={380} y={108} width={100} height={32} class="span-anticipation" /><text x={430} y={128.5} text-anchor="middle" font-size="13" class="span-text">tease</text></g>
    <g class="span-stop"><rect x={480} y={108} width={100} height={32} class="span-stop" /><text x={530} y={128.5} text-anchor="middle" font-size="13" class="span-text">stop</text></g>
    <g class="span-bounce"><rect x={580} y={108} width={60} height={32} rx="4" class="span-bounce" /><text x={610} y={128.5} text-anchor="middle" font-size="13" class="span-text">bounce</text></g>

    <line x1={60} y1={88} x2={60} y2={100} class="guide-strong" />
    <Label x={60} y={80} text="spin:start" mono tone="fg" />
    <line x1={140} y1={148} x2={140} y2={160} class="guide-strong" />
    <Label x={140} y={178} text="spin:allStarted" mono tone="fg" anchor="middle" />
    <line x1={260} y1={88} x2={260} y2={160} class="guide-strong" style="stroke-dasharray: 5 4" />
    <Label x={260} y={80} text="skip mark" mono tone="fg" anchor="middle" />
    <line x1={480} y1={100} x2={480} y2={160} class="guide-strong" />
    <Label x={480} y={178} text="stoppingAt" mono tone="fg" anchor="middle" />
    <circle cx={640} cy={124} r="5" class="t-fg" />
    <line x1={640} y1={88} x2={640} y2={119} class="guide-strong" />
    <Label x={640} y={80} text="landedAt" mono tone="fg" anchor="middle" />
    <line x1={660} y1={148} x2={660} y2={160} class="guide-strong" />
    <Label x={660} y={178} text="spin:complete" mono tone="fg" anchor="end" />

    <line x1={60} y1={200} x2={660} y2={200} class="guide" />
    <Label x={60} y={222} text="0 ms" anchor="middle" />
    <Label x={360} y={222} text="ms since the round opened" anchor="middle" />
    <Label x={660} y={222} text="duration" anchor="middle" />
  </Diagram>

  <p>
    Per reel a round records <code>phases[] {'{ phase, start, end | null }'}</code>,
    <code>stoppingAt</code>, <code>landingAt</code>, <code>landedAt</code>,
    <code>tease {'{ start, end, order, total }'}</code>, <code>symbolSwaps</code>
    and <code>speed</code> as a flat <code>[t0, v0, t1, v1, ...]</code> array.
    Per round it keeps <code>index</code>, <code>spin</code>, <code>startedAt</code>,
    <code>profile</code>, <code>allStartedAt</code>, <code>allLandedAt</code>,
    <code>completeAt</code>, <code>duration</code>, <code>wasSkipped</code>,
    <code>skips[] {'{ at, mode, reels, partial, completedAt }'}</code>,
    <code>queuedSkipAt</code>, <code>boosted</code>, <code>landOrder</code>,
    <code>events</code>, <code>cascadeChains</code>, <code>wins</code> and
    <code>lastActivityAt</code>. <code>skip:requested</code> sets
    <code>wasSkipped</code> at once, because an aborted spin never reaches
    <code>spin:complete</code>; <code>skip:completed</code> closes the oldest
    open mark with the same reels. An event with no open round opens one with
    <code>spin: false</code> (a nudge before any spin), and the round events
    extend <code>lastActivityAt</code> after a round settles.
  </p>

  <p>
    Options: <code>now</code> (default <code>performance.now</code>),
    <code>history</code> (20 rounds kept; <code>clear()</code> keeps the
    counter), <code>ticker</code> (enables speed sampling),
    <code>sampleMs</code> (33); <code>MAX_SAMPLES</code> is 1800 per reel per
    round, about 30 seconds. Getters: <code>current</code>, <code>rounds</code>,
    <code>isActive</code> (a reel has an open phase, or a spin round has not
    completed while the set is spinning), <code>length</code> (a live clock
    while active, else <code>lastActivityAt</code>) and
    <code>totals {'{ rounds, skipped, averageDuration | null }'}</code>, where
    <code>rounds</code> counts every round ever opened and the other two are
    over the kept window. <code>snapshot()</code> returns
    <code>SpinMetricsSnapshot {'{ rounds, totals }'}</code> as a deep JSON copy.
    Not semver-protected.
  </p>

  <h2>Notices</h2>

  <p>
    <code>utils/notify.ts</code> is the library's single console channel.
    <code>LogLevel</code> is <code>'silent' | 'error' | 'warn' | 'info'</code>,
    ranked 0 to 3; the default is <code>'info'</code> because the notices this
    channel replaced were unconditional. <code>setLogLevel()</code> and
    <code>getLogLevel()</code> change and read it. A
    <code>Notice</code> is <code>{'{ kind, code, message, detail: unknown[] }'}</code>.
    <code>onNotice(listener) → unsubscribe</code> hears every notice
    regardless of level, even at <code>'silent'</code>; the level only gates
    console output. <code>noticeWarnOnce</code> deduplicates by code in a
    process-wide set and also skips the listeners on repeats;
    <code>resetNoticesForTest()</code> clears the set and the listeners.
    Output goes through <code>console[kind]</code> so devtools filtering and
    stacks keep working: a styled badge in a browser, <code>[pixi-reels]
    kind(code) message</code> in Node. Notices are for things a developer
    should act on, never per-frame state.
  </p>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60"><tr><th class={th}>Kind</th><th class={th}>Code</th><th class={th}>Raised in</th></tr></thead>
        <tbody>
          {NOTICES.map(([kind, code, where]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-xs text-muted-foreground">{kind}</td>
              <td class="px-4 py-2 font-mono text-primary text-xs">{code}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{where}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <h2>Tickers, disposal and gsap</h2>

  <div class="not-prose my-6 grid gap-3 md:grid-cols-3">
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">Disposable and TickerRef (ADR 004)</div>
      <p class="text-sm text-foreground/80"><code>Disposable</code> is <code>{'{ destroy(): void; readonly isDestroyed }'}</code>. Any class that subscribes to tickers, creates display objects or holds references implements it. The original library's main leak was <code>ticker.add</code> without a matching <code>remove</code>, so no class may call <code>ticker.add()</code> directly: it goes through <code>TickerRef</code>, which keeps its own callback list, ignores <code>add</code> after destroy, only removes callbacks it tracks, and on an idempotent <code>destroy()</code> removes every tracked callback. <code>ReelSet.destroy()</code> cascades through every subsystem; <code>SpinMetrics</code> and the overlay both use <code>TickerRef</code>.</p>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">gsap injection</div>
      <p class="text-sm text-foreground/80">With symlinked workspaces (vite with a linked package, pnpm, esbuild chains) the library's <code>gsap</code> import and yours can resolve to different module instances, each with its own root timeline; the engine's tweens then sit on a timeline nobody drives and stall at progress 0. <code>ReelSetBuilder.gsap(myGsap)</code> hands the engine your instance. It is held per reel set (carried down through <code>ReelConfig.gsap</code>), so composed stages can use different instances. <code>DEFAULT_GSAP</code> is the instance resolved when the library loaded.</p>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">driveGsapWithTicker</div>
      <p class="text-sm text-foreground/80"><code>driveGsapWithTicker(ticker, instance = DEFAULT_GSAP) → dispose</code> removes <code>gsap.updateRoot</code> from gsap's own ticker and calls it from a Pixi ticker callback with <code>ticker.lastTime / 1000</code>. Why: gsap's requestAnimationFrame loop is throttled or frozen in hidden tabs and iframes (casino lobbies) while the Pixi ticker keeps going, so easing and bounces would freeze mid-flight. Call it once per app, with the same instance you gave the builder; driving from two sources runs animations at double speed. The disposer is idempotent and re-adds <code>updateRoot</code>.</p>
    </div>
  </div>

