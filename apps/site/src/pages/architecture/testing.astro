---
import Architecture from '../../layouts/Architecture.astro';
import Diagram from '../../components/arch/Diagram.astro';
import Box from '../../components/arch/Box.astro';
import Edge from '../../components/arch/Edge.astro';
import Group from '../../components/arch/Group.astro';
import Legend from '../../components/arch/Legend.astro';

const th = 'text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground';

const TICKER: [string, string][] = [
  ['deltaMS · deltaTime · elapsedMS · lastTime', 'The fields the engine reads. deltaMS starts at 16; tick() sets deltaMS, deltaTime = deltaMs / (1000 / 60), and adds to elapsedMS and lastTime.'],
  ['speed · started · FPS (60) · minFPS (10) · maxFPS (0)', 'Present so the duck type matches; nothing in the engine reads them.'],
  ['add(fn) · addOnce(fn) · remove(fn)', 'The surface TickerRef uses. addOnce wraps and removes itself before calling.'],
  ['start() · stop() · destroy()', 'Flip started; destroy() also empties the callback list.'],
  ['tick(deltaMs = 16)', 'Advance one frame: set the deltas, then call a snapshot of the callbacks, so a callback that removes itself does not skip its neighbour.'],
  ['tickFor(totalMs, stepMs = 16)', 'Loop tick(min(stepMs, remaining)) until totalMs is spent.'],
  ['listenerCount', 'How many callbacks are registered. Handy for leak tests: it must be 0 after destroy().'],
];

const OPTS: [string, string, string][] = [
  ['reels', '5', 'reel count'],
  ['visibleCells', '3', 'a number, or a per-reel array for a static pyramid; exclusive with multiways'],
  ['multiways', 'none', '{ minCells, maxCells, reelExtent }; the set starts at maxCells'],
  ['symbolIds', "['a', 'b', 'c']", 'every id is registered as a HeadlessSymbol'],
  ['weights · symbolData', 'none', 'forwarded to the builder; symbolData is how tests declare big symbols'],
  ['symbolSize', '{ width: 120, height: 100 }', 'non-square on purpose, see below'],
  ['symbolGap', 'builder default (0, 0)', '{ x, y }'],
  ['orientation · direction · directionPerReel', 'vertical · forward', 'the axis options, same as the builder'],
  ['curve · curvePerReel · curveFocus', 'flat', 'drum curvature, same as the builder'],
  ['tumble', 'none', 'pass {} for the cascade defaults; without it the set spins strips'],
  ['bufferSymbols', 'builder default (1)', 'a number or { start, end }'],
  ['phases', 'none', 'the same hook as ReelSetBuilder.phases(factory)'],
  ['skipMode', 'builder default (slam)', 'what a bare skip() does'],
  ['initialFrame', 'random', 'ColumnTarget[], same as ReelSetBuilder.initialFrame'],
  ['gsap', 'the library default', 'a per-set gsap instance, for example a synchronous shim'],
];
---
<Architecture
  title="Testing model"
  subtitle="Why a full spin runs in Node with no renderer."
  eyebrow="Harness"
>
  <p>
    pixi-reels was designed so mechanics, not pixels, are what you test.
    The <code>pixi-reels/testing</code> subpath gives you a real
    <code>ReelSet</code> running against a fake ticker and headless symbols:
    no canvas, no DOM, no WebGL. Every test in the library's own suite runs in
    Node under vitest, and each takes milliseconds. The decision is ADR 008
    (<code>docs/adr/008-deterministic-testing.md</code>); the user-facing
    walkthrough is the <a href="/guides/cheats-and-testing/">cheats and testing guide</a>.
  </p>

  <h2>The data flow</h2>

  <Diagram height={696} caption="A test imports three primitives, gets a real ReelSet back, lands it synchronously, and asserts on JSON. Nothing below the testing module is a mock. spinAndLand() lands in the same tick; its promise resolves on a microtask with wasSkipped: true.">
    <Box x={230} y={20} w={260} h={60} title="my-spin.test.ts" kind="ghost" sub="vitest, node environment" />
    <Edge from={[360, 80]} to={[360, 128]} label="import" />

    <Group x={20} y={128} w={680} h={124} kind="solid" label="pixi-reels/testing" note="a subpath export, never in the main bundle" />
    <Box x={59} y={172} w={160} h={60} title="FakeTicker" sub="tick(ms) by hand" />
    <Box x={235} y={172} w={170} h={60} title="HeadlessSymbol" sub="paints nothing" />
    <Box x={421} y={172} w={240} h={60} title="createTestReelSet(opts)" sub="a builder wired to both" />
    <Edge from={[360, 252]} to={[360, 300]} label="build()" />

    <Group x={20} y={300} w={680} h={142} kind="tint" label="a real ReelSet" note="the same classes production runs" />
    <Box x={46} y={340} w={150} h={78} title="SpinController" kind="accent" sub={['phases and steps', 'on the FakeTicker']} />
    <Box x={212} y={340} w={150} h={78} title="Reel[]" kind="accent" sub={['ReelMotion, ReelAxis', 'headless cells']} />
    <Box x={378} y={340} w={140} h={78} title="EventEmitter" kind="accent" sub={['typed events', 'captureEvents here']} />
    <Box x={534} y={340} w={140} h={78} title="FrameBuilder" kind="accent" sub={['real pipeline', 'random fill']} />
    <Edge from={[360, 442]} to={[360, 490]} />

    <Box x={120} y={490} w={480} h={60} title="spinAndLand(grid)" kind="primary" sub="spin() + setResult(grid) + slamStop()" />
    <Edge from={[360, 550]} to={[360, 598]} />
    <Box x={120} y={598} w={480} h={78} title="assertions" mono={false} sub={['expectGrid · captureEvents · countSymbol', 'debugSnapshot · debugGrid · getFrames']} />
  </Diagram>

  <div class="not-prose my-8">
    <Legend items={[
      { kind: 'primary', label: 'the one shortcut', note: 'spinAndLand' },
      { kind: 'accent', label: 'real engine objects', note: 'not mocked' },
      { kind: 'subtle', label: 'testing module', note: 'FakeTicker, HeadlessSymbol, helpers' },
    ]} />
  </div>

  <h2>What is swapped, what is real</h2>

  <Diagram height={312} caption="Exactly two things are replaced: the ticker, because wall-clock time is the enemy of a deterministic test, and the symbol art, because Node has no renderer. Everything else is the shipping class, including ReelAxis, ReelCurve, SymbolFactory and its pool, SpeedManager, the masks, pins, cascade and expand.">
    <Group x={20} y={20} w={300} h={272} kind="dashed" label="swapped" note="2 things" />
    <Box x={44} y={68} w={252} h={78} title="FakeTicker" kind="code" sub={['stands in for PIXI.Ticker', 'builder.ticker(ticker)']} />
    <Box x={44} y={174} w={252} h={78} title="HeadlessSymbol" kind="code" sub={['stands in for Sprite, Spine,', 'AnimatedSprite and Card']} />

    <Group x={340} y={20} w={360} h={272} kind="tint" label="real" note="everything else" />
    {[
      ['ReelSetBuilder', 'ReelMotion'],
      ['ReelSet', 'FrameBuilder'],
      ['SpinController', 'EventEmitter'],
      ['phases + steps', 'ReelViewport'],
    ].map((rowItems, r) => rowItems.map((t, c) => (
      <Box x={366 + c * 162} y={64 + r * 56} w={146} h={40} title={t} size={13} />
    )))}
  </Diagram>

  <p>
    <code>FakeTicker</code> is duck-compatible with <code>PIXI.Ticker</code>.
    The engine only ever reaches a ticker through <code>TickerRef</code>
    (ADR 004), which calls <code>add</code>, <code>remove</code> and reads
    <code>deltaMS</code>, so the fake needs no more than that plus a way to
    move time by hand.
  </p>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60"><tr><th class={th}>FakeTicker</th><th class={th}>Behaviour</th></tr></thead>
        <tbody>
          {TICKER.map(([k, v]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs">{k}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p>
    <code>HeadlessSymbol</code> is not a mock. It extends <code>ReelSymbol</code>,
    creates a <code>Container</code> for <code>view</code> so the reel's
    child-tree code works, and implements the hooks as no-ops:
    <code>onActivate</code> and <code>onDeactivate</code> do nothing,
    <code>playWin</code> resolves immediately, <code>stopAnimation</code> is
    empty, and <code>resize(width, height)</code> stores the two numbers so
    <code>width</code> and <code>height</code> read back. <code>Reel</code>
    cannot tell it from a <code>SpriteSymbol</code>, so tests exercise the
    real pool lifecycle (acquire, activate, resize, deactivate, release). If a
    change broke that lifecycle, the testing module would fail first.
  </p>

  <h2>createTestReelSet</h2>

  <p>
    <code>testing/testHarness.ts</code>. The one-liner builds a
    <code>ReelSetBuilder</code> with a fresh <code>FakeTicker</code> and
    registers every id as a <code>HeadlessSymbol</code>, then forwards the
    options below. It returns a <code>TestReelSetHandle</code>:
    <code>{'{ reelSet, ticker, advance(ms, stepMs = 16), spinAndLand(grid), destroy() }'}</code>.
    <code>advance</code> is <code>ticker.tickFor</code>; <code>destroy</code>
    destroys the set and then the ticker.
  </p>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60"><tr><th class={th}>Option</th><th class={th}>Default</th><th class={th}>Meaning</th></tr></thead>
        <tbody>
          {OPTS.map(([k, d, m]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs">{k}</td>
              <td class="px-4 py-2 font-mono text-xs text-muted-foreground">{d}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{m}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <h3>The helpers</h3>

  <ul>
    <li><strong><code>spinAndLand(reelSet, grid: ColumnTarget[])</code></strong> is <code>spin()</code>, <code>setResult(grid)</code>, <code>slamStop()</code>. <code>slamStop()</code> force-completes every active phase including its GSAP timelines, places the target symbols directly and fires the usual landing events, so the promise resolves on a microtask with <code>wasSkipped: true</code>. It shares the internal slam path a player's skip uses, minus the speed boost. It takes <code>ColumnTarget[]</code> only; the old <code>string[][]</code> form is gone and <code>setResult</code> throws on it.</li>
    <li><strong><code>captureEvents(reelSet, names)</code></strong> returns a <code>{'{ event, args }[]'}</code> that fills up in order.</li>
    <li><strong><code>expectGrid(reelSet, string[][])</code></strong> compares <code>debugSnapshot(reelSet).grid</code> and throws a readable diff that lists every mismatched reel and cell and ends with <code>debugGrid()</code>.</li>
    <li><strong><code>countSymbol(reelSet, id)</code></strong> counts visible occurrences, for scatter-style assertions.</li>
    <li><strong>Recording</strong>, from the main barrel (<code>debug/debug.ts</code>): <code>startRecording(reelSet, tag, {'{ maxFrames }'})</code> captures a <code>debugSnapshot</code> on <code>spin:start</code>, <code>spin:reelLanded</code>, <code>spin:allLanded</code> and <code>spin:complete</code>; <code>stopRecording</code>, <code>getFrames(tag?)</code> (a copy) and <code>clearFrames</code>. The buffer is process-wide and capped at 1000 frames. See the <a href="/architecture/debug/">debug page</a>.</li>
  </ul>

  <h2>The deterministic surface</h2>

  <Diagram height={228} caption="Four knobs that make a run repeatable. The non-square default cell is the cheapest of them (ADR 018, section 10.2): with a square cell, swapping width for height passes every assertion.">
    <Box x={20} y={20} w={320} h={78} title="builder.rng(fn)" sub={['seeded PRNG for the random fill', 'same seed, same strips and wraps']} />
    <Box x={380} y={20} w={320} h={78} title="FakeTicker.tick(16)" sub={['tickFor(ms, 16) · advance(ms)', 'no requestAnimationFrame']} />
    <Box x={20} y={130} w={320} h={78} title="120 x 100 cell" sub={['non-square on purpose', 'axis mix-ups fail loudly']} />
    <Box x={380} y={130} w={320} h={78} title="@pixi-reels/cheats" kind="code" sub={['CheatEngine · SeededRng', 'evaluateWays · countWays']} />
  </Diagram>

  <p>
    <code>ReelSetBuilder.rng(fn)</code> takes any <code>() => number</code>
    and hands it to the random symbol provider, so the strips between results
    are reproducible. The cheats package is deliberately outside the library
    (ADR 009). Its built-in cheats are <code>forceGrid</code>,
    <code>forceLine</code>, <code>forceScatters</code>, <code>forceNearMiss</code>,
    <code>forceCell</code>, <code>forceAnticipation</code>,
    <code>holdAndWinProgress</code> and <code>cascadingStages</code>.
    <code>CheatEngine</code> tries registered
    <code>CheatDefinition {'{ id, label, description?, enabled, cheat }'}</code>
    entries in order and the first non-null <code>CheatSpinResult {'{ symbols, anticipationReels, meta? }'}</code>
    wins, otherwise it produces a seeded random grid; held cells are applied on
    top of every result. Its <code>SeededRng</code> is Mulberry32 with a
    default seed of <code>0xdeadbeef</code>, and the engine seeds it with 1.
    <code>evaluateWays(grid, {'{ wilds?, exclude?, minReels = 3, pays? }'})</code>
    and <code>countWays(cellsPerReel)</code> live there too because the core
    library never evaluates wins (ADR 007). The docs site and the library's
    own integration tests both import it; a published game never does.
  </p>

  <h2>Three suites around the harness</h2>

  <div class="not-prose my-6 grid gap-3 md:grid-cols-3">
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">tests/integration</div>
      <p class="text-sm text-foreground/80">Mechanic tests built on <code>createTestReelSet</code>: pins, movePin, expand, cascade, big symbols, columns, rows, hold reels, the spin watchdog, spotlight, teardown, and the cheats. <code>mechanics.test.ts</code> is the template every new mechanic test copies.</p>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">tests/contract</div>
      <p class="text-sm text-foreground/80">The fourteen laws of ADR 018 as fast-check properties, run against the shipping <code>ReelMotion</code> in all four orientation x direction combinations, plus the isomorphism and mirror laws one level up at the <code>ReelSet</code>, and frame-by-frame golden position traces as inline snapshots. Deliberately driven from <code>ReelMotion</code> directly, not a full spin, because GSAP tweens are wall-clock driven and would make the baseline flap.</p>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">tests/e2e</div>
      <p class="text-sm text-foreground/80"><code>orientation-matrix.spec.ts</code> runs the four travel combinations in a real browser with Playwright: WebGL, a real requestAnimationFrame, GSAP on the Pixi ticker, the full async lifecycle. It asserts engine state through <code>__PIXI_REELS_DEBUG</code>, not screenshots, because WebGL baselines are GPU- and platform-dependent. <code>cascade-rounds</code> and <code>recipes-mount</code> sit beside it.</p>
    </div>
  </div>

  <h2>What a real test looks like</h2>

  <pre><code>{`import { it, expect } from 'vitest';
import { createTestReelSet, expectGrid, captureEvents, countSymbol } from 'pixi-reels/testing';

const cells = [
  ['a', 'a', 'a'], ['b', 'b', 'b'], ['c', 'c', 'c'], ['a', 'b', 'c'], ['c', 'b', 'a'],
];

it('lands the grid it was given and fires the round events', async () => {
  const h = createTestReelSet({ reels: 5, visibleCells: 3, symbolIds: ['a', 'b', 'c'] });
  try {
    const log = captureEvents(h.reelSet, ['spin:start', 'spin:complete']);
    // spinAndLand and setResult take ColumnTarget[]; expectGrid takes string[][].
    const result = await h.spinAndLand(cells.map((visible) => ({ visible })));
    expect(result.wasSkipped).toBe(true);
    expectGrid(h.reelSet, cells);
    expect(countSymbol(h.reelSet, 'a')).toBe(5);
    expect(log.map((e) => e.event)).toEqual(['spin:start', 'spin:complete']);
  } finally {
    h.destroy();
  }
});`}</code></pre>

  <p>
    This is the shape every mechanic test in
    <code>packages/pixi-reels/tests/integration/mechanics.test.ts</code> follows:
    build, act through the public API, assert on the snapshot, destroy in
    <code>finally</code>. A test that needs time to pass (a watchdog, a nudge
    tween with a synchronous gsap shim, a pin overlay mid-spin) calls
    <code>h.advance(ms)</code> between the act and the assertion instead of
    <code>spinAndLand</code>.
  </p>

  <h2>Why this composition is testable</h2>

  <p>
    The library has no renderer assumptions anywhere except in the concrete
    <code>ReelSymbol</code> subclasses (Sprite, AnimatedSprite, Spine, Card).
    Control flow sits in <code>SpinController</code>, the phases and the
    events, all plain JavaScript objects that read time from a ticker and
    drive tweens through an injected gsap. Swapping the symbols for
    <code>HeadlessSymbol</code> and the ticker for <code>FakeTicker</code> is
    enough to run the whole thing in Node, which is also why the harness
    cannot watch a reel mid-SPIN at real timing: <code>slamStop()</code> is
    all-or-nothing, and timing-sensitive visual checks belong in the browser
    suite.
  </p>

  <p>
    The module ships as the <code>./testing</code> subpath (it moved out of
    the main barrel in 1.0.0), so production bundles never see it, and
    <code>createTestReelSet</code> is public API: consumers test their own
    mechanics with the same harness.
  </p>

  <h2>Where this lives</h2>

  <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">packages/pixi-reels/src/testing/</div>
      <ul class="text-sm space-y-1 text-foreground/80">
        <li><code>FakeTicker.ts</code> · <code>HeadlessSymbol.ts</code></li>
        <li><code>testHarness.ts</code> createTestReelSet, spinAndLand, captureEvents, expectGrid, countSymbol</li>
        <li><code>index.ts</code> the pixi-reels/testing barrel · <code>debug/debug.ts</code> the recorder</li>
      </ul>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">suites and decisions</div>
      <ul class="text-sm space-y-1 text-foreground/80">
        <li><code>packages/pixi-reels/tests/</code> unit, integration, contract · <code>tests/e2e/</code> Playwright</li>
        <li><code>packages/cheats/src/</code> cheats.ts, seededRng.ts, ways.ts</li>
        <li><code>docs/adr/008-deterministic-testing.md</code> · <code>009-cheats-live-outside-lib.md</code> · <code>018-motion-contract.md</code></li>
      </ul>
    </div>
  </div>
</Architecture>
