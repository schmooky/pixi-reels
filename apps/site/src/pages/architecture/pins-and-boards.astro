---
import Architecture from '../../layouts/Architecture.astro';
import Diagram from '../../components/arch/Diagram.astro';
import Box from '../../components/arch/Box.astro';
import Edge from '../../components/arch/Edge.astro';
import Group from '../../components/arch/Group.astro';
import Legend from '../../components/arch/Legend.astro';

const th = 'text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground';

const PIN_API: [string, string][] = [
  ['pin(reel, cell, symbolId, opts?)', 'Throws during a nudge or on an out-of-range cell; negative cells are rejected, buffer cells go through setResult. At rest it asserts a big symbol fits, applies the symbol immediately through _placeCellsAtRest (a pin on a block cell replaces the block) and emits pin:placed. Mid-spin it creates an overlay. Re-pinning the same cell is silent: no pin:expired, the old overlay is destroyed.'],
  ['unpin(reel, cell)', "Removes the overlay and emits pin:expired(pin, 'explicit'). Does nothing if there is no pin."],
  ['pins / getPin(reel, cell)', 'A ReadonlyMap keyed "reel:cell" (pinKey). During a spin it reflects the next setResult.'],
  ['movePin(from, to, opts?)', "Only at rest. Throws if from has no pin, to is out of range, or to already has a pin; from === to still emits pin:moved. Updates the map atomically (originCell = to.cell), destroys the overlay at from, backfills the vacated cell, flies a pooled symbol through viewport.unmaskedContainer, places the pin, releases the flight symbol, emits pin:moved(movedPin, from). Options: duration 400, easing 'power2.inOut', backfill (random by default), onFlightCreated, onFlightCompleted. Hook throws are logged as pin-hook-threw, never thrown."],
  ['refreshPinOverlaysForReel(reelIndex)', 'Called automatically after the AdjustPhase. Call it yourself only after a custom layout change.'],
];

const GUARDS: [string, string][] = [
  ['setSymbolAt', 'throws on a pinned cell'],
  ['nudge', 'throws if any pin is on that reel'],
  ['splitSymbol', 'throws if a pinned cell is in the split range'],
  ['setColumn', 'the new column must show the pinned symbol at its cell; a pin past the new length expires'],
  ['removeReels, removeRows, resetColumns', "pins past the end expire with 'explicit'"],
];

const GRID_OPTS: [string, string, string][] = [
  ['cols, rows', 'required', 'board size'],
  ['cellSize', 'required', 'a number or { width, height }'],
  ['gap · columnGap · rowGap', '4', 'columnGap and rowGap fall back to gap'],
  ['emptyId', "'empty'", 'an EmptySymbol is auto-registered'],
  ['symbols · weights · symbolData · rng', '', 'forwarded to every cell builder'],
  ['ticker', 'required', 'the constructor throws without it'],
  ['chrome(g, w, h)', 'none', 'per-cell background drawn below the cell'],
  ['mask(cell, { cols, rows, corners })', 'SharedRectMaskStrategy', 'corners lets RoundedRectMaskStrategy round only the outer corners'],
  ['orientation · direction', 'vertical · forward', 'the axis each cell strip travels on; the board layout does not change'],
  ['profiles', '{ default: NORMAL + minimumSpinTime 320 }', 'name to profile, or a per-cell function'],
  ['symbolZIndex · cellZIndex(ctx)', 'none', 'order symbols inside a cell; order the cells lifted art'],
];

const GRID_API: [string, string][] = [
  ['lift(cell) → release', 'Moves the cell lifted art into _promoted. Reference-counted per cell; release is idempotent. Separate from zIndex, so it survives refreshCellZIndex. Also liftedCells and releaseAllLifts().'],
  ['dim({ except?, amount = 0.5, fade = 180 }) → release', 'One black rect per non-excepted cell, faded over fade × |delta| ms on the ticker. A second dim while one is up throws. Also dimmedCells and clearDim().'],
  ['dimSymbols({ except?, amount, fade }) → release', 'Darkens view.tint toward black (0.5 gives 0x808080). Watches symbol:created so a swapped-in symbol arrives dark and a departing one is cleaned before pooling. Owns view.tint while active. Also dimmedSymbolCells and clearSymbolDim().'],
  ['refreshCellZIndex()', 'Re-asks cellZIndex({ symbolId, cell, cols, rows, atRest, attachOrder }) for every cell. Runs on every place and every landing.'],
  ['cells() · cellBounds(cell) · cellCenter(cell)', 'Reel-major order; board-local bounds (use container.toGlobal for stage space).'],
  ['symbolAt(cell) · reelAt(cell) · setProfile(cell, name)', 'The live ReelSymbol, the underlying 1x1 ReelSet, the profile selection.'],
  ['place(cell, id)', 'Instant, empty buffers, then refreshCellZIndex.'],
  ['spinCells(targets: { cell, id }[], onLanded?)', 'Per target: spin(), setResult with empty buffers, await, refreshCellZIndex, await onLanded. All cells run concurrently; resolves after every cell landed and its after-land work finished.'],
  ['skipSpinning(options?)', 'Returns the in-flight count; swallows "no result yet" errors.'],
  ['destroy()', 'Releases lifts and dims, then destroys every reel set.'],
];

const HW_DEFAULTS: [string, string][] = [
  ['grid', '5 x 3'],
  ['cellSize', '72 x 72'],
  ['columnGap · rowGap', '4'],
  ['emptyId', "'empty'"],
  ['inactive', '[] (inactive id defaults to the empty id)'],
  ['respins', '3'],
  ['lockAnimation', "'win' (or 'landing', 'none', or a per-coin function)"],
  ['speeds', '{ normal: NORMAL + minimumSpinTime 320 + stopDelay 70 }'],
  ['initialSpeed', "'normal'"],
  ['stagger', '(reel + cell) × profile.stopDelay, a diagonal wave'],
  ['skipMode', "'slam'"],
  ['axis', 'vertical · forward'],
  ['TENSION_EXTRA_MS', '1100, added to minimumSpinTime for the name:tension profile'],
];

const HW_METHODS: [string, string][] = [
  ['enter(seed)', 'The reducer validates first, then the board places the coins and replays the effects.'],
  ['respin(hits)', 'One wave; see the diagram. On a throw: abortWave() plus grid.skipSpinning(), then rethrow.'],
  ['setSymbolAt(cell, id, data?)', 'Locked cells only. Throws inside a coin:locked listener, because the wave is still in flight.'],
  ['setSpeed(name) · addSpeed(name, profile)', 'Updates every cell; keeps the tension variant if a tense wave is in flight.'],
  ['playWin(cells?) · activate(cells) · release(cells)', 'Pass-throughs to the lock animation and the reducer; release and activate throw mid-wave.'],
  ['skip({ mode?, speed?, payload? })', 'Emits feature:skip and returns the in-flight count.'],
  ['reset()', 'Releases lifts, clears dims, places empty on every cell, re-dresses inactive cells. The reducer emits only feature:reset, never coin:released.'],
  ['lift · dim · dimSymbols · cellBounds · cellCenter · symbolAt · reelAt · refreshCellZIndex', 'BoardGrid pass-throughs. Lifts and dims survive a respin() and are released by reset() and destroy().'],
];
---
<Architecture
  title="Pins, boards, Hold & Win"
  subtitle="Cell pins across spins, the BoardGrid, the Hold & Win state machine."
  eyebrow="Boards"
>
  <p>
    Three mechanisms share this page because games combine them. A
    <strong>pin</strong> is a claim on one cell that forces a symbol into
    <code>setResult()</code> for a number of spins. A <strong>BoardGrid</strong>
    is a grid of cells that each spin on their own, every cell being a 1x1
    <code>ReelSet</code>. <strong>Hold &amp; Win</strong> is a pure state machine
    plus a driver that runs it on a BoardGrid. The guides for each are
    <a href="/guides/pins/">pins</a>, <a href="/guides/hold-and-win/">hold and win</a>,
    <a href="/guides/nudge/">nudge</a>, <a href="/guides/win-animations/">win animations</a>
    and <a href="/guides/multiways/">multiways</a>; the recipe umbrellas are
    <a href="/recipes/wilds-and-pins/">wilds and pins</a>, <a href="/recipes/hold-and-win/">hold and win</a>
    and <a href="/recipes/nudge/">nudge</a>.
  </p>

  <h2>A pin across one spin</h2>

  <p>
    The pin map is wired to two set events in <code>core/ReelSet.ts</code>:
    <code>spin:start</code> runs <code>_onSpinStart</code> and
    <code>spin:allLanded</code> runs <code>_onSpinLanded</code>. Between them
    <code>setResult()</code> calls <code>_applyPinsToGrid</code>, which
    overwrites <code>visible[pin.cell]</code> with the pinned id. While the
    reels move, the pinned symbol is shown by a pooled overlay in
    <code>viewport.unmaskedContainer</code> at zIndex 10000.
  </p>

  <Diagram height={330} caption="The automatic path every pin takes, and the one way out. A numeric pin spends a turn on every spin:allLanded and goes round again while turns remain; 'permanent' pins never leave the ring, 'eval' pins expire at the next spin:start, and unpin() expires one at any time.">
    <Box x={20} y={40} w={210} h={60} title="pin() at rest" kind="primary" sub="applied now, pin:placed" />
    <Box x={255} y={40} w={210} h={60} title="spin:start" kind="accent" sub="overlay created" />
    <Box x={490} y={40} w={210} h={60} title="setResult(grid)" sub="cell := pin.symbolId" />
    <Box x={490} y={200} w={210} h={60} title="spin:allLanded" kind="accent" sub="overlay destroyed, turns -= 1" />
    <Box x={255} y={200} w={210} h={60} title="next spin()" kind="ghost" sub="overlay again" />
    <Box x={20} y={200} w={210} h={60} title="pin:expired" sub="also unpin(), 'eval', collision" />
    <Edge from={[230, 70]} to={[255, 70]} kind="primary" />
    <Edge from={[465, 70]} to={[490, 70]} kind="primary" />
    <Edge from={[595, 100]} to={[595, 200]} kind="primary" />
    <Edge from={[490, 230]} to={[465, 230]} />
    <Edge from={[360, 200]} to={[360, 100]} label="turns left" />
    <Edge from={[595, 260]} via={[[595, 292], [125, 292]]} to={[125, 260]} label="turns <= 0" />
  </Diagram>

  <div class="not-prose my-8">
    <Legend items={[
      { kind: 'primary', label: 'your call', note: 'pin, unpin, movePin' },
      { kind: 'accent', label: 'set event hook', note: 'spin:start, spin:allLanded' },
      { kind: 'subtle', label: 'state change', note: 'setResult, pin:expired' },
    ]} />
  </div>

  <p>
    Two more things move a pin, by hand or by a reshape.
    <code>movePin(from, to)</code> works between spins only: a 400 ms
    <code>power2.inOut</code> flight through <code>unmaskedContainer</code>,
    a backfill of the vacated cell, then <code>pin:moved(pin, from)</code>.
    A MultiWays <code>setShape()</code> migrates pins after <code>spin()</code>
    and before <code>setResult()</code>: an <code>'origin'</code> pin moves to
    <code>min(originCell, newCells - 1)</code> and is restored later, a
    <code>'frozen'</code> pin stays if it fits and otherwise clamps and
    overwrites its origin. Reels are processed top to bottom, stayers claim
    their cells first, and a pin that loses its cell expires with
    <code>'collision'</code>; every move emits
    <code>pin:migrated {'{ fromCell, toCell, clamped }'}</code>. The steps of
    <code>expand()</code> are one round: no turns are spent and no eval pin
    expires per step.
  </p>

  <h3>The pin record</h3>

  <p>
    <code>CellPin</code> in <code>pins/CellPin.ts</code> is
    <code>{'{ reel, cell, symbolId, originCell, migration, turns, payload? }'}</code>.
    <code>turns</code> is a number, <code>'eval'</code> or <code>'permanent'</code>.
    <code>CellPinOptions</code> is <code>{'{ turns = \'permanent\', payload?, originCell?, migration = \'origin\' }'}</code>;
    calling <code>pin()</code> mid-reshape is allowed, and <code>originCell</code>
    then defaults to the post-reshape cell. <code>PinExpireReason</code> is
    <code>'turns' | 'explicit' | 'eval' | 'collision'</code>. One record
    covers sticky wilds, expanding wilds (<code>'eval'</code>), Hold &amp; Win
    coins, multiplier wilds and sticky-win respins.
  </p>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60"><tr><th class={th}>Method</th><th class={th}>Behaviour</th></tr></thead>
        <tbody>
          {PIN_API.map(([sig, what]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs">{sig}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{what}</td>
            </tr>
          ))}
          <tr class="border-t border-border/60 bg-muted/30"><td colspan="2" class="px-4 py-1.5 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">guards elsewhere</td></tr>
          {GUARDS.map(([sig, what]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs">{sig}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{what}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p>
    <code>Z_INDEX_BUDGET</code> in <code>config/types.ts</code> is
    <code>{'{ symbolLayer: 100, pinOverlay: 10000 }'}</code>. A symbol's default
    z-index is <code>zIndex × 100 + arrayIndex</code>, so no ordinary symbol
    reaches the overlay. Art that must sit above pins goes to
    <code>viewport.spotlightContainer</code>.
  </p>

  <p>
    From reading the code: <code>refill()</code> emits <code>spin:start</code>
    and finishes through the same path that emits <code>spin:allLanded</code>,
    so <code>_onSpinStart</code> and <code>_onSpinLanded</code> probably run on
    every cascade stage. Numeric turns would then be spent per stage and
    <code>'eval'</code> pins would expire at the first refill. The refill grid
    also does not go through <code>_applyPinsToGrid</code>. Treat pins and
    cascades as a combination to test before you ship it.
  </p>

  <h3>Growing and reshaping a board</h3>

  <ul>
    <li><strong><code>expand({'{ columns, step?, onStepAdded?, onStepLanded?, anticipation?, mode?, signal? }'})</code></strong> is the infinity-reels feature in <code>core/expand.ts</code> and <code>ReelSet.expand</code>. It validates everything first (a throw leaves the board untouched), emits <code>expand:start</code>, then per step: <code>_addReels</code> (<code>reels:added</code>), <code>expand:stepAdded</code>, <code>await onStepAdded</code>, a spin with every older reel in <code>holdReels</code>, <code>setResult</code>, <code>expand:stepLanded</code>, <code>await onStepLanded</code>. It ends with <code>expand:complete</code> then <code>expand:end('complete')</code>, or <code>expand:end('failed')</code>. <code>step</code> defaults to 1 and is widened, never split, so a big symbol fits whole. An aborted <code>signal</code> means fast-forward: the step in flight slams and the remaining columns land in one last step with <code>fastForward: true</code>. Skip carries across steps. <code>spin()</code>, <code>addReels()</code>, <code>removeReels()</code> throw while it runs; <code>addRows()</code> is only allowed in <code>onStepLanded</code>. All steps are one round, so pins are not spent per step.</li>
    <li><strong><code>setColumn(reel, column, {'{ height? }'})</code></strong> shows <code>column.visible.length</code> cells on one reel at rest. <code>'grow'</code> (default) keeps the cell size and re-anchors the board; <code>'keep'</code> keeps the reel's height and resizes cells to <code>(extent - (n - 1) × gap) / n</code>. On MultiWays <code>'keep'</code> is the default, <code>'grow'</code> throws and the count must stay within <code>[minCells, maxCells]</code>. Only changed cells are replaced. Emits <code>column:set</code>, then <code>pin:moved</code> for shifted pins.</li>
    <li><strong><code>splitSymbol(reel, cell, ids)</code></strong> splits a 1x1 or a one-reel-wide stacked block into <code>ids.length</code> cells; pins below shift down with their symbols. Goes through <code>_setColumn</code>.</li>
    <li><strong><code>resetColumns()</code></strong> returns every reel to the cells and cell size it was built or added with, undoing <code>setColumn</code>, <code>splitSymbol</code> and <code>addRows</code>. Safe at round start after <code>removeReels()</code>; not available on MultiWays. <code>addRows()</code> and <code>removeRows()</code> emit <code>rows:added</code> and <code>rows:removed</code>.</li>
  </ul>

  <h2>BoardGrid layering</h2>

  <p>
    <code>board/BoardGrid.ts</code> is mechanism only: no coins, no locks, no
    rules, no hit areas (games build those from <code>cellBounds</code>).
    Each cell is reel 0 of its own set at
    <code>(reel × (cellWidth + columnGap), cell × (cellHeight + rowGap))</code>.
    Draw order is fixed at construction, bottom to top.
  </p>

  <Diagram height={404} caption="Five layers, bottom to top. lift() moves one cell's unmasked art into _promoted; dim() draws black rectangles in the dim layer, between lifted and promoted art; dimSymbols() tints instead of covering. cellZIndex() sorts _lifted. The API table below has the details.">
    <Edge from={[60, 384]} to={[60, 20]} label="draw order" />
    <Box x={140} y={20} w={540} h={60} title="_promoted (RenderLayer)" kind="accent" sub="cells that have been lift()ed" />
    <Box x={140} y={96} w={540} h={60} title="dim layer" mono={false} sub="_dimHost and _dimLayer: black rects from dim(), faded on the ticker" />
    <Box x={140} y={172} w={540} h={60} title="_lifted (RenderLayer)" sub="every cell's viewport.unmaskedContainer attaches here" />
    <Box x={140} y={248} w={540} h={60} title="cells" kind="code" mono={false} sub="one 1x1 ReelSet per cell, each with its own mask strategy" />
    <Box x={140} y={324} w={540} h={60} title="chrome" kind="muted" mono={false} sub="chrome(g, w, h) per cell, drawn first" />
  </Diagram>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60"><tr><th class={th}>BoardGridOptions</th><th class={th}>Default</th><th class={th}>Meaning</th></tr></thead>
        <tbody>
          {GRID_OPTS.map(([k, d, m]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs">{k}</td>
              <td class="px-4 py-2 font-mono text-xs text-muted-foreground">{d}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{m}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60"><tr><th class={th}>BoardGrid API</th><th class={th}>Behaviour</th></tr></thead>
        <tbody>
          {GRID_API.map(([sig, what]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs">{sig}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{what}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p>
    Inside each cell the <code>ReelViewport</code> stacks
    <code>maskedContainer</code>, <code>unmaskedContainer</code> (sortable),
    <code>spotlightContainer</code>, <code>promotedLayer</code> and
    <code>dimOverlay</code>. <code>ReelSet.getCellBounds(reel, cell)</code>
    returns set-local bounds including the viewport offset; on a curved reel it
    is the trapezoid's bounding box and <code>getCellQuad</code> has the corners.
  </p>

  <h2>The Hold &amp; Win state machine</h2>

  <p>
    <code>board/HoldAndWinState.ts</code> is a pure reducer with no PixiJS and
    the single source of truth: every derived value (<code>capacity = all - inactive</code>,
    <code>isFull = locked.size === capacity</code>) is computed, never cached.
    <code>board/HoldAndWinBoard.ts</code> composes it with a BoardGrid, drives
    the reels, reports landings and replays the reducer's effects on
    <code>board.events</code>.
  </p>

  <Diagram height={360} caption="The reducer's three phases. enter() leaves idle, beginWave() opens a wave, endWave() or abortWave() closes it, and endWave() goes back to idle when the board is full or respins reach 0. land(cell, coin) is only honoured while spinning, so stray landings after an abort are dropped.">
    <Box x={265} y={30} w={230} h={60} title="idle" kind="muted" mono={false} sub="before enter(), after feature:end" />
    <Box x={265} y={150} w={230} h={60} title="active" kind="accent" mono={false} sub="coins locked, between waves" />
    <Box x={265} y={270} w={230} h={60} title="spinning" kind="primary" mono={false} sub="one wave in flight" />
    <Edge from={[380, 90]} to={[380, 150]} kind="primary" label="enter(seed)" />
    <Edge from={[380, 210]} to={[380, 270]} kind="primary" label="beginWave(hits)" />
    <Edge from={[495, 300]} via={[[575, 300], [575, 180]]} to={[495, 180]} label="endWave() · abortWave()" />
    <Edge from={[265, 180]} via={[[160, 180], [160, 60]]} to={[265, 60]} label="full or respins <= 0" />
  </Diagram>

  <p>
    <code>endWave()</code> applies its rules in order: any hit resets
    <code>respins</code> to the default (<code>respins:changed</code> with
    reason <code>'hit-reset'</code>), no hit decrements it, never below 0
    (<code>'miss'</code>); the phase becomes <code>active</code> and
    <code>respin:end {'{ round, hits, respinsLeft }'}</code> fires; a full board
    emits <code>board:full {'{ coins }'}</code>; and when the board is full or
    respins are 0 the phase becomes <code>idle</code> with
    <code>feature:end</code>. The other reducer calls: <code>enter(seed)</code>
    is allowed in idle only, the seed cells must be active and unique, and the
    round counter restarts at 0; <code>release()</code>, <code>activate()</code>
    and <code>swap()</code> throw mid-wave; <code>reset()</code> clears the
    ledger, restores inactive cells and emits <code>feature:reset</code> only;
    <code>beginWave()</code> throws on inactive, locked or duplicate hits.
  </p>

  <Diagram height={100} caption="HoldAndWinBoard.respin(hits), the driver around one wave: beginWave() (round++, the free cells), pick the per-cell profile (speed, or speed:tension when anticipateWhen() says so), emit respin:start, grid.spinCells() with the diagonal stagger and land() per cell, then endWave().">
    <Box x={20} y={28} w={106} h={44} title="beginWave" />
    <Box x={144} y={28} w={132} h={44} title="pick profile" mono={false} />
    <Box x={294} y={28} w={132} h={44} title="respin:start" />
    <Box x={444} y={28} w={150} h={44} title="grid.spinCells" />
    <Box x={612} y={28} w={88} h={44} title="endWave" />
    <Edge from={[126, 50]} to={[144, 50]} />
    <Edge from={[276, 50]} to={[294, 50]} />
    <Edge from={[426, 50]} to={[444, 50]} />
    <Edge from={[594, 50]} to={[612, 50]} />
  </Diagram>

  <p>
    The constructor registers each speed name twice as per-cell profiles,
    <code>name</code> and <code>name:tension</code>, through <code>_profileFor</code>:
    <code>minimumSpinTime = (profile.minimumSpinTime ?? 320) + stagger(...)</code>,
    plus <code>TENSION_EXTRA_MS = 1100</code> for the tension variant.
    <code>tense</code> is evaluated once per wave against the pre-wave state and
    only applies when at least one cell spins. On each <code>coin:locked</code>
    the driver plays the lock animation: <code>'win'</code> waits for an
    in-progress <code>symbol.landing</code>, <code>'landing'</code> does not
    replay it; failures are logged as <code>hw-coin-&lt;anim&gt;-failed</code>.
  </p>

  <div class="not-prose my-6 grid gap-4 md:grid-cols-2">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60"><tr><th class={th}>HoldAndWinBuilder</th><th class={th}>Default</th></tr></thead>
        <tbody>
          {HW_DEFAULTS.map(([k, d]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs">{k}</td>
              <td class="px-4 py-2 font-mono text-xs text-muted-foreground">{d}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60"><tr><th class={th}>HoldAndWinBoard</th><th class={th}>Behaviour</th></tr></thead>
        <tbody>
          {HW_METHODS.map(([k, d]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs">{k}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{d}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <p>
    The builder's other methods are <code>grid</code>, <code>cellSize(size, {'{ gap, columnGap, rowGap }'})</code>,
    <code>symbols</code> (required), <code>weights</code>, <code>emptyId</code>,
    <code>inactive(cells, id?)</code>, <code>symbolData</code> (merged;
    <code>{'{ unmask: true }'}</code> is the headline use), <code>respins</code>,
    <code>lockAnimation</code>, <code>symbolZIndex</code>, <code>cellZIndex</code>,
    <code>speedProfile</code>, <code>speeds</code>, <code>initialSpeed</code>,
    <code>skipMode</code>, <code>stagger</code>, <code>anticipateWhen(fn)</code>,
    <code>cellChrome</code>, <code>cellMask</code>, <code>axis</code>,
    <code>ticker</code> (required) and <code>rng</code>. <code>build()</code>
    throws without <code>symbols</code> or <code>ticker</code>, or if
    <code>initialSpeed</code> names no registered profile.
  </p>

  <p>
    Board events, each with one object payload: <code>feature:enter</code>,
    <code>respin:start</code>, <code>cell:landed</code> (in stagger order),
    <code>coin:locked</code>, <code>coin:released</code>, <code>respins:changed</code>,
    <code>respin:end</code>, <code>board:full</code>, <code>feature:skip</code>,
    <code>feature:reset</code>, <code>feature:end</code>, <code>cells:activated</code>,
    <code>speed:changed</code>. Payloads are on the <a href="/architecture/events/">events page</a>.
    <code>HwCoin</code> is <code>{'{ readonly cell, readonly id, data? }'}</code>:
    the board owns <code>cell</code> and <code>id</code>, the game may mutate <code>data</code>.
  </p>

  <h2>Nudge, in short</h2>

  <p>
    <code>ReelSet.nudge(reel, {'{ distance, direction, incoming, duration?, ease?, startDelay?, signal? }'})</code>
    moves one reel at rest by <code>distance</code> cells (a positive integer
    below the strip capacity) in <code>'forward'</code> or <code>'reverse'</code>
    relative to the reel's own axis, feeding <code>incoming</code> (length must
    equal <code>distance</code>, in start-to-end order, may overflow into the
    buffers). Defaults: <code>duration = 200 × distance</code> ms,
    <code>ease = 'power2.out'</code> with overshoot clamped. It throws while a
    spin, refill or expand step is in flight, on a reel with
    <code>bufferEnd === 0</code>, or if any pin is on that reel; while a nudge
    runs, <code>spin</code>, <code>setResult</code>, <code>pin</code>,
    <code>setShape</code> and resizing throw. Events: <code>nudge:start</code>
    (after pre-placement), then <code>nudge:complete</code> with the new
    <code>symbols</code>, or <code>nudge:cancelled</code> with a reason and an
    <code>AbortError</code> rejection. The per-reel bus gets
    <code>phase:enter('nudge')</code> and <code>phase:exit('nudge')</code>.
    <code>skipNudge(reel?)</code> fast-forwards and still resolves normally.
    It is per reel by design; run several with <code>Promise.all</code>.
  </p>

  <h2>Presenting wins</h2>

  <div class="not-prose my-6 grid gap-3 md:grid-cols-3">
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">WinPresenter</div>
      <p class="text-sm text-foreground/80"><code>wins/WinPresenter.ts</code>. <code>show(wins)</code> aborts any previous run, sorts by value (<code>sortByValue: true</code>), emits <code>win:start</code>, then per win per cycle dims losers (<code>dimLosers</code> alpha <code>0.35</code>), emits <code>win:group</code>, then <code>win:symbol</code> per cell spaced by <code>stagger</code> (0) and plays <code>symbolAnim</code> (<code>'win'</code>, a named animation, or a function). <code>cycleGap</code> 400 ms, <code>cycles</code> 1 (<code>-1</code> infinite). <code>win:end</code> fires in <code>finally</code>. In a cascade, call it from <code>presentWinners</code>.</p>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">SymbolSpotlight</div>
      <p class="text-sm text-foreground/80"><code>reelSet.spotlight</code>. <code>show(positions)</code> emits <code>spotlight:start</code>, dims the viewport (<code>dimAmount</code> 0.5), reparents each view into <code>viewport.spotlightContainer</code> (<code>promoteAboveMask</code> true), and awaits <code>playWin()</code> (<code>playWinAnimation</code> true). <code>hide()</code> reparents back, skipping views the pool recycled, and emits <code>spotlight:end</code>. <code>cycle(lines)</code> shows each for <code>displayDuration</code> 2000 ms with <code>gapDuration</code> 300 ms, <code>cycles</code> 1.</p>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">promote()</div>
      <p class="text-sm text-foreground/80"><code>ReelSet.promote(positions) → release</code> is the non-reparenting alternative. It attaches the views to <code>viewport.promotedLayer</code> (a RenderLayer), prunes itself on <code>symbol:created</code> when a swap hands the cell a new instance, and does no dim and no <code>playWin</code>. The engine never computes or draws wins (ADR 007); a <code>Win</code> is <code>{'{ cells, value?, kind?, id? }'}</code> and the order of <code>cells</code> matters when <code>stagger &gt; 0</code>.</p>
    </div>
  </div>

