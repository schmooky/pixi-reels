---
import Architecture from '../../layouts/Architecture.astro';
import Diagram from '../../components/arch/Diagram.astro';
import Box from '../../components/arch/Box.astro';
import Edge from '../../components/arch/Edge.astro';
import Group from '../../components/arch/Group.astro';
import Label from '../../components/arch/Label.astro';
import Legend from '../../components/arch/Legend.astro';

// (a) Legacy shape. y: 100% at 50, 0% at 250 (2 px per percent).
const yOf = (m: number) => 250 - m * 200;
const pow2out = (t: number) => 1 - (1 - t) * (1 - t);
const legacyDrop = Array.from({ length: 11 }, (_, k) => {
  const t = k / 10;
  return [220 + 105 * t, yOf(1 - 0.7 * pow2out(t))] as [number, number];
});
const legacyPts: [number, number][] = [[80, yOf(1)], [220, yOf(1)], ...legacyDrop, [610, yOf(0.3)], [740, yOf(0.3)], [740, yOf(0)], [860, yOf(0)]];
const legacyPath = legacyPts.map(([x, y], i) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');

// (b) Curve shape: three segments at 0.5 px per ms. y: 0% at 250, 100% at 130 (1.2 px per percent).
const yC = (m: number) => 250 - m * 120;
const pow2inout = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2);
type Seg = { name: string; speed: number; duration: number; hold: number };
const segs: Seg[] = [
  { name: 'surge', speed: 1.5, duration: 150, hold: 100 },
  { name: 'crawl', speed: 0.15, duration: 350, hold: 250 },
  { name: 'final', speed: 0.3, duration: 150, hold: 300 },
];
const PX = 0.5;
let cx0 = 160;
let cur = 1;
const curvePts: [number, number][] = [[80, yC(1)], [160, yC(1)]];
const segMarks: { x: number; xEnd: number; xHold: number; seg: Seg; from: number }[] = [];
for (const seg of segs) {
  const from = cur;
  const xEnd = cx0 + seg.duration * PX;
  for (let k = 1; k <= 10; k++) {
    const t = k / 10;
    curvePts.push([cx0 + (xEnd - cx0) * t, yC(from + (seg.speed - from) * pow2inout(t))]);
  }
  const xHold = xEnd + seg.hold * PX;
  curvePts.push([xHold, yC(seg.speed)]);
  segMarks.push({ x: cx0, xEnd, xHold, seg, from });
  cx0 = xHold;
  cur = seg.speed;
}
curvePts.push([cx0, yC(0)], [cx0 + 40, yC(0)]);
const curvePath = curvePts.map(([x, y], i) => `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');

// (c) Stagger modes, 0.11 px per ms inside a 250px panel.
const S = 0.11;
const TEASE = 450;
const STOP = 250;
const panels = [
  { x: 10, title: 'stagger: 200', note: 'order * 200 ms', offsets: [0, 200, 400] },
  { x: 310, title: 'stagger: [0, 100, 500]', note: 'arr[order] ?? 0', offsets: [0, 100, 500] },
  { x: 610, title: "stagger: 'sequential'", note: 'waits for the previous tease reel to land', offsets: [0, TEASE + STOP, 2 * (TEASE + STOP)] },
];

// (d) Slowdown interpolation example.
const slow = { from: 0.5, to: 0.2, holdFrom: 1, holdTo: 1.6 };
const count = 3;
const orders = [0, 1, 2].map((order) => {
  const f = count === 1 ? 0 : order / (count - 1);
  const mult = slow.from + (slow.to - slow.from) * f;
  const hold = slow.holdFrom + (slow.holdTo - slow.holdFrom) * f;
  return { order, f, mult, hold, duration: Math.round(450 * hold) };
});
---
<Architecture
  title="Anticipation"
  subtitle="The slowdown curve, stagger, cells, protect, and how the stop takes over."
  eyebrow="Tension"
>
  <p>
    Anticipation is a per-spin list of reels that slow down and hold before they stop. You
    name them with <code>setAnticipation()</code> after <code>spin()</code>, the controller
    slots an <code>anticipation</code> phase between the group barrier and the stop, and the
    stop phase then creeps onto the frame at the tease speed instead of snapping back to full
    speed. The phase is <code>packages/pixi-reels/src/spin/phases/AnticipationPhase.ts</code>;
    the per-reel configuration and the stagger are in
    <code>packages/pixi-reels/src/spin/SpinController.ts</code>. ADR 020
    (<code>docs/adr/020-anticipation-feel.md</code>) records why the curve looks the way it does.
  </p>

  <Diagram width={900} height={330} caption="The legacy shape on NORMAL. Speed drops to 30% over the first 35% of the hold with power2.out, holds for the remaining 65%, keeps that speed through the stop delay, and the spin-out inherits it through preserveSpeed, clamped between 8% and 100% of spinSpeed.">
    <line x1={80} y1={250} x2={860} y2={250} class="guide-strong" />
    <line x1={80} y1={40} x2={80} y2={250} class="guide-strong" />
    <Label x={74} y={yOf(1) + 4} text="100%" size={10} anchor="end" mono tone="faint" />
    <Label x={74} y={yOf(0.3) + 4} text="30%" size={10} anchor="end" mono tone="faint" />
    <Label x={74} y={yOf(0.08) + 4} text="8%" size={10} anchor="end" mono tone="faint" />
    <Label x={74} y={yOf(0) + 4} text="0" size={10} anchor="end" mono tone="faint" />
    <Label x={30} y={140} text="speed / spinSpeed" size={10} anchor="middle" rotate={-90} />

    <line x1={80} y1={yOf(1)} x2={860} y2={yOf(1)} class="guide" style="stroke-dasharray:4 3" />
    <line x1={80} y1={yOf(0.08)} x2={860} y2={yOf(0.08)} class="guide" style="stroke-dasharray:4 3" />
    <Label x={858} y={yOf(1) - 4} text="preserveSpeed cap: spinSpeed" size={9.5} anchor="end" tone="faint" />
    <Label x={858} y={yOf(0.08) - 4} text="preserveSpeed floor: 0.08 x spinSpeed" size={9.5} anchor="end" tone="faint" />

    {[220, 325, 520, 610, 740].map((x) => (
      <line x1={x} y1={44} x2={x} y2={250} class="guide" />
    ))}
    <path d={legacyPath} class="edge edge-primary" />

    <Label x={150} y={60} text={['spin', 'full speed']} size={10} anchor="middle" />
    <Label x={272} y={60} text={['drop: 35% of hold', 'power2.out']} size={10} anchor="middle" />
    <Label x={422} y={60} text={['hold: 65% of hold', 'at spinSpeed x 0.3']} size={10} anchor="middle" />
    <Label x={565} y={60} text={['stop.delay', 'speed kept']} size={10} anchor="middle" />
    <Label x={675} y={60} text={['spinOut', 'preserveSpeed']} size={10} anchor="middle" />
    <Label x={800} y={60} text={['land', 'bounce']} size={10} anchor="middle" />
    <Label x={422} y={100} text="anticipation phase: tease step (cut)" size={10} anchor="middle" mono tone="fg" weight={600} />
    <Edge from={[220, 110]} to={[520, 110]} arrow="both" />

    {[
      [80, 220, 'span-spin'],
      [220, 520, 'span-anticipation'],
      [520, 610, 'span-rest'],
      [610, 740, 'span-stop'],
      [740, 860, 'span-bounce'],
    ].map(([a, b, cls]) => (
      <rect x={a as number} y={262} width={(b as number) - (a as number)} height={12} rx={3} class={cls as string} />
    ))}
    <Label x={80} y={296} text="anticipation:reel fires at the tease start, spin:stopping right after; anticipation:reelEnd fires from _markLanded, just before spin:reelLanded" size={10} />
    <Label x={80} y={312} text="speed = min(max(reel.speed, spinSpeed * 0.08), spinSpeed) when the stop phase starts with preserveSpeed" size={10} mono />
  </Diagram>

  <div class="not-prose my-8">
    <Legend items={[
      { kind: 'subtle', label: 'tease', note: 'one cut step; a quicken ends it, a slam cancels it' },
      { kind: 'muted', label: 'stop.delay', note: 'runs after the tease at the tease speed' },
      { kind: 'primary', label: 'spinOut', note: 'preserveSpeed only when the tease played to its end and no quicken touched the reel' },
    ]} />
  </div>

  <h2>setAnticipation(reelIndices, options = 0)</h2>
  <p>
    <code>options</code> is either a bare stagger value or an <code>AnticipationOptions</code>
    object: <code>{'{ stagger, slowdown, protect, duration, curve, cells }'}</code>. It must be
    called <strong>after</strong> <code>spin()</code>, because <code>spin()</code> clears every
    anticipation field, and <strong>before</strong> <code>setResult()</code>, so a queued
    <code>requestSkip()</code> that fires inside <code>setResult</code> can see the protection.
    Held reels are filtered out silently. Function forms of <code>curve</code> and
    <code>cells</code> are resolved right away, once per reel, with <code>(order, total)</code>
    where <code>order</code> is the reel's position in the tease list; a function that returns
    nothing throws, and because they run once, randomness or counters inside them behave
    predictably. <code>protect: true</code> is normalized to <code>'once'</code>.
  </p>
  <p><code>assertAnticipationOptions</code> throws on:</p>
  <ul>
    <li><code>curve</code> and <code>slowdown</code> together,</li>
    <li><code>cells</code> that is not a function and not greater than 0,</li>
    <li>an empty <code>curve</code>,</li>
    <li>a segment with a negative or NaN <code>speed</code>, a <code>duration &lt;= 0</code>, or a negative <code>hold</code>.</li>
  </ul>
  <p>
    It warns (<code>anticipation-cells-unreachable</code>) if the final curve segment has speed 0
    while <code>cells</code> is set, because the travel target can then never be reached.
  </p>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60">
          <tr>
            <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Option</th>
            <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Type</th>
            <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Default</th>
            <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Meaning</th>
          </tr>
        </thead>
        <tbody>
          {[
            ['stagger', "number | number[] | 'sequential'", '0', 'offset between tease starts, by tease order, not reel index'],
            ['slowdown', '{ from?, to?, holdFrom?, holdTo? }', 'from 0.3, to = from, holdFrom 1, holdTo = holdFrom', 'linear interpolation across tease order'],
            ['protect', "boolean | 'once' | 'stepwise' | 'always'", 'false', 'what a skip() press may end; true means once'],
            ['duration', 'number (ms)', "profile anticipationDelay", 'the hold; a positive value keeps the tease alive on TURBO and SUPER_TURBO'],
            ['curve', 'AnticipationSegment[] | (order, total) => segments', 'none (legacy shape)', 'segments of { speed, duration, ease?, hold? }; ease defaults to power2.inOut'],
            ['cells', 'number | (order, total) => number', 'none', 'travel target in symbol pitches for the final leg, with duration as the backstop'],
          ].map(([k, t, d, m]) => (
            <tr class="border-t border-border/60">
              <td class="px-4 py-2.5 font-mono text-primary text-xs">{k}</td>
              <td class="px-4 py-2.5 font-mono text-xs text-muted-foreground">{t}</td>
              <td class="px-4 py-2.5 font-mono text-xs text-foreground/80">{d}</td>
              <td class="px-4 py-2.5 text-xs text-foreground/80">{m}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <h2>The tease gate and the two shapes</h2>
  <p>
    In <code>_startReel</code>, after the group barrier, the controller computes
    <code>antBaseDuration = _anticipationDuration ?? speed.anticipationDelay</code>. A reel teases
    only if it is in the list, that effective hold is greater than 0, and no quicken has reached
    it. NORMAL holds 450 ms and TURBO 250 ms, so both tease; SUPER_TURBO's
    <code>anticipationDelay</code> is 0, so it does not tease unless <code>duration</code> is set.
    The teasing reel first awaits its stagger offset at full speed, then joins
    <code>_teasingReels</code>, calls <code>reel.notifyAnticipationStart()</code> (which lets a
    symbol relax its spin look, for example fading out blur, through its
    <code>onReelAnticipationStart</code> hook), emits <code>anticipation:reel {'{ reelIndex, order, total }'}</code>,
    then <code>spin:stopping</code>, and runs the phase with <code>_anticipationConfigFor(i)</code>.
  </p>
  <p>
    Inside the phase, the single <code>tease</code> step computes
    <code>duration = config.duration ?? step.duration ?? timing.anticipationDelay</code>; if that is
    0 or less the tease ends immediately. The <strong>legacy shape</strong> (no curve) targets
    <code>spinSpeed * (speedMultiplier ?? 0.3)</code>: under the tween model a timeline goes to the
    target over <code>0.35 x duration</code> with <code>power2.out</code>, then an empty tween of
    <code>0.65 x duration</code>, then <code>_endTease</code>; under the drive model it sets
    <code>targetSpeed</code> and holds for the duration. ADR 020 explains the ease choice: an
    ease-out applied to a speed puts the jerk spike at the start, where the player expects it.
    When the step resolves the phase completes, and the controller starts the stop phase with
    <code>preserveSpeed: didAnticipate &amp;&amp; !quickened</code>.
  </p>

  <Diagram width={900} height={330} caption="A curve shape with three segments. Each leg tweens speed to spinSpeed x seg.speed over seg.duration with power2.inOut and then holds; anticipation:segment fires at each leg start. With cells set, the final hold ends when the odometer has moved that many cells, or when max(hold, backstop) runs out.">
    <line x1={80} y1={250} x2={860} y2={250} class="guide-strong" />
    <line x1={80} y1={40} x2={80} y2={250} class="guide-strong" />
    {[0, 0.5, 1, 1.5].map((m) => (
      <>
        <line x1={80} y1={yC(m)} x2={860} y2={yC(m)} class="guide" style="stroke-dasharray:4 3" />
        <Label x={74} y={yC(m) + 4} text={`${Math.round(m * 100)}%`} size={10} anchor="end" mono tone="faint" />
      </>
    ))}
    <path d={curvePath} class="edge edge-primary" />
    {segMarks.map((m, i) => (
      <>
        <circle cx={m.x} cy={yC(m.from)} r={4} class="span-bounce" />
        <Label x={m.x} y={yC(m.from) - 10} text={`anticipation:segment ${i}`} size={9.5} anchor={i === 0 ? 'start' : 'middle'} mono />
        <Label x={(m.x + m.xHold) / 2} y={272} text={[`${m.seg.name}: speed ${m.seg.speed}`, `${m.seg.duration} ms + hold ${m.seg.hold}`]} size={10} anchor="middle" />
        <rect x={m.x} y={258} width={m.xEnd - m.x} height={6} rx={2} class="span-anticipation" />
        <rect x={m.xEnd} y={258} width={m.xHold - m.xEnd} height={6} rx={2} class="span-rest" />
      </>
    ))}
    <Edge from={[segMarks[2].xEnd, 120]} to={[segMarks[2].xHold, 120]} arrow="both" />
    <Label x={(segMarks[2].xEnd + segMarks[2].xHold) / 2} y={110} text={['final leg with cells: hold until travelledCells >= cells', 'or until max(hold, backstop) ms; backstop = duration']} size={9.5} anchor="middle" />
    <Label x={120} y={60} text="full speed" size={10} anchor="middle" />
    <Label x={80} y={312} text="drive model: seg.duration is a time budget; if the drive misses the target by more than 0.5 it warns once (anticipation-drive-budget)" size={10} />
  </Diagram>

  <p>
    The <strong>curve shape</strong> runs <code>_runSegment</code> for each entry: emit
    <code>anticipation:segment {'{ reelIndex, index, total, speed, targetSpeed }'}</code>, tween to
    <code>spinSpeed * seg.speed</code> over <code>seg.duration</code> with
    <code>seg.ease ?? 'power2.inOut'</code>, hold <code>seg.hold</code>, move on. Earlier legs
    always play in full; only the final leg can be shortened or stretched by a travel target.
    With <code>cells</code> the phase records the odometer reading when the final hold begins and
    holds until the reel has moved that many cells, or until <code>max(hold, backstop)</code>
    passes, where the backstop is the duration in milliseconds. <code>update</code> calls
    <code>tickSteps()</code> and then the travel check. <code>onSkip</code>, for a slam or a
    quicken, kills the tween or delayed call and calls <code>forceSpeed(spinSpeed)</code>; under a
    quicken the runner then cuts the <code>tease</code> step, which completes the phase, and the
    reel does <em>not</em> join <code>_anticipatedReels</code>.
  </p>

  <h2>Stagger</h2>

  <Diagram width={900} height={200} caption="The three stagger forms on three tease reels (tease order 0, 1, 2). The offset is by tease order, the first reel never waits, and a waiting reel spins at full speed. 'sequential' waits for the previous tease reel's landing promise, so it is the slowest.">
    {panels.map((p) => (
      <>
        <Group x={p.x} y={10} w={280} h={180} label={p.title} note={p.note} />
        {p.offsets.map((off, order) => {
          const y = 50 + order * 36;
          const x0 = p.x + 16;
          const tStart = off * S;
          const tEnd = (off + TEASE) * S;
          const sEnd = (off + TEASE + STOP) * S;
          return (
            <>
              <Label x={x0} y={y + 16} text={`#${order}`} size={10} mono tone="faint" />
              <rect x={x0 + 24} y={y} width={240} height={24} rx={4} class="lane-bg" />
              {off > 0 && <rect x={x0 + 24} y={y + 4} width={tStart} height={16} rx={3} class="span-spin" />}
              <rect x={x0 + 24 + tStart} y={y + 4} width={tEnd - tStart} height={16} rx={3} class="span-anticipation" />
              <rect x={x0 + 24 + tEnd} y={y + 4} width={sEnd - tEnd} height={16} rx={3} class="span-stop" />
            </>
          );
        })}
        <Label x={p.x + 40} y={176} text="wait at full speed / tease 450 / stop" size={9.5} tone="faint" />
      </>
    ))}
  </Diagram>

  <p>
    <code>_awaitAnticipationOffset</code> resolves the stagger by tease order: a number gives
    <code>order * n</code> ms through <code>setTimeout</code>, an array gives
    <code>arr[order] ?? 0</code>, and <code>'sequential'</code> awaits the previous tease reel's
    landing promise. Those landing promises are created once per round at the start of
    <code>spin()</code>, not inside <code>setAnticipation</code>, so a waiter never receives a
    promise for a reel that has already landed. The <a href="/architecture/timeline/">timeline
    page</a> shows that <code>'sequential'</code> on two reels pushes the spin end from about 3.4 s
    to about 4.9 s.
  </p>

  <h2>Slowdown across tease order</h2>

  <Diagram width={800} height={210} caption="slowdown interpolates linearly across tease order with f = order / (count - 1). This example uses { from: 0.5, to: 0.2, holdFrom: 1, holdTo: 1.6 } on three reels with a 450 ms base hold.">
    {orders.map((o) => (
      <Box x={20 + o.order * 260} y={20} w={240} h={110} title={`tease order ${o.order}`} mono={false} kind={o.order === 1 ? 'accent' : 'subtle'} sub={[
        `f = ${o.order} / ${count - 1} = ${o.f.toFixed(2)}`,
        `speedMultiplier = ${o.mult.toFixed(2)}`,
        `holdMult = ${o.hold.toFixed(2)}`,
        `duration = 450 x ${o.hold.toFixed(2)} = ${o.duration} ms`,
      ]} />
    ))}
    <Label x={20} y={160} text="speedMultiplier = from + (to - from) * f        holdMult = holdFrom + (holdTo - holdFrom) * f        duration = base * holdMult" size={10.5} mono />
    <Label x={20} y={182} text="base = setAnticipation duration ?? profile anticipationDelay. With one tease reel, f = 0. duration is only written when holdMult differs from 1 or an override exists." size={10} />
  </Diagram>

  <p>
    <code>_anticipationConfigFor(i)</code> builds the phase config. With a curve it passes
    <code>{'{ curve: resolvedCurves[i], cells?, events, reelIndex, duration? }'}</code>, where
    <code>duration</code> only decides whether the tease runs and acts as the travel backstop. With
    no slowdown it passes <code>{'{ duration?, cells?, ... }'}</code> so the phase defaults apply:
    30% speed and an <code>anticipationDelay</code> hold. With a slowdown it computes the two
    multipliers above; <code>from</code> defaults to 0.3 and <code>to</code> to <code>from</code>,
    <code>holdFrom</code> to 1 and <code>holdTo</code> to <code>holdFrom</code>.
  </p>

  <h2>Protect, in one paragraph</h2>
  <p>
    <code>protect</code> is <code>false</code>, <code>'once'</code> (or <code>true</code>),
    <code>'stepwise'</code> or <code>'always'</code>. It decides what a <code>skip()</code> or a
    queued <code>requestSkip()</code> press may end: <code>'once'</code> lets the first press land
    only the non-tease reels and the next press land the tease; <code>'stepwise'</code> releases
    one tease reel per later press in tease order; <code>'always'</code> never lets a press end a
    tease, which leaves <code>skipStage</code> at 1 for the rest of the round.
    <code>slamStop()</code> ignores all of it. Protection does nothing when the effective hold is
    0 or less, and it reads the profile captured for this spin, not the live one. The press
    algorithm, the stage values and the full table are on the
    <a href="/architecture/skipping/">skipping page</a>.
  </p>

  <h2>Handing over to the stop, and whenAnticipated</h2>
  <p>
    After a tease that played to its end, <code>didAnticipate</code> is true and the reel joins
    <code>_anticipatedReels</code>. Two things follow. The stop phase is created with
    <code>preserveSpeed: true</code>, so instead of returning to <code>spinSpeed</code> its
    spin-out keeps the current speed, clamped to <code>[0.08 x spinSpeed, spinSpeed]</code>; a surge
    above full speed is clamped at once, even under a drive. And every phase created afterwards
    for this reel gets <code>context.anticipated = true</code>, so the profile's
    <code>whenAnticipated</code> sections apply to its timing and step settings (see
    <a href="/architecture/speed-profiles/">speed profiles</a>). A tease cut short by a quicken
    sets neither: <code>preserveSpeed</code> is off and <code>whenAnticipated</code> is ignored. In
    cascade mode the tease is a pure hold at speed 0: <code>curve</code> and <code>cells</code> are
    dropped with a one-time warning, <code>speedMultiplier</code> is forced to 0, and after the
    tease the reel is halted and snapped before <code>cascade:place</code> runs.
  </p>

  <h2>anticipationForScatters</h2>
  <p>
    <code>packages/pixi-reels/src/spin/anticipationRecipes.ts</code> exports
    <code>anticipationForScatters(grid, {'{ symbol, trigger = 2, mode = \'all-remaining\' }'})</code>.
    It counts <code>symbol</code> in each reel's visible cells from left to right; the trigger reel
    is the first one where the running total reaches <code>trigger</code>. It returns the reels
    after that one: all of them for <code>'all-remaining'</code>, or only those with at least one
    <code>symbol</code> for <code>'scatter-only'</code>, and <code>[]</code> if the trigger is never
    reached. Pass the result straight to <code>setAnticipation</code>. Worked examples live under
    the <a href="/recipes/anticipation/">anticipation recipes</a>.
  </p>

  <h2>Events</h2>
  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
