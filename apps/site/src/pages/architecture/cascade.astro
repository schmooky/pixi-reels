---
import Architecture from '../../layouts/Architecture.astro';
import Diagram from '../../components/arch/Diagram.astro';
import Box from '../../components/arch/Box.astro';
import Edge from '../../components/arch/Edge.astro';
import Group from '../../components/arch/Group.astro';
import Label from '../../components/arch/Label.astro';
import Cell from '../../components/arch/Cell.astro';
import Legend from '../../components/arch/Legend.astro';

type K = 'plain' | 'hot' | 'new' | 'empty' | 'buffer';
type Col = { title: string; x: number; cells: [string, K, string?][] };
// Cells of 48 on a 56 pitch; each stage column is 48 wide with its offsets beside it.
const forward: Col[] = [
  { title: '1. before', x: 40, cells: [['A', 'plain'], ['B', 'hot'], ['C', 'plain'], ['D', 'hot'], ['E', 'plain']] },
  { title: '2. remove', x: 210, cells: [['A', 'plain'], ['', 'empty'], ['C', 'plain'], ['', 'empty'], ['E', 'plain']] },
  { title: '3. gravity', x: 380, cells: [['', 'empty'], ['', 'empty'], ['A', 'plain', '+2'], ['C', 'plain', '+1'], ['E', 'plain', '0']] },
  { title: '4. fill', x: 550, cells: [['X', 'new', '+2'], ['Y', 'new', '+2'], ['A', 'plain', '+2'], ['C', 'plain', '+1'], ['E', 'plain', '0']] },
];
const reverse: Col[] = [
  { title: '3. gravity', x: 200, cells: [['A', 'plain', '0'], ['C', 'plain', '-1'], ['E', 'plain', '-2'], ['', 'empty'], ['', 'empty']] },
  { title: '4. fill', x: 400, cells: [['A', 'plain', '0'], ['C', 'plain', '-1'], ['E', 'plain', '-2'], ['X', 'new', '-2'], ['Y', 'new', '-2']] },
];
const cellY = (i: number) => 70 + i * 56;
const offsetRows = [
  ['0', 'X (new)', '-2', '2', '0', 'A', '0', '0'],
  ['1', 'Y (new)', '-1', '2', '1', 'C', '2', '-1'],
  ['2', 'A', '0', '2', '2', 'E', '4', '-2'],
  ['3', 'C', '2', '1', '3', 'X (new)', '5', '-2'],
  ['4', 'E', '4', '0 (no job)', '4', 'Y (new)', '6', '-2'],
];
---
<Architecture
  title="Cascade physics"
  subtitle="Why survivors without holes below them never move."
  eyebrow="Algorithm"
>
  <p>
    A correct cascade drop has one invariant: <strong>a symbol moves only if
    there are cleared cells beneath it on the gravity side</strong>. Getting
    this wrong is the classic cascade bug. Naive implementations shift every
    visible cell by the winner count and tween back, so untouched symbols
    visibly jump. pixi-reels computes a per-cell fall distance from the
    winners list with one pure function,
    <code>computeDropOffsets</code> in
    <code>packages/pixi-reels/src/cascade/tumbleAlgorithm.ts</code>, and a cell
    whose offset is zero never gets an animation job: its view stays exactly
    where placement put it.
  </p>

  <h2>The algorithm, in one column</h2>

  <Diagram height={420} caption="Forward gravity, five cells, winners [1, 3]: winCount 2, survivorCount 3. Survivors pack toward the end and two new symbols enter at the start, every new symbol travelling exactly winCount cells. The number beside a cell is its offsetCells; E has no hole below it and is never touched.">
    {forward.map((col) => (
      <>
        <Label x={col.x + 24} y={46} text={col.title} weight={600} anchor="middle" tone="fg" />
        {col.cells.map(([label, kind, off], i) => (
          <>
            <Cell x={col.x} y={cellY(i)} size={48} label={label || undefined} kind={kind} />
            {off && <Label x={col.x + 60} y={cellY(i) + 29} text={off} mono tone="fg" />}
          </>
        ))}
      </>
    ))}
    {[0, 1, 2].map((i) => (
      <Edge from={[forward[i].x + 100, cellY(2) + 24]} to={[forward[i + 1].x - 16, cellY(2) + 24]} />
    ))}
    <Label x={360} y={400} text="offsetCells = cell - originalCell" size={14} mono tone="fg" anchor="middle" />
  </Diagram>

  <Diagram height={380} caption="Reverse gravity, the same winners [1, 3] and the same arithmetic mirrored: survivors pack toward the start, the new symbols enter at the end, and the offsets are negative. Stages 1 and 2 are identical to the forward case.">
    {reverse.map((col) => (
      <>
        <Label x={col.x + 24} y={46} text={col.title} weight={600} anchor="middle" tone="fg" />
        {col.cells.map(([label, kind, off], i) => (
          <>
            <Cell x={col.x} y={cellY(i)} size={48} label={label || undefined} kind={kind} />
            {off && <Label x={col.x + 60} y={cellY(i) + 29} text={off} mono tone="fg" />}
          </>
        ))}
      </>
    ))}
    <Edge from={[reverse[0].x + 100, cellY(2) + 24]} to={[reverse[1].x - 16, cellY(2) + 24]} />
    <Label x={360} y={366} text="isNew when cell >= survivorCount" size={14} mono tone="fg" anchor="middle" />
  </Diagram>

  <div class="not-prose my-4 rounded-xl border border-border bg-card overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-muted/60">
        <tr>
          <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground" colspan="4">forward</th>
          <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground" colspan="4">reverse</th>
        </tr>
        <tr>
          {['cell', 'id', 'originalCell', 'offsetCells', 'cell', 'id', 'originalCell', 'offsetCells'].map((h) => (
            <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{h}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {offsetRows.map((r) => (
          <tr class="border-t border-border/60">
            {r.map((v) => <td class="px-4 py-2 font-mono text-xs">{v}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="not-prose my-8">
    <Legend items={[
      { kind: 'subtle', label: 'survivor', note: 'offsetCells 0 means no animation at all' },
      { kind: 'primary', label: 'winner', note: 'destroyed, then its cell is a hole' },
      { kind: 'accent', label: 'new symbol', note: 'enters from the gravity-entry end, travels winCount cells' },
      { kind: 'muted', label: 'hole', note: 'never rendered; the grid you pass has no holes' },
    ]} />
  </div>

  <h2>computeDropOffsets, exactly</h2>

  <p>
    <code>computeDropOffsets(visibleCells, winnerCells, {`{ initial = false, gravity = 'forward' }`})</code>
    returns one <code>DropOffset</code> per visible cell of the <em>new</em> grid:
  </p>
  <ul>
    <li><code>cell</code>: the visible cell in the new grid.</li>
    <li><code>originalCell</code>: the virtual "came from" index. Negative (forward) or <code>&gt;= visibleCells</code> (reverse) for a new symbol, the survivor's old cell otherwise.</li>
    <li><code>offsetCells</code>: <code>cell - originalCell</code>, signed. Zero means do not animate.</li>
    <li><code>isNew</code>: the discriminator to branch on. The sign of <code>originalCell</code> only works under forward gravity.</li>
  </ul>
  <p>
    The steps: <code>winCount = initial ? visibleCells : winnerCells.length</code>
    (the winner set is empty when initial); <code>nonWinnerCells</code> is the
    old cells not in the set, ascending; <code>survivorCount = visibleCells - winCount</code>.
    Then for each <code>cell</code>: under forward gravity it is new when
    <code>cell &lt; winCount</code>, under reverse when
    <code>cell &gt;= survivorCount</code>. A new symbol's
    <code>originalCell</code> is <code>cell - winCount</code> (forward) or
    <code>cell + winCount</code> (reverse), so every arrival travels the same
    <code>winCount</code> cells and lands in one beat. A survivor's is
    <code>nonWinnerCells[cell - winCount]</code> (forward) or
    <code>nonWinnerCells[cell]</code> (reverse). <strong>Moment A</strong>, the
    initial drop, passes <code>initial: true</code>: every cell is new and
    travels <code>visibleCells</code>. <strong>Moment B</strong>, a refill,
    passes the cleared cells; an empty list means every offset is 0, and
    <code>initial</code> defaults to false so a reel with no winners cannot
    trigger a full re-drop by accident. Orientation never reaches the function;
    only gravity does. It is exported so you can validate a server-side gravity
    sim offline.
  </p>
  <p>
    <strong>The server contract follows from this.</strong> In the grid you
    pass to <code>refill</code> or return from <code>nextGrid</code>, the
    <code>winners.length</code> cells at the gravity-entry end hold the new
    symbols and the survivors keep their original order. The engine animates
    the grid it is given; it does not reorder it. ADR 010 still describes a
    staggered entrance (a new symbol at row R starting R+1 slots up) and uses
    the v1 names <code>row</code> / <code>offsetRows</code>; the code moves
    every new symbol a uniform <code>winCount</code> and uses
    <code>cell</code> / <code>offsetCells</code>. The code is the source of
    truth here. ADR 010's central rule holds: zero-offset cells are never
    touched, and the API takes match winners, not a grid diff.
  </p>

  <h2>Why winners must be semantic, not diffed</h2>

  <p>
    Consider <code>prevCol = [A, C, X]</code> with <code>X</code> at cell 2
    winning. The correct next column is <code>[N, A, C]</code>: one new symbol
    at cell 0, two survivors shifted down by one. A "diff the two grids"
    approach reports <em>three</em> changed cells (A→N, C→A, X→C) and would
    animate three new symbols falling from above instead of one new plus two
    survivors sliding one slot. The API takes a <code>Cell[]</code> of match
    winners, so the answer is unambiguous. Your <code>detectWinners</code>
    callback returns the cells your game rules consider winners, nothing else.
  </p>

  <div class="not-prose my-6 grid gap-4 md:grid-cols-2">
    <div class="rounded-xl border border-border bg-card p-5">
      <div class="text-xs font-mono uppercase tracking-wider text-primary mb-2">Winner at the top</div>
      <p class="text-sm text-muted-foreground">One new symbol enters at cell 0 and travels one cell. <strong>Every survivor stays put.</strong></p>
    </div>
    <div class="rounded-xl border border-border bg-card p-5">
      <div class="text-xs font-mono uppercase tracking-wider text-primary mb-2">Winner in the middle</div>
      <p class="text-sm text-muted-foreground">Survivors above the winner each fall one cell. <strong>Survivors below do not move.</strong></p>
    </div>
    <div class="rounded-xl border border-border bg-card p-5">
      <div class="text-xs font-mono uppercase tracking-wider text-primary mb-2">Winner at the bottom</div>
      <p class="text-sm text-muted-foreground">Every survivor falls exactly one cell. The new symbol fills cell 0.</p>
    </div>
    <div class="rounded-xl border border-border bg-card p-5">
      <div class="text-xs font-mono uppercase tracking-wider text-primary mb-2">Two stacked winners at the top</div>
      <p class="text-sm text-muted-foreground">Two new symbols enter, each travelling two cells. <strong>No survivor moves.</strong></p>
    </div>
  </div>

  <h2>TumbleConfig</h2>

  <p>
    <code>builder.tumble(config)</code> registers the three cascade phases and
    makes <code>'cascade'</code> the default spin mode. The config
    (<code>packages/pixi-reels/src/cascade/TumbleConfig.ts</code>) holds
    animation values only; every callback is an event. The builder rejects v1
    key names and v1 <code>cellOrder</code> values.
  </p>

  <div class="not-prose my-4 rounded-xl border border-border bg-card overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-muted/60">
        <tr>
          <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Key</th>
          <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Default</th>
          <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Meaning</th>
        </tr>
      </thead>
      <tbody>
        {[
          ['fall.duration / ease / cellStagger', "300 ms / 'sine.in' / 0", 'the whole window drops out of the mask on spin()'],
          ['fall.cellOrder', "'auto'", "'auto' starts at the gravity-exit end; 'endFirst' / 'startFirst' name a fixed strip end"],
          ['dropIn.duration / ease / cellStagger', "600 ms / 'power2.out' / 60 ms", 'the ease deliberately has no overshoot'],
          ['dropIn.cellOrder', "'auto'", 'the stack fills from the gravity-exit floor'],
          ['dropIn.distance', "'perHole'", "'perHole': each symbol falls exactly as far as its hole. 'auto': full visible height, except refill survivors, which silently use per-hole geometry to avoid a teleport flash. A number: uniform pixels"],
          ['gravity', "'auto'", "follow each reel's travel direction; 'forward' settles toward the larger main coordinate, 'reverse' toward the smaller. Independent of travel"],
          ['per-profile overrides', 'none', 'speed.tumble.fall / speed.tumble.dropIn merged at each phase entry without mutating the base config'],
        ].map(([k, v, m]) => (
          <tr class="border-t border-border/60">
            <td class="px-4 py-2.5 font-mono text-xs">{k}</td>
            <td class="px-4 py-2.5 font-mono text-xs text-primary">{v}</td>
            <td class="px-4 py-2.5 text-xs text-foreground/80">{m}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>
    Helpers: <code>resolveGravity(g, direction)</code>, <code>gravitySign(g)</code>
    (+1 forward, -1 otherwise), <code>resolveCellOrder(order, gravity)</code>
    (<code>'auto'</code> becomes <code>'endFirst'</code> under forward gravity
    and <code>'startFirst'</code> under reverse), <code>resolveTumbleConfig</code>,
    <code>mergeFallConfig</code> and <code>mergeDropInConfig</code>. A delay
    between reels is not a tumble key: the fall is staggered by
    <code>speed.spinDelay</code>, and place and drop-in by the stop delays or
    <code>setDropOrder</code>.
  </p>

  <h2>The three phases, on a spin and on a refill</h2>

  <Diagram height={520} caption="spin() in cascade mode, per reel, after an optional early MultiWays adjust. Every cascade phase is a ReelPhase with skippable and quickenable set; update() does nothing because they are GSAP-timeline driven. The old window drops out, then the new one drops in.">
    <Box x={180} y={20} w={360} h={78} title="cascade:fall" sub={['replaces start', 'delay = stagger * spinDelay']} />
    <Box x={180} y={122} w={360} h={78} title="spin" sub={['waits for setResult', 'at speed 0']} />
    <Box x={180} y={224} w={360} h={78} kind="ghost" title="[anticipation]" sub={['if teased: haltDrive(),', 'then snapToGrid()']} />
    <Box x={180} y={326} w={360} h={78} title="cascade:place" sub={['initial: true, winners []', 'delay = stopDelay']} />
    <Box x={180} y={428} w={360} h={78} kind="primary" title="cascade:dropIn" sub={['initial: true', "role 'all'"]} />
    <Edge from={[360, 98]} to={[360, 122]} />
    <Edge from={[360, 200]} to={[360, 224]} />
    <Edge from={[360, 302]} to={[360, 326]} />
    <Edge from={[360, 404]} to={[360, 428]} />
  </Diagram>

  <Diagram height={320} caption="The two refill modes. 'combined' reuses place and dropIn with the winners list; 'gravity-then-drop' runs stage 1 on every reel in parallel, holds, then runs stage 2 per reel.">
    <Group x={10} y={20} w={700} h={142} kind="solid" label="refill mode 'combined'" note="the default" />
    <Box x={34} y={60} w={208} h={78} title="cascade:place" sub={['winnerCells for this reel', 'delay = its stop delay']} />
    <Box x={262} y={60} w={208} h={78} kind="primary" title="cascade:dropIn" sub={["role 'all': movers only", 'notifyLanded(moverCells)']} />
    <Box x={490} y={60} w={196} h={78} title="_markLanded" sub={['spin:reelLanded,', 'then spin:allLanded']} />
    <Edge from={[242, 99]} to={[262, 99]} />
    <Edge from={[470, 99]} to={[490, 99]} />

    <Group x={10} y={178} w={700} h={122} kind="solid" label="refill mode 'gravity-then-drop'" />
    <Box x={40} y={218} w={88} h={60} title="place" sub="delay 0" />
    <Box x={144} y={218} w={166} h={60} title="dropIn 'gravity'" sub="new ones at alpha 0" />
    <Box x={326} y={218} w={104} h={60} kind="accent" title="hold" sub="gravityHoldMs" />
    <Box x={446} y={218} w={88} h={60} title="sleep" sub="stop delay" />
    <Box x={550} y={218} w={130} h={60} kind="primary" title="dropIn 'new'" sub="reveal" />
    <Edge from={[128, 248]} to={[144, 248]} />
    <Edge from={[310, 248]} to={[326, 248]} />
    <Edge from={[430, 248]} to={[446, 248]} />
    <Edge from={[534, 248]} to={[550, 248]} />
  </Diagram>

  <p>
    In <code>'gravity-then-drop'</code> the first drop-in runs with role
    <code>'gravity'</code> and emits <code>cascade:gravity:*</code>; the hold is
    <code>gravityHoldMs</code> (250) plus <code>gravityHold</code>, then
    <code>onGravityComplete</code> is awaited; the second drop-in, role
    <code>'new'</code>, reveals the survivors in place.
  </p>

  <ul>
    <li><strong><code>CascadeFallPhase</code></strong> (<code>spin/phases/CascadeFallPhase.ts</code>) sets the spinning mode, calls <code>haltDrive()</code> and <code>notifySpinStart()</code>, merges <code>speed.tumble.fall</code>, waits its delay, then emits <code>cascade:fall:start</code> and builds one timeline. The fall distance is <code>(visibleCells + exitBuffer + 1) * slotPitch</code>, where <code>exitBuffer</code> is <code>bufferEnd</code> under forward gravity and <code>bufferStart</code> under reverse. Each cell gets a <code>cascade:fall:symbol</code> call and a tween of the main axis; on completion every view goes to alpha 0 and <code>cascade:fall:end</code> fires. A zero duration skips the per-symbol events. <code>onSkip</code> aborts the signal before <code>:end</code>, and emits <code>:end</code> only if <code>:start</code> already fired.</li>
    <li><strong><code>CascadePlacePhase</code></strong> is the identity swap: <code>beginMotion()</code> re-masks lifted views, <code>placeStrip</code> with buffer-above plus the visible cells (buffer-below is dropped so it random-fills, because a big-symbol anchor can live in buffer-above), <code>snapToGrid()</code>, <code>notifySpinEnd()</code>, then <code>computeDropOffsets</code> with the resolved gravity: survivors at offset 0 get alpha 1, movers alpha 0 so nothing flashes at its grid position. It emits <code>cascade:place:end {`{ reelIndex, placedSymbols, isInitial, winnerCells }`}</code> synchronously, before the drop starts, so decorations attached there fall with the symbol. There is no <code>:start</code>.</li>
    <li><strong><code>CascadeDropInPhase</code></strong> picks its event triplet from <code>role</code> (<code>'gravity'</code> emits <code>cascade:gravity:*</code>, <code>'all'</code> and <code>'new'</code> emit <code>cascade:dropIn:*</code>), fires <code>:start</code> at once, builds one job per moving cell (big-symbol anchors once), computes <code>startMain</code> from the distance mode, moves first and reveals second, and tweens to <code>finalMain</code> with the stagger and order from <code>cellOrder</code>. Each job emits a <code>:symbol</code> event <code>{`{ symbol, view, reelIndex, cellIndex, duration, ease, offsetCells, signal }`}</code>. <code>finish</code> emits <code>:end</code>; the <code>'gravity'</code> role calls <code>onReelLanded</code> on movers only, the others call <code>reel.notifyLanded(moverCells)</code>, so untouched survivors never replay a landing. Zero jobs or zero duration snaps straight to the end.</li>
  </ul>

  <h2>runCascade, the chain</h2>

  <Diagram height={600} caption="One stage of the chain, clockwise. detectWinners returning [] or reaching maxChain (32) ends it with a RunCascadeResult; a skip anywhere sets wasSkipped and every later refill slams.">
    <Box x={16} y={40} w={260} h={60} kind="accent" title="detectWinners(grid, chain)" sub="sync or async" />
    <Box x={456} y={40} w={248} h={60} title="cascade:chain:start" sub="{ chain, winners, currentGrid }" />
    <Box x={456} y={124} w={248} h={44} kind="ghost" title="presentWinners?" />
    <Box x={456} y={192} w={248} h={60} title="destroySymbols(winners)" sub="cascade:destroy:start, :end" />
    <Box x={456} y={276} w={248} h={44} kind="ghost" title="onCascade?" />
    <Box x={456} y={344} w={248} h={60} title="pause" sub="pauseAfterDestroyMs, abortable" />
    <Box x={456} y={428} w={248} h={60} kind="accent" title="nextGrid(grid, winners)" sub="then _assertGrid()" />
    <Box x={180} y={428} w={252} h={60} kind="primary" title="refill({ winners, grid })" sub="place and dropIn per reel" />
    <Box x={16} y={520} w={260} h={60} title="cascade:chain:end" sub="{ chain, winners, nextGrid }" />
    <Box x={70} y={200} w={206} h={78} kind="muted" title="RunCascadeResult" sub={['chainLength, totalWinners,', 'finalGrid, wasSkipped']} />

    <Edge from={[276, 70]} to={[456, 70]} />
    <Edge from={[580, 100]} to={[580, 124]} />
    <Edge from={[580, 168]} to={[580, 192]} />
    <Edge from={[580, 252]} to={[580, 276]} />
    <Edge from={[580, 320]} to={[580, 344]} />
    <Edge from={[580, 404]} to={[580, 428]} />
    <Edge from={[456, 458]} to={[432, 458]} />
    <Edge from={[306, 488]} via={[[306, 550]]} to={[276, 550]} />
    <Edge from={[40, 520]} to={[40, 100]} label="chain + 1" labelDx={52} />
    <Edge from={[173, 100]} to={[173, 200]} label="[] or maxChain" />
  </Diagram>

  <p>
    <code>reelSet.runCascade(options)</code> (<code>core/ReelSet.ts</code>)
    takes <code>detectWinners</code>, <code>nextGrid</code>, optional
    <code>presentWinners</code> and <code>onCascade</code>,
    <code>pauseAfterDestroyMs</code>, <code>maxChain</code>,
    <code>destroyOptions</code>, <code>refillMode</code>,
    <code>gravityHoldMs</code>, <code>gravityHold</code>,
    <code>onGravityComplete</code> and <code>signal</code>. The round's signal
    is forwarded to <code>destroySymbols</code> unless
    <code>destroyOptions</code> carries its own; <code>gravityHold</code> is
    wrapped so a builder function is invoked at gravity end; the
    <code>wasSkipped</code> check runs after every await. After each refill
    the loop sets <code>current = getVisibleGrid()</code>. The full event order
    for one stage is <code>cascade:chain:start</code>,
    <code>cascade:destroy:start</code>, <code>cascade:destroy:end</code>,
    <code>spin:start</code> (from refill), then per reel
    <code>cascade:place:end</code>, <code>cascade:dropIn:start</code>, the
    <code>:symbol</code> events, <code>cascade:dropIn:end</code> (gravity
    events first in two-stage mode) and <code>spin:reelLanding</code> /
    <code>spin:reelLanded</code>, then <code>spin:allLanded</code>,
    <code>spin:complete</code> and <code>cascade:chain:end</code>. The
    <a href="/architecture/events/">events page</a> has every payload.
  </p>
  <p>
    <code>refill</code> validates everything before taking any state:
    <code>_assertGrid</code> (shape, v1 keys, buffer counts), no spin or refill
    in flight, <code>.tumble()</code> present, column count and visible length
    matching the reels, winners in range. It then takes the spinning state,
    sets the spin mode to <code>'cascade'</code>, builds the frames up front,
    groups winners per reel ascending and emits <code>spin:start</code>. A
    failure in stage 1 or the hold of <code>'gravity-then-drop'</code> emits
    <code>cascade:gravity:error {`{ error }`}</code>, logs, and slams. From
    reading the code, <code>refill()</code> emits <code>spin:start</code> and
    <code>spin:allLanded</code>, so pin turns and <code>'eval'</code> pins are
    probably spent on every refill; that has not been tested.
  </p>

  <h2>Abort, skip and slam</h2>

  <ul>
    <li><strong>Per-phase signals.</strong> Each fall and drop-in run owns an <code>AbortController</code>, exposed as <code>signal</code> on <code>cascade:fall:symbol</code>, <code>cascade:dropIn:symbol</code> and <code>cascade:gravity:symbol</code>. It aborts only on an explicit skip and always before the paired <code>:end</code>; natural completion drops it without aborting. Your per-symbol decoration tweens should listen to it.</li>
    <li><strong>User signals mean fast-forward.</strong> A <code>signal</code> passed to <code>destroySymbols</code>, <code>refill</code> or <code>runCascade</code> jumps to the landed state; the promise still resolves (with <code>wasSkipped</code>). <code>ReelSet.refill</code> also listens for <code>skip:requested</code> and on abort calls <code>abortSlam()</code>.</li>
    <li><strong>Quicken becomes slam.</strong> In cascade mode there is no spin-out to quicken, so a <code>'quicken'</code> press is turned into a slam with a one-time warning (<code>quicken-cascade</code>).</li>
    <li><strong>One press auto-slams later refills.</strong> The first skip press in a cascade round sets <code>_autoSlamRefills</code> instead of a speed boost; every later <code>refill()</code> in that round lands instantly and skips the phase chain. The flag clears on the next round's <code>spin()</code>.</li>
    <li><strong><code>setDropOrder('ltr' | 'rtl' | 'all' | number[] | null, stepMs?)</code></strong> is sticky across <code>spin()</code> and <code>refill()</code> by design. The default step is <code>max(stopDelay, 150)</code>; the docstring says "150 ms if stopDelay is 0", the code is the source of truth here. Details on <a href="/architecture/skipping/">skipping</a>.</li>
  </ul>

  <h2>MultiWays interplay</h2>

  <p>
    <code>setShape(cellsPerReel)</code> throws if the set was not built with
    <code>.multiways()</code>, if it runs after <code>setResult()</code> in
    the current spin, or if a value leaves <code>[minCells, maxCells]</code>;
    otherwise it records the target shape, emits <code>shape:changed</code> and
    migrates pins eagerly. The correct order is <code>spin()</code> →
    <code>setShape()</code> → <code>setResult()</code>, and for a cascade spin
    calling <code>setShape</code> <em>before</em> <code>spin()</code> lets the
    adjust run before the fall, so the reel drops at its target height. Shape
    changes apply at the start of a spin (ADR 015): a reshape mid-chain inside
    <code>runCascade</code> is not supported, the chain uses the shape the spin
    landed with, and <code>runCascade</code> reads per-reel cell counts so it
    is shape-aware. Big symbols plus MultiWays still throw at build. ADR 015's
    phase names (<code>DropStartPhase</code>, <code>visibleRows</code>) are the
    old ones.
  </p>

  <h2>CascadeMode is legacy</h2>

  <p>
    <code>spin/modes/CascadeMode.ts</code> is a <code>SpinningMode</code> named
    <code>'cascade'</code> with a gravity factor of 1.5 whose
    <code>computeDelta</code> caps the per-frame step at one slot pitch. It is
    exported, but nothing inside the engine instantiates it: the tumble
    pipeline is the three phases above, and <code>CascadeFallPhase</code> sets
    <code>reel.spinningMode</code> only to satisfy the start-phase contract.
  </p>

  <h2>API surface</h2>

  <ul>
    <li><code>reelSet.destroySymbols(cells, opts?)</code>: the "pop" primitive. Range-checks every coordinate up front, emits <code>cascade:destroy:start {`{ cells }`}</code>, awaits <code>Promise.allSettled</code> of each symbol's own <code>playDestroy({`{ delay, signal }`})</code> so subclasses get art-appropriate disintegration (the default is a ~200 ms pop and implode), lists rejected cells in <code>cascade:destroy:end {`{ cells, failed? }`}</code>. Options: <code>delay</code> (seconds or <code>(cell, i) =&gt; s</code>, default 0), <code>zIndex</code> (default 1000, not restored, <code>null</code> skips), <code>dim</code> (false, <code>true</code> is 0.35), <code>signal</code>.</li>
    <li><code>reelSet.refill({`{ winners, grid, mode?, gravityHoldMs?, gravityHold?, onGravityComplete?, signal? }`})</code>: the "place + drop" primitive. Returns <code>RefillResult {`{ winnersRefilled, finalGrid, wasSkipped, skipContext, duration }`}</code>.</li>
    <li><code>reelSet.runCascade({`{ detectWinners, nextGrid, ... }`})</code>: the chain orchestrator above.</li>
    <li><code>computeDropOffsets(visibleCells, winnerCells, opts?)</code>: the algorithm itself, exported.</li>
  </ul>
  <p>
    The <a href="/guides/cascades/">cascades guide</a> walks a first chain and
    the <a href="/recipes/cascade/">cascade recipes</a> show destroy
    presentation, two-stage gravity and per-symbol decorations.
  </p>

