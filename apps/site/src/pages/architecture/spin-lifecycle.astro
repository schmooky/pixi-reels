---
import Architecture from '../../layouts/Architecture.astro';
import Diagram from '../../components/arch/Diagram.astro';
import Box from '../../components/arch/Box.astro';
import Edge from '../../components/arch/Edge.astro';
import Group from '../../components/arch/Group.astro';
import Label from '../../components/arch/Label.astro';
import Legend from '../../components/arch/Legend.astro';

// Column pitch for the two-lane state machine: 9 columns, 88 wide, 16 gap.
const col = (i: number) => 20 + i * 104;
const BW = 88;
const BH = 54;
const stdY = 70;
const casY = 262;
const slamY = 196;
---
<Architecture
  title="Spin lifecycle"
  subtitle="One spin as a state machine, per reel, with every phase and step."
  eyebrow="Lifecycle"
>
  <p>
    A spin is five independent reels, each walking its own chain of phases.
    <code>SpinController</code> (<code>packages/pixi-reels/src/spin/SpinController.ts</code>)
    runs that timing and nothing else: it does not draw (that is <code>Reel</code>
    and <code>ReelSymbol</code>) and it does not choose outcomes (that is your
    <code>setResult()</code> call). It starts every reel in the same tick, lets the
    speed profile stagger them, gates every stop on the result, and resolves one
    promise when the last reel lands or the spin is skipped. <code>ReelSet</code>
    wraps it; most public <code>ReelSet</code> methods forward straight to it.
  </p>

  <Diagram width={960} height={420} caption="Per-reel phase chain in the two spin modes. Each box is one ReelPhase the controller awaits in turn; the dashed slam line shows that forceComplete() can end any active phase and land the reel in the same tick.">
    <Group x={8} y={36} w={944} h={122} kind="tint" label="standard mode" note="spin() default, or spin({ mode: 'standard' })" />
    <Box x={col(0)} y={stdY} w={BW} h={BH} title="IDLE" kind="ghost" sub="at rest" size={11} />
    <Box x={col(1)} y={stdY} w={BW} h={BH} title="start" kind="accent" sub={['5 steps', 'stagger here']} size={11} />
    <Box x={col(2)} y={stdY} w={BW} h={BH} title="spin" kind="accent" sub={['until resolve()', '+ min spin time']} size={11} />
    <Box x={col(3)} y={stdY} w={BW} h={BH} title="adjust" kind="ghost" sub={['MultiWays', 'only']} size={11} />
    <Box x={col(4)} y={stdY} w={BW} h={BH} title="barrier" kind="muted" sub={['earlier groups', 'landed']} size={11} />
    <Box x={col(5)} y={stdY} w={BW} h={BH} title="anticipation" kind="ghost" sub={['tease (cut)', 'if listed']} size={11} />
    <Box x={col(6)} y={stdY} w={BW * 2 + 16} h={BH} title="stop" kind="accent" sub={['delay, spinOut,', 'land, bounce']} size={11} />
    <Box x={col(8)} y={stdY} w={BW} h={BH} title="landed" kind="primary" sub={['_markLanded', 'reelLanded']} size={11} />
    {[0, 1, 2, 3, 4, 5].map((i) => (
      <Edge from={[col(i) + BW, stdY + BH / 2]} to={[col(i + 1), stdY + BH / 2]} />
    ))}
    <Edge from={[col(6) + BW * 2 + 16, stdY + BH / 2]} to={[col(8), stdY + BH / 2]} />

    <Group x={8} y={228} w={944} h={122} kind="tint" label="cascade mode" note=".tumble() default, spin({ mode: 'cascade' }), every refill()" />
    <Box x={col(0)} y={casY} w={BW} h={BH} title="IDLE" kind="ghost" sub="at rest" size={11} />
    <Box x={col(1)} y={casY} w={BW} h={BH} title="fall" kind="accent" sub={['cascade:fall', 'replaces start']} size={11} />
    <Box x={col(2)} y={casY} w={BW} h={BH} title="spin" kind="accent" sub={['until resolve()', '+ min spin time']} size={11} />
    <Box x={col(3)} y={casY} w={BW} h={BH} title="adjust" kind="ghost" sub={['MultiWays', 'only']} size={11} />
    <Box x={col(4)} y={casY} w={BW} h={BH} title="barrier" kind="muted" sub={['earlier groups', 'landed']} size={11} />
    <Box x={col(5)} y={casY} w={BW} h={BH} title="anticipation" kind="ghost" sub={['pure hold', 'at speed 0']} size={11} />
    <Box x={col(6)} y={casY} w={BW} h={BH} title="place" kind="accent" sub={['cascade:place', 'after delay']} size={11} />
    <Box x={col(7)} y={casY} w={BW} h={BH} title="dropIn" kind="accent" sub={['cascade:dropIn', 'initial: true']} size={11} />
    <Box x={col(8)} y={casY} w={BW} h={BH} title="landed" kind="primary" sub={['_markLanded', 'reelLanded']} size={11} />
    {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
      <Edge from={[col(i) + BW, casY + BH / 2]} to={[col(i + 1), casY + BH / 2]} />
    ))}

    {/* slam line between the lanes: any active phase -> landed in the same tick */}
    <line x1={col(1) + BW / 2} y1={slamY} x2={col(8) + BW / 2} y2={slamY} class="edge edge-accent edge-dashed" />
    {[1, 2, 3, 4, 5].map((i) => (
      <line x1={col(i) + BW / 2} y1={stdY + BH} x2={col(i) + BW / 2} y2={slamY} class="edge edge-accent edge-dashed" />
    ))}
    <line x1={col(6) + BW + 8} y1={stdY + BH} x2={col(6) + BW + 8} y2={slamY} class="edge edge-accent edge-dashed" />
    {[1, 2, 3, 4, 5, 6, 7].map((i) => (
      <line x1={col(i) + BW / 2} y1={casY} x2={col(i) + BW / 2} y2={slamY} class="edge edge-accent edge-dashed" />
    ))}
    <Edge from={[col(8) + BW / 2, slamY]} to={[col(8) + BW / 2, stdY + BH + 2]} kind="accent" style="dashed" />
    <Edge from={[col(8) + BW / 2, slamY]} to={[col(8) + BW / 2, casY - 2]} kind="accent" style="dashed" />
    <g transform={`translate(${col(4) + BW + 8} ${slamY})`}>
      <rect x={-30} y={-9} width={60} height={18} rx={9} class="edge-label-bg" />
      <text x="0" y="4" text-anchor="middle" font-size="10.5" font-weight="500" class="edge-label mono">slam</text>
    </g>

    <Label x={20} y={376} text={[
      'slam: forceComplete(ctx) on whichever phase is active. The reel is placed on its frame and lands in the same tick.',
      'quicken: cuts only the steps marked cut (start.delay, anticipation.tease, stop.delay). launch, pull, accelerate, spinOut, land and bounce still play.',
      'In cascade mode a quicken is turned into a slam (one warning). Held reels skip the whole chain and count as landed.',
    ]} size={10.5} />
  </Diagram>

  <div class="not-prose my-8">
    <Legend items={[
      { kind: 'accent', label: 'phase every reel runs', note: 'start, spin, stop or their cascade stand-ins' },
      { kind: 'subtle', label: 'optional phase', note: 'dashed: adjust needs MultiWays, anticipation needs setAnticipation()' },
      { kind: 'muted', label: 'barrier', note: 'an await, not a phase: no ReelPhase object exists' },
      { kind: 'primary', label: 'landed', note: '_markLanded(i) resolves the promise once every reel is here' },
    ]} />
  </div>

  <h2>What the controller owns</h2>
  <p>
    The constructor takes the <code>Reel[]</code>, the <code>SpeedManager</code>, the
    <code>FrameBuilder</code>, the <code>PhaseFactory</code>, the set-level
    <code>EventEmitter</code>, the Pixi <code>Ticker</code>, an optional
    <code>SpinningMode</code> (default <code>StandardMode</code>), the default spin mode
    (<code>'standard'</code> or <code>'cascade'</code>) and optional
    <code>SpinControllerHooks</code>. The hooks are the MultiWays and big-symbol
    callbacks (<code>isMultiWaysSlot</code>, <code>peekTargetShape</code>,
    <code>clearTargetShape</code>, <code>getPinsOnReel</code>, <code>migratePinsForReel</code>
    and so on); every one defaults to a no-op. It registers a single ticker callback,
    <code>_onTick</code>, which while a spin runs calls <code>reel.update(deltaMs)</code>
    on every reel and then <code>phase.update(deltaMs)</code> on every active phase.
    <code>attachReel</code> turns each reel's <code>landing</code> event into the set-level
    <code>spin:reelLanding</code>.
  </p>
  <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">Per spin, reset by spin()</div>
      <ul class="text-sm space-y-1 text-foreground/80">
        <li><code>_isSpinning</code>, <code>_spinStartTime</code>, <code>_resultSymbols</code>, <code>_cachedFrames</code></li>
        <li><code>_activePhases: Map&lt;reelIndex, ReelPhase&gt;</code>, <code>_landedReels</code>, <code>_slammedReels</code>, <code>_heldReels</code></li>
        <li><code>_activeSpinSpeed</code>: the profile captured once for this spin</li>
        <li>every anticipation field: reels, stagger, slowdown, curve, cells, duration, protect, <code>_teasingReels</code>, <code>_anticipatedReels</code></li>
        <li><code>_reelLandedPromises</code>: one landing promise per reel, used by <code>'sequential'</code> stagger and group barriers</li>
        <li>skip state for the press: <code>_wasSkipped</code>, <code>_skipMode</code>, <code>_skipCtx</code>, <code>_skipPending</code>, <code>_quickenedReels</code>, <code>_quickenBatches</code></li>
      </ul>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-1">Persisting across spins</div>
      <ul class="text-sm space-y-1 text-foreground/80">
        <li><code>_stopDelayOverride</code> and <code>_dropOrder</code> (<code>setStopDelays</code>, <code>setDropOrder</code>)</li>
        <li><code>_reelGroups</code> and <code>_groupOfReel</code> (<code>setReelGroups</code>)</li>
        <li><code>_minimumSpinTimeOverride</code> (<code>setMinimumSpinTime</code>)</li>
        <li><code>defaultSkipMode</code>, public, default <code>'slam'</code></li>
        <li>round-level skip state: <code>_skipStage</code> (0, 1, 2), <code>_skipPreviousSpeedName</code>, <code>_skipBoostedToName</code>, <code>_manualSpeedSinceBoost</code>, <code>_autoSlamRefills</code></li>
        <li>promise plumbing: <code>_currentSpinResolve</code>, <code>_currentSpinReject</code>, <code>_pendingAbortError</code>, <code>_spinWatchdogCleanup</code></li>
        <li><code>_spinGeneration</code>: the abort switch, see below</li>
      </ul>
    </div>
  </div>

  <h2>spin(), step by step</h2>
  <ol>
    <li>Throws if a spin is already running. If <code>options.signal</code> is already aborted, rejects at once.</li>
    <li><code>resolveSpinMode</code>: <code>'cascade'</code> requires the <code>cascade:fall</code> phase to be registered (so <code>.tumble()</code>), <code>'standard'</code> requires <code>bufferEnd &gt;= 1</code> on every reel. Either failure throws.</li>
    <li>Round boundary, skipped when <code>round.continueRound</code> is set (which <code>expand()</code> steps use): if an earlier skip boosted the speed and you have not called <code>setSpeed()</code> since, the previous profile is restored; <code>_skipStage</code> goes back to 0 and <code>_autoSlamRefills</code> to false.</li>
    <li>Per-spin reset: result, every anticipation setting, the quicken sets, the landed and slammed sets and the active phases are cleared; fresh landing promises are created; a press carried from the previous <code>expand()</code> step becomes <code>_skipPending</code>. The stop-delay override is deliberately kept.</li>
    <li><code>holdReels</code> is normalized: out-of-range, non-integer and duplicate entries are dropped.</li>
    <li><code>_staggerRank</code> is built only for <code>expand()</code> steps that use <code>stagger: 'spinning'</code>.</li>
    <li><code>_spinGeneration++</code>, then the speed profile is captured once: <code>speed = speedManager.active</code>, stored in <code>_activeSpinSpeed</code>. Every phase in this spin receives that same object, which is why speed changes take effect on the next spin.</li>
    <li>Emits <code>spin:start</code>, creates the result promise and arms the watchdog.</li>
    <li>If every reel is held, the spin finishes on the next microtask with no animation.</li>
    <li>For each non-held reel: <code>_runReelTask(_startReel(i, speed, generation), 'spin', i, generation)</code>. All reels start in the same tick; the visible stagger comes from each start phase's <code>delay</code> step.</li>
  </ol>
  <p>
    <code>_runReelTask</code> is the safety net. If a reel's chain throws, it logs
    <code>noticeError('phase-chain-threw')</code> and calls <code>_slam()</code>, so the spin
    resolves with <code>wasSkipped: true</code> instead of hanging. Errors from an older
    generation are dropped.
  </p>

  <h2>_startReel: one reel's chain</h2>
  <ol>
    <li>Sets <code>reel.referenceSpeed = speed.spinSpeed</code>, the divisor for <code>speedNormalized</code> and the drive bounds.</li>
    <li>Cascade only: if a MultiWays target shape is already pending, the adjust runs before the fall so the reel falls at its new height.</li>
    <li><strong>Start.</strong> Cascade mode creates <code>cascade:fall</code> with <code>{'{ spinningMode, delay, events }'}</code>; otherwise <code>start</code> with <code>{'{ spinningMode, delay }'}</code>. In both cases <code>delay = _staggerIndex(i) * speed.spinDelay</code>.</li>
    <li><strong>Spin.</strong> Creates <code>spin</code> with <code>{'{ minimumSpinTime }'}</code>: the per-reel override from <code>setMinimumSpinTime</code>, or 0 if a quicken has already reached this reel. It does not await yet.</li>
    <li><code>if (_announceAllStartedIfReady()) _tryBeginStopSequence()</code>. The reel whose spin phase completes the set emits <code>spin:allStarted</code> and tries to open the stop gate.</li>
    <li><code>await spinDone</code>. This resolves only after the controller calls <code>spinPhase.resolve()</code> <em>and</em> the minimum spin time has elapsed.</li>
    <li><strong>Adjust</strong> (MultiWays): <code>_runAdjustForReel</code> commits the reshape through <code>_applyReshape</code>, which emits <code>adjust:start</code> and <code>adjust:complete</code>. An <code>AdjustPhase</code> is created only if there are pin overlays to tween.</li>
    <li><strong>Group barrier:</strong> <code>await _awaitGroupTurn</code>. The reel keeps spinning at full speed until every earlier group has landed.</li>
    <li><code>stopDelay = _stopDelayFor(i, speed)</code>, <code>targetFrame = _frameFor(i)</code>, <code>antBaseDuration = _anticipationDuration ?? speed.anticipationDelay</code>.</li>
    <li><strong>Tease decision.</strong> The reel teases if it is in <code>_anticipationReels</code>, <code>antBaseDuration &gt; 0</code>, and it has not been quickened. It first awaits <code>_awaitAnticipationOffset</code> at full speed, joins <code>_teasingReels</code>, calls <code>reel.notifyAnticipationStart()</code>, emits <code>anticipation:reel</code> and then <code>spin:stopping</code>, and runs the <code>anticipation</code> phase with <code>_anticipationConfigFor(i)</code>. In cascade mode <code>curve</code> and <code>cells</code> are dropped with one warning and the speed multiplier is forced to 0. Afterwards the reel joins <code>_anticipatedReels</code> only if the tease was not cut short by a quicken. A reel that does not tease just emits <code>spin:stopping</code>. Details on the <a href="/architecture/anticipation/">anticipation page</a>.</li>
    <li><strong>Stop.</strong> Cascade: if the reel teased, <code>haltDrive()</code> and <code>snapToGrid()</code>; then <code>cascade:place</code> runs with <code>{'{ targetFrame, winnerCells: [], initial: true, delay: stopDelay }'}</code>, followed by <code>cascade:dropIn</code> with <code>{'{ initial: true }'}</code>. Standard: creates <code>stop</code> (with the quicken's speed profile if the press named one), calls <code>primeQuicken</code> first if the reel was quickened, then runs it with <code>{'{ targetFrame, delay: quickened ? 0 : stopDelay, preserveSpeed: didAnticipate && !quickened }'}</code>.</li>
    <li><code>_markLanded(i)</code>.</li>
  </ol>

  <h2>The generation counter</h2>
  <p>
    <code>_spinGeneration</code> is the abort switch for the whole round. It is incremented
    on every <code>spin()</code> and <code>refill()</code>, on a full slam, and on
    <code>destroy()</code> (which bumps it <em>before</em> force-completing phases so no
    chain starts a new tween during teardown). Each reel chain captures the generation
    when it starts and after every <code>await</code> calls
    <code>_isStale(reelIndex, generation)</code>, which is true if the generation moved on
    or if this reel is in <code>_slammedReels</code>. That second set exists because a
    partial slam must not bump the generation: doing so would strand the reels still
    running. The watchdog, the abort callbacks and <code>_runReelTask</code> check the
    generation too.
  </p>

  <h2>What setResult does, and the stop gate</h2>
  <p>
    <code>setResult(symbols)</code> does nothing if no spin is running. It validates
    big-symbol blocks against the pending MultiWays shape (one warning for misaligned wide
    blocks), stores <code>_resultSymbols</code> and calls <code>_tryBeginStopSequence()</code>.
    After that it fires any queued press (<code>_skipPending</code>) through
    <code>_pressSkip</code>, and if <code>_autoSlamRefills</code> is set from an earlier press
    in a cascade round, it presses a slam with no side effects. At the <code>ReelSet</code>
    level, <code>setResult</code> first asserts no nudge is in flight, validates the grid and
    overlays pins.
  </p>

  <Diagram width={780} height={560} caption="The stop gate. _tryBeginStopSequence() is called from three places and only opens when the result is present and every live reel is inside its spin phase. Even then each reel waits for its own minimum spin time, its group and its stop delay.">
    <Box x={20} y={20} w={220} h={54} title="setResult(symbols)" kind="primary" sub="your call" />
    <Box x={280} y={20} w={220} h={54} title="spin:allStarted" kind="accent" sub="the last reel to enter spin" />
    <Box x={540} y={20} w={220} h={54} title="partial slam" kind="accent" sub="_slamTargets, re-check" />
    <Box x={230} y={116} w={320} h={56} title="_tryBeginStopSequence()" kind="subtle" sub="the gate" />
    <Edge from={[130, 74]} via={[[130, 95], [330, 95]]} to={[330, 116]} />
    <Edge from={[390, 74]} to={[390, 116]} />
    <Edge from={[650, 74]} via={[[650, 95], [450, 95]]} to={[450, 116]} />

    <Box x={230} y={212} w={320} h={54} title="result set?" kind="subtle" sub="_resultSymbols is not null" />
    <Box x={230} y={302} w={320} h={54} title="every live reel in spin?" kind="subtle" sub="each non-held, non-landed reel's phase is 'spin'" />
    <Edge from={[390, 172]} to={[390, 212]} />
    <Edge from={[390, 266]} to={[390, 302]} label="yes" labelDx={22} />
    <Box x={590} y={232} w={170} h={94} title="closed" kind="ghost" sub={['return and wait', 'for the next trigger']} mono={false} />
    <Edge from={[550, 239]} to={[590, 266]} label="no" labelDy={-12} />
    <Edge from={[550, 329]} to={[590, 300]} label="no" labelDy={12} />

    <Box x={190} y={392} w={400} h={60} title="gate opens" kind="primary" mono={false} sub={['coordinate big symbols, build and cache one frame per reel', 'spinPhase.resolve() on every remaining reel']} />
    <Edge from={[390, 356]} to={[390, 392]} label="yes" labelDx={22} kind="primary" />

    <Box x={20} y={488} w={170} h={54} title="min spin time" kind="muted" sub={['per reel, counted from', 'its own spin entry']} />
    <Box x={206} y={488} w={170} h={54} title="group barrier" kind="muted" sub="earlier groups landed" />
    <Box x={392} y={488} w={170} h={54} title="tease" kind="ghost" sub={['offset + hold, only', 'if setAnticipation']} />
    <Box x={578} y={488} w={182} h={54} title="stop delay" kind="accent" sub="then spinOut, land, bounce" />
    <Edge from={[190, 452]} via={[[190, 470], [105, 470]]} to={[105, 488]} kind="primary" />
    <Edge from={[190, 515]} to={[206, 515]} />
    <Edge from={[376, 515]} to={[392, 515]} />
    <Edge from={[562, 515]} to={[578, 515]} />
  </Diagram>

  <p>
    Once the gate opens, <code>SpinPhase.resolve()</code> sets <code>_readyToStop</code>; the
    phase completes now if <code>_elapsed &gt;= _minTime</code>, otherwise on the first
    <code>update</code> where that becomes true. <code>_elapsed</code> adds up ticker deltas,
    not wall-clock time, so it pauses while the tab is hidden, and <code>Reel.update</code>
    caps <code>deltaMs</code> at <code>MAX_TICK_MS = 100</code>. Stop delays come from
    <code>_stopDelayFor</code>, in priority order: a named drop order
    (<code>setDropOrder('ltr'|'rtl'|'all', step)</code>), an explicit array
    (<code>setStopDelays</code>, entries past the end give 0), then
    <code>positionWithinGroup * stopDelay</code> if groups are set, else
    <code>_staggerIndex(i) * speed.stopDelay</code>. <code>ReelSet.setDropOrder</code>'s default
    step is <code>max(active.stopDelay, 150)</code>; its doc comment says otherwise, and the
    code is the source of truth here. See <a href="/architecture/timeline/">a spin in milliseconds</a>
    for what these rules produce.
  </p>

  <h2>Reel groups and held reels</h2>
  <ul>
    <li><code>setReelGroups(groups | null)</code>: every reel must appear exactly once or it throws; it also throws once any reel has landed in the round. Groups persist across spins. A stopping reel waits for every earlier group; a press releases the next group that has not landed. <code>onReelsAdded</code> appends new reels as one trailing group, <code>onReelsRemoved</code> filters them out.</li>
    <li><code>spin({'{ holdReels }'})</code>: held reels skip start, spin and stop entirely and keep their symbols. They count as landed, so <code>_finishSpin</code> runs when <code>landed.size === reels.length - held.size</code>. They never emit <code>spin:stopping</code> or <code>spin:reelLanded</code>, <code>setAnticipation</code> drops them silently, held columns in the result grid are ignored and their frames are built as <code>[]</code>. Big-symbol blocks may not cross from a held reel into a live one.</li>
    <li><code>spin({'{ mode }'})</code> overrides the builder default per spin. <code>_currentSpinMode</code> controls start versus fall, stop versus place + dropIn, the skip side effect and quicken-to-slam. <code>refill()</code> always runs in <code>'cascade'</code>.</li>
  </ul>

  <h2>The phases, step by step</h2>
  <p>
    Every phase is a <code>ReelPhase</code> that runs a named list of steps. A step marked
    <code>cut</code> is the only thing a quicken removes; a slam cancels the whole phase.
  </p>

  <Diagram width={930} height={360} caption="The built-in step lists. A quicken skips the badged steps and lets everything else play; a slam cancels the running step and lets onSkip set the final pose.">
    <Label x={20} y={70} text="start" mono size={12} tone="fg" weight={600} />
    <Box x={130} y={40} w={144} h={54} title="delay" badge="cut" sub={['step.duration ??', 'stagger * spinDelay']} size={12} />
    <Box x={286} y={40} w={144} h={54} title="launch" sub="reel.beginMotion()" size={12} />
    <Box x={442} y={40} w={144} h={54} title="pull" sub={['if bounceDistance > 0', 'speed -2 over 50 ms']} size={12} />
    <Box x={598} y={40} w={144} h={54} title="accelerate" sub={['to spinSpeed over', 'accelerationDuration']} size={12} />
    <Box x={754} y={40} w={144} h={54} title="announce" sub="notifySpinStart()" size={12} />
    {[0, 1, 2, 3].map((i) => (
      <Edge from={[274 + i * 156, 67]} to={[286 + i * 156, 67]} />
    ))}

    <Label x={20} y={150} text="spin" mono size={12} tone="fg" weight={600} />
    <Box x={130} y={120} w={456} h={54} title="wait" kind="muted" sub={['completes when resolve() was called by the stop gate AND elapsed >= minimumSpinTime', 'elapsed adds ticker deltas, so it pauses while the tab is hidden']} size={12} />
    <Label x={604} y={142} text={['not skippable by a slam: the controller', 'force-completes it from outside; a quicken', 'sets minimumSpinTime to 0']} size={10.5} />

