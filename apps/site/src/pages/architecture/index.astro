---
import Base from '../../layouts/Base.astro';
import { ARCH_PAGES, ARCH_SECTIONS } from '../../content/architectureNav.ts';
import { ArrowRight, Sparkles } from 'lucide-react';
import { SITE, articleLd, breadcrumbLd } from '../../lib/seo.ts';

const title = 'Architecture. how pixi-reels is put together';
const description = `A visual tour of the pixi-reels internals in ${ARCH_PAGES.length} pages: the builder, the ownership tree, the viewport and masks, symbols and pooling, motion and wrapping, the frame pipeline, curvature, the spin lifecycle and its timeline, skipping, anticipation, speed profiles, events, cascade physics, pins and boards, debug tooling and the test harness. Hand-laid SVG diagrams, no UML, no mermaid.`;

const blurbs: Record<(typeof ARCH_SECTIONS)[number], string> = {
  'Structure': 'What exists after build(), who owns it, and where it draws.',
  'Motion': 'How a strip of symbols moves, wraps, lands, and bends.',
  'A spin': 'One spin from spin() to spin:complete, phase by phase and millisecond by millisecond.',
  'Mechanics': 'The algorithms behind cascades, pins and boards.',
  'Tooling': 'How to see inside a canvas, and how to test without one.',
};
---
<Base
  title={`Architecture · ${SITE.name}`}
  description={description}
  path="/architecture/"
  jsonLd={[
    articleLd({ title, description, path: '/architecture/' }),
    breadcrumbLd([{ name: SITE.name, url: '/' }, { name: 'Architecture', url: '/architecture/' }]),
  ]}
>
  <section class="border-b border-border/60 py-20">
    <div class="container max-w-3xl text-center">
      <div class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary">
        <Sparkles size={12} strokeWidth={2.5} />
        Architecture
      </div>
      <h1 class="mt-4 text-balance text-4xl font-semibold tracking-tight sm:text-6xl">
        A tour, <span class="gradient-text">in pictures.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-muted-foreground">
        {ARCH_PAGES.length} pages, one per idea in the engine. Every diagram is
        hand-laid-out SVG drawn from the source, with the file it describes
        named beside it. No UML, no mermaid. Read in order, or jump to the
        page that answers your question.
      </p>
    </div>
  </section>

  <section class="py-14">
    <div class="container space-y-12">
      {ARCH_SECTIONS.map((section) => (
        <div>
          <div class="mb-5 flex items-baseline gap-3">
            <h2 class="text-xl font-semibold tracking-tight">{section}</h2>
            <p class="text-sm text-muted-foreground">{blurbs[section]}</p>
          </div>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {ARCH_PAGES.filter((p) => p.section === section).map((p) => (
              <a
                href={`/architecture/${p.slug}/`}
                class="group relative overflow-hidden rounded-2xl border border-border bg-card p-6 transition-all hover:border-primary/40 hover:-translate-y-0.5"
              >
                <div class="absolute top-4 right-4 font-mono text-[10px] text-muted-foreground/70">
                  {String(ARCH_PAGES.indexOf(p) + 1).padStart(2, '0')}
                </div>
                <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-primary">{p.eyebrow}</div>
                <h3 class="mt-2 text-xl font-semibold tracking-tight">{p.title}</h3>
                <p class="mt-2 text-sm text-muted-foreground">{p.subtitle}</p>
                <div class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-foreground/60 transition-colors group-hover:text-foreground">
                  Read <ArrowRight size={13} strokeWidth={2} />
                </div>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
