---
import Base from '../../layouts/Base.astro';
import { ARCH_PAGES, ARCH_SECTIONS } from '../../content/architectureNav.ts';
import { SITE, articleLd, breadcrumbLd } from '../../lib/seo.ts';

const title = 'Architecture. how pixi-reels is put together';
const description = `A visual tour of the pixi-reels internals in ${ARCH_PAGES.length} pages: the builder, the ownership tree, the viewport and masks, symbols and pooling, motion and wrapping, the frame pipeline, curvature, the spin lifecycle and its timeline, skipping, anticipation, speed profiles, events, cascade physics, pins and boards, debug tooling and the test harness. Hand-laid SVG diagrams, no UML, no mermaid.`;

const blurbs: Record<(typeof ARCH_SECTIONS)[number], string> = {
  'Structure': 'What you get back from build(), who owns what, and where things draw.',
  'Motion': 'How a column of symbols moves, wraps around, lands, and bends into a drum.',
  'A spin': 'One spin from the button press to the last bounce, phase by phase and millisecond by millisecond.',
  'Mechanics': 'The thinking behind cascades, sticky cells and boards.',
  'Tooling': 'How to see inside a canvas, and how to test a spin without one.',
};
---
<Base
  title={`Architecture · ${SITE.name}`}
  description={description}
  path="/architecture/"
  jsonLd={[
    articleLd({ title, description, path: '/architecture/' }),
    breadcrumbLd([{ name: SITE.name, url: '/' }, { name: 'Architecture', url: '/architecture/' }]),
  ]}
>
  <section class="border-b border-border/60 py-16 sm:py-20">
    <div class="container">
      <p class="eyebrow">Architecture</p>
      <h1 class="display mt-5 text-[clamp(2.75rem,6.5vw,5.5rem)] leading-[0.95]">
        A tour, in pictures.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">
        How pixi-reels works, told the way you would explain it to a new
        teammate: what the player sees, what the engine does about it, and
        then the names in the code. {ARCH_PAGES.length} pages, each with its
        own hand-drawn diagrams. Start with the overview, or jump to the
        question you came with.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="container space-y-16">
      {ARCH_SECTIONS.map((section, si) => (
        <div class="grid gap-6 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-10">
          <div>
            <p class="eyebrow">0{si + 1} / {section}</p>
            <p class="mt-3 max-w-xs text-sm leading-relaxed text-muted-foreground">{blurbs[section]}</p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {ARCH_PAGES.filter((p) => p.section === section).map((p) => (
              <a
                href={`/architecture/${p.slug}/`}
                class="group flex flex-col border border-border bg-card p-5 transition-colors duration-[217ms] hover:border-brand"
              >
                <div class="flex items-baseline justify-between gap-3 font-mono text-[11px] uppercase tracking-[0.18em]">
                  <span class="text-brand-text">{p.eyebrow}</span>
                  <span class="text-muted-foreground/70">{String(ARCH_PAGES.indexOf(p) + 1).padStart(2, '0')}</span>
                </div>
                <h3 class="mt-3 font-display text-xl font-bold tracking-tight">{p.title}</h3>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted-foreground">{p.subtitle}</p>
                <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-foreground">
                  Read
                  <svg class="h-4 w-4 transition-transform duration-[133ms] ease-[cubic-bezier(0.333,1.6,0.667,1)] group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
