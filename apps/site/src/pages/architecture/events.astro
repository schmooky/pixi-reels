---
import Architecture from '../../layouts/Architecture.astro';
import Diagram from '../../components/arch/Diagram.astro';
import Box from '../../components/arch/Box.astro';
import Edge from '../../components/arch/Edge.astro';
import Label from '../../components/arch/Label.astro';
import Legend from '../../components/arch/Legend.astro';

// Swimlane geometry for the landing-order diagram. Three vertical lanes,
// time flows down, one row per step.
const LANE_X = [36, 330, 624];
const LANE_W = 260;
const BW = 240;
const BH = 36;
const STEP = 46;
const row = (i: number) => 64 + i * STEP;
const bx = (lane: number) => LANE_X[lane] + (LANE_W - BW) / 2;
const mid = (i: number) => row(i) + BH / 2;
const H = row(15) + BH + 24;

type Row = [string, string, string, string];
const SET_EVENTS: [string, Row[]][] = [
  ['spin', [
    ['spin:start', '[]', 'A spin or a cascade refill begins. Each refill emits it again, so a refill counts as a new round.', 'spin/SpinController.ts spin(), refill()'],
    ['spin:allStarted', '[]', 'Every non-held reel has started.', 'SpinController.ts _announceAllStartedIfReady'],
    ['spin:stopping', '[reelIndex]', 'The controller has asked this reel to stop. Never fires for held reels.', 'SpinController.ts _startReel'],
    ['spin:reelLanding', '[reelIndex, symbols]', 'The reel is on its result frame, every visible symbol had onReelLanded(), the bounce has not started. Fires on every landing path and is not deduplicated per spin.', 'relay of Reel.ts notifyLanded via SpinController.attachReel'],
    ['spin:reelLanded', '[reelIndex, symbols]', 'The reel is fully at rest: one bounceDuration after spin:reelLanding on an animated stop, the same tick on a slam.', 'SpinController.ts _markLanded'],
    ['spin:allLanded', '[result: SpinResult]', 'The last reel is at rest.', 'SpinController.ts _finishSpin'],
    ['spin:complete', '[result: SpinResult]', 'Right after spin:allLanded, same function.', 'SpinController.ts _finishSpin'],
  ]],
  ['anticipation', [
    ['anticipation:reel', '[{ reelIndex, order, total }]', 'A reel started its tease, after any stagger offset. Only for reels in the anticipation set whose effective hold is above 0.', 'SpinController.ts _startReel'],
    ['anticipation:reelEnd', '[{ reelIndex }]', 'A teasing reel landed. Fires just before that reel\'s spin:reelLanded.', 'SpinController.ts _markLanded'],
    ['anticipation:segment', '[{ reelIndex, index, total, speed, targetSpeed }]', 'One leg of a curve tease began. speed is a multiple of spinSpeed, targetSpeed the same in px/frame. Curve teases only.', 'spin/phases/AnticipationPhase.ts'],
  ]],
  ['skip', [
    ['skip:requested', '[info: SkipInfo]', 'A press freed reels. reels excludes landed and held reels; partial is true if reels are still spinning afterwards; mode is slam or quicken.', 'SpinController.ts _quicken, _slamTargets'],
    ['skip:completed', '[info: SkipInfo]', 'The same press, once its reels are down: the same tick for a slam, when the last freed reel lands for a quicken.', 'SpinController.ts _slamTargets, _markLanded'],
    ['skip:queued', '[info: SkipContext]', 'requestSkip() arrived before the result. The press fires once the result arrives.', 'SpinController.ts requestSkip, carrySkip'],
    ['skip:boosted', '[{ previous, current }]', 'The first skip() of a standard-mode round switched to the fastest registered profile. Once per round; never for slamStop(), requestSkip() or cascade mode. The restore on the next spin() emits speed:changed instead.', 'SpinController.ts _applyRoundSideEffects'],
  ]],
  ['speed', [
    ['speed:changed', '[profile, previous]', 'setSpeed() switched profiles, including the round-end restore after a boost.', 'core/ReelSet.ts setSpeed'],
  ]],
  ['spotlight', [
    ['spotlight:start', '[positions: SymbolPosition[]]', 'spotlight.show() or cycle() began a highlight.', 'spotlight/SymbolSpotlight.ts'],
    ['spotlight:end', '[]', 'The spotlight was hidden. Only if it was active.', 'spotlight/SymbolSpotlight.ts'],
  ]],
  ['win', [
    ['win:start', '[wins: readonly Win[]]', 'Once per show(), with the wins in display order (value descending by default).', 'wins/WinPresenter.ts'],
    ['win:group', '[win, cells]', 'One win is now being presented, before its win:symbol events. Draw lines and outlines here.', 'wins/WinPresenter.ts'],
    ['win:symbol', '[symbol, cell, win]', 'One event per cell per win per cycle, spaced by stagger. symbol is typed unknown.', 'wins/WinPresenter.ts'],
    ['win:end', "[reason: 'complete' | 'aborted']", 'The presentation finished or abort() was called. Loser alpha is restored first.', 'wins/WinPresenter.ts'],
  ]],
  ['pin', [
    ['pin:placed', '[pin: CellPin]', 'pin() registered a claim on a cell.', 'core/ReelSet.ts pin'],
    ['pin:moved', '[pin, from: { reel, cell }]', 'movePin() finished, or setColumn()/splitSymbol() shifted a pin with its symbol.', 'ReelSet.ts movePin, _setColumn'],
    ['pin:expired', "[pin, reason: 'turns' | 'explicit' | 'eval' | 'collision']", 'A pin was removed: turns ran out, unpin() or a geometry change, an eval pin at spin:start, or a migration collision.', 'ReelSet.ts unpin, _migratePinsForReel, _onSpinLanded, _onSpinStart'],
    ['pin:migrated', '[pin, { fromCell, toCell, clamped, reelIndex }]', 'A MultiWays reshape moved the pin.', 'ReelSet.ts _migratePinsForReel'],
    ['pin:overlayCreated', '[pin, overlay]', 'A pooled overlay symbol was created for a pin while the reels move.', 'ReelSet.ts _ensurePinOverlay'],
    ['pin:overlayDestroyed', '[pin, overlay]', 'The overlay goes back to the pool: on spin:allLanded, unpin or replacement.', 'ReelSet.ts'],
  ]],
  ['shape and adjust (MultiWays only)', [
    ['shape:changed', '[cellsPerReel: number[]]', 'setShape() recorded a target shape, before any geometry change.', 'ReelSet.ts setShape'],
    ['adjust:start', '[{ reelIndex, fromCells, toCells }]', 'The AdjustPhase began reshaping this reel.', 'SpinController.ts _applyReshape'],
    ['adjust:complete', '[{ reelIndex }]', 'The reshape finished.', 'SpinController.ts _applyReshape'],
  ]],
  ['reels, rows, column', [
    ['reels:added', '[{ from, count }]', 'addReels() or an expand step. The reels are already in reelSet.reels and the mask covers them.', 'ReelSet.ts _addReels'],
    ['reels:removed', '[{ from, count }]', 'removeReels() finished. The reels are already destroyed.', 'ReelSet.ts removeReels'],
    ['rows:added', '[{ count, rows: number[] }]', 'addRows() finished.', 'ReelSet.ts addRows'],
    ['rows:removed', '[{ count, rows: number[] }]', 'removeRows() finished.', 'ReelSet.ts removeRows'],
    ['column:set', '[{ reelIndex, fromCells, toCells }]', 'setColumn(), splitSymbol() or resetColumns() changed one reel at rest.', 'ReelSet.ts _setColumn'],
  ]],
  ['expand', [
    ['expand:start', '[{ from, to, steps }]', 'expand() validated its input and is about to add the first step.', 'ReelSet.ts expand'],
    ['expand:stepAdded', '[step: ExpandStep]', 'A step\'s reels exist; fires before the onStepAdded hook.', 'ReelSet.ts expand'],
    ['expand:stepLanded', '[step: ExpandStepLanded]', 'The step\'s spin landed; fires before onStepLanded.', 'ReelSet.ts expand'],
    ['expand:complete', '[result: ExpandResult]', 'Every step landed.', 'ReelSet.ts expand'],
    ['expand:end', "[reason: 'complete' | 'failed']", 'Always fires, so it is the one place to restore UI.', 'ReelSet.ts expand'],
  ]],
  ['cascade (tumble)', [
    ['cascade:fall:start', '[{ reelIndex }]', 'Once per reel per spin(). Never on refill().', 'spin/phases/CascadeFallPhase.ts'],
    ['cascade:fall:symbol', '[{ symbol, view, reelIndex, cellIndex, duration, ease, distance, signal }]', 'Right before each symbol\'s fall tween. signal aborts on skip or slam.', 'CascadeFallPhase.ts'],
    ['cascade:fall:end', '[{ reelIndex }]', 'Every view is at alpha 0. Only fires if :start fired.', 'CascadeFallPhase.ts'],
    ['cascade:place:end', '[{ reelIndex, placedSymbols, isInitial, winnerCells }]', 'New ids are snapped to the grid, before the drop-in. Attach badges here. No :start counterpart.', 'CascadePlacePhase.ts'],
    ['cascade:dropIn:start', '[{ reelIndex }]', 'The drop-in timeline for this reel began.', 'CascadeDropInPhase.ts'],
    ['cascade:dropIn:symbol', '[{ symbol, view, reelIndex, cellIndex, duration, ease, offsetCells, signal }]', 'Right before each mover\'s tween.', 'CascadeDropInPhase.ts'],
    ['cascade:dropIn:end', '[{ reelIndex }]', 'Every mover is in place; movers get notifyLanded.', 'CascadeDropInPhase.ts'],
    ['cascade:gravity:start', '[{ reelIndex }]', "Stage 1 of a 'gravity-then-drop' refill began. Only in that mode.", 'CascadeDropInPhase.ts (role gravity)'],
    ['cascade:gravity:symbol', '[same as dropIn:symbol]', 'Before each survivor\'s gravity tween.', 'CascadeDropInPhase.ts'],
    ['cascade:gravity:end', '[{ reelIndex }]', 'Survivors settled; the gravityHoldMs hold starts after the slowest reel.', 'CascadeDropInPhase.ts'],
    ['cascade:gravity:error', '[{ error }]', 'A user gate rejected or threw. The engine logs refill-threw and slams.', 'SpinController.ts refill'],
    ['cascade:chain:start', '[{ chain, winners, currentGrid }]', 'runCascade found winners (chain is 1-based), before destroy.', 'ReelSet.ts runCascade'],
    ['cascade:chain:end', '[{ chain, winners, nextGrid }]', 'The refill for this stage landed.', 'ReelSet.ts runCascade'],
    ['cascade:destroy:start', '[{ cells }]', 'destroySymbols() is about to play playDestroy(). Not emitted for an empty list.', 'ReelSet.ts destroySymbols'],
    ['cascade:destroy:end', '[{ cells, failed? }]', 'All playDestroy() promises settled; failed lists the rejected cells.', 'ReelSet.ts destroySymbols'],
  ]],
  ['nudge', [
    ['nudge:start', "[{ reelIndex, distance, direction: 'forward' | 'reverse' }]", 'After pre-placement, so the state it shows is the one about to animate.', 'ReelSet.ts nudge'],
    ['nudge:complete', '[{ ...start, symbols }]', 'The strip is at its new position; symbols is the new visible column.', 'ReelSet.ts nudge'],
    ['nudge:cancelled', '[{ ...start, reason }]', 'The signal aborted. The strip is snapped to its post-nudge position and the promise rejects with AbortError. nudge:complete does not fire.', 'ReelSet.ts nudge'],
  ]],
  ['lifecycle', [
    ['destroyed', '[]', 'destroy() ran.', 'ReelSet.ts destroy'],
  ]],
];

const REEL_EVENTS: Row[] = [
  ['phase:enter', '[phaseName]', 'A phase started on this reel. Reel.nudge emits it with the name nudge.', 'spin/phases/ReelPhase.ts run, core/Reel.ts nudge'],
  ['phase:exit', '[phaseName]', 'The phase ended.', 'ReelPhase.ts run, Reel.ts nudge'],
  ['phase:step', '[{ phase, step, status }]', "status is 'start' | 'end' | 'skipped' | 'cut' | 'cancelled'. skipped: a cut step a quicken never started; cut: stopped mid-flight by a quicken; cancelled: stopped by a slam or destroy.", 'ReelPhase.ts runSteps'],
  ['symbol:created', '[symbolId, stripIndex]', 'A cell took a different symbol (a wrap, a placement, a swap).', 'Reel.ts _replaceSymbol'],
  ['landing', '[symbols]', 'The per-reel source of spin:reelLanding.', 'Reel.ts notifyLanded'],
  ['landed', '[symbols]', 'Fully at rest, right before the set\'s spin:reelLanded.', 'SpinController.ts _markLanded'],
  ['destroyed', '[]', 'The reel was destroyed.', 'Reel.ts destroy'],
];

const API: [string, string][] = [
  ['on(event, fn, context?)', 'Add a listener. Chainable.'],
  ['once(event, fn, context?)', 'Add a listener that is removed before its first call.'],
  ['off(event, fn?, context?)', 'No fn: remove every listener for the event. fn only: remove every entry with that function, whatever its context. Both: remove only the matching pair.'],
  ['onAny(fn(event, ...args)) / offAny(fn)', 'Wildcard listeners for tracing and recording. They run after the event\'s own listeners.'],
  ['emit(event, ...args): boolean', 'Dispatch. Returns false only when there are no specific listeners and no any-listeners.'],
  ['removeAllListeners(event?)', 'With no argument it also clears the onAny hooks. With an event it leaves them alone.'],
  ['listenerCount(event)', 'Specific listeners only; any-listeners are not counted.'],
];

const th = 'text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground';
---
<Architecture
  title="Events"
  subtitle="What fires when, in what order, on which bus."
  eyebrow="Flow"
>
  <p>
    Every event pixi-reels emits is typed and travels on one of three buses.
    The headline stream is <code>reelSet.events</code>. Each <code>Reel</code>
    has its own smaller bus, useful when you only care about one column, and
    a Hold &amp; Win board has a third bus of its own. The emitter is a
    zero-dependency class in <code>packages/pixi-reels/src/events/EventEmitter.ts</code>;
    the event maps live in <code>events/ReelEvents.ts</code> and
    <code>board/HwTypes.ts</code>.
  </p>

  <h2>One spin, in landing order</h2>

  <p>
    Read top to bottom. The Caller lane is you, the middle lane is
    <code>reelSet.events</code>, the right lane is one reel's
    <code>reel.events</code>. The dashed window is the part that repeats for
    every reel, in stop order, and again on every cascade stage.
  </p>

  <Diagram width={900} height={H} caption="The landing order of one spin. spin:reelLanding fires on the result frame before the bounce; spin:reelLanded fires after it. Held reels skip the whole window.">
    {LANE_X.map((x, i) => (
      <>
        <rect x={x} y={48} width={LANE_W} height={H - 60} rx="12" class="lane-bg" />
        <line x1={x + LANE_W / 2} y1={56} x2={x + LANE_W / 2} y2={H - 20} class="guide-strong" style="stroke-dasharray: 2 5" />
        <Label x={x + LANE_W / 2} y={36} text={['Caller', 'reelSet.events', 'reel.events'][i]} anchor="middle" mono tone="fg" weight={600} size={12} />
      </>
    ))}
    <Edge from={[16, 60]} to={[16, H - 20]} />
    <Label x={10} y={H / 2} text="time" size={10} anchor="middle" rotate={-90} />

    <rect x={LANE_X[0] - 8} y={row(8) - 8} width={LANE_X[2] + LANE_W + 8 - (LANE_X[0] - 8)} height={row(13) + BH + 8 - (row(8) - 8)} rx="12" class="guide-strong" style="stroke-dasharray: 4 3" />
    <Label x={bx(0) + 8} y={row(9) + 12} size={10.5} text={['per reel, in stop order', 'spin:reelLanding = before the bounce', 'spin:reelLanded = after the bounce', '(same tick on a slam)', 'repeats on every cascade stage', 'held reels: none of these']} />

    <Box x={bx(0)} y={row(0)} w={BW} h={BH} title="spin()" kind="ghost" size={12} sub="returns the spin promise" />
    <Box x={bx(1)} y={row(1)} w={BW} h={BH} title="spin:start" kind="primary" size={12} sub="also on every refill()" />
    <Box x={bx(2)} y={row(2)} w={BW} h={BH} title="phase:enter 'start'" kind="accent" size={12} />
    <Box x={bx(2)} y={row(3)} w={BW} h={BH} title="phase:exit 'start'" kind="accent" size={12} sub="then phase:enter 'spin'" />
    <Box x={bx(0)} y={row(3)} w={BW} h={BH} title="skip() · slamStop()" kind="ghost" size={12} sub="any time after spin:start" />
    <Box x={bx(1)} y={row(4)} w={BW} h={BH} title="spin:allStarted" kind="primary" size={12} sub="every non-held reel started" />
    <Box x={bx(2)} y={row(5)} w={BW} h={BH} title="symbol:created" kind="accent" size={12} sub="many: one per wrap (id, stripIndex)" />
    <Box x={bx(0)} y={row(6)} w={BW} h={BH} title="setResult(grid)" kind="ghost" size={12} sub="and setAnticipation([...])" />
    <Box x={bx(1)} y={row(7)} w={BW} h={BH} title="anticipation:reel" kind="primary" size={12} sub="{ reelIndex, order, total }" />
    <Box x={bx(2)} y={row(7)} w={BW} h={BH} title="phase:exit 'spin'" kind="accent" size={12} sub="then phase:enter 'anticipation'" />
    <Box x={bx(1)} y={row(8)} w={BW} h={BH} title="spin:stopping" kind="primary" size={12} sub="[reelIndex]" />
    <Box x={bx(2)} y={row(9)} w={BW} h={BH} title="phase:enter 'stop'" kind="accent" size={12} />
    <Box x={bx(2)} y={row(10)} w={BW} h={BH} title="phase:step" kind="accent" size={12} sub="delay · spinOut · land · bounce" />
    <Box x={bx(2)} y={row(11)} w={BW} h={BH} title="landing" kind="accent" size={12} sub="on the result frame" />
    <Box x={bx(1)} y={row(11)} w={BW} h={BH} title="spin:reelLanding" kind="primary" size={12} sub="[reelIndex, symbols]" />
    <Box x={bx(1)} y={row(12)} w={BW} h={BH} title="anticipation:reelEnd" kind="primary" size={12} sub="teasing reels only" />
    <Box x={bx(2)} y={row(13)} w={BW} h={BH} title="phase:exit 'stop'" kind="accent" size={12} sub="then landed" />
    <Box x={bx(1)} y={row(13)} w={BW} h={BH} title="spin:reelLanded" kind="primary" size={12} sub="[reelIndex, symbols]" />
    <Box x={bx(1)} y={row(14)} w={BW} h={BH} title="spin:allLanded" kind="primary" size={12} sub="[result: SpinResult]" />
    <Box x={bx(1)} y={row(15)} w={BW} h={BH} title="spin:complete" kind="primary" size={12} sub="right after allLanded" />

    <Edge from={[bx(0) + BW, mid(0)]} via={[[bx(1) - 14, mid(0)], [bx(1) - 14, mid(1)]]} to={[bx(1), mid(1)]} />
    <Edge from={[bx(1) + BW, mid(1)]} via={[[bx(2) - 14, mid(1)], [bx(2) - 14, mid(2)]]} to={[bx(2), mid(2)]} />
    <Edge from={[bx(0) + BW, mid(6)]} via={[[bx(1) - 14, mid(6)], [bx(1) - 14, mid(7)]]} to={[bx(1), mid(7)]} label="gates the stop" labelDx={0} labelDy={-16} />
    <Edge from={[bx(2), mid(11)]} to={[bx(1) + BW, mid(11)]} kind="primary" label="attachReel relay" labelDy={-20} />
    <Edge from={[bx(2), mid(13)]} to={[bx(1) + BW, mid(13)]} style="dashed" />
  </Diagram>

  <div class="not-prose my-8">
    <Legend items={[
      { kind: 'primary', label: 'reelSet.events', note: 'ReelSetEvents, 59 names' },
      { kind: 'accent', label: 'reel.events', note: 'ReelEvents, 7 names per reel' },
      { kind: 'muted', label: 'Caller', note: 'spin, setResult, setAnticipation, skip' },
    ]} />
  </div>

  <h2>Three buses</h2>

  <Diagram width={900} height={230} caption="The per-reel bus feeds the set bus in exactly one place: SpinController.attachReel() re-emits each reel's landing as spin:reelLanding with the reel index added.">
    <Box x={30} y={50} w={260} h={120} title="ReelSetEvents" kind="primary" sub={['reelSet.events', '59 events, 13 prefixes', 'spin · anticipation · skip · speed', 'spotlight · win · pin · shape · adjust', 'reels · rows · column · expand · cascade · nudge']} size={13} />
    <Box x={340} y={50} w={220} h={120} title="ReelEvents" kind="accent" sub={['reel.events, one per reel', '7 events', 'phase:enter · phase:exit · phase:step', 'symbol:created · landing', 'landed · destroyed']} />
    <Box x={610} y={50} w={260} h={120} title="HoldAndWinBoardEvents" kind="subtle" sub={['board.events, its own emitter', '13 events, one object payload', 'feature:* · respin:* · cell:landed', 'coin:locked · coin:released · board:full', 'not relayed to any ReelSet']} />
    <Edge from={[340, 92]} to={[290, 92]} kind="primary" label="landing → spin:reelLanding" labelDy={-22} labelDx={-10} />
    <Edge from={[340, 132]} to={[290, 132]} label="landed → spin:reelLanded" labelDy={22} labelDx={-10} />
    <Label x={450} y={205} text="a BoardGrid cell is a 1x1 ReelSet, so each cell also has the two buses on the left" anchor="middle" size={10.5} />
  </Diagram>

  <h2>Every ReelSet event</h2>

  <p>
    Grouped by prefix. The payload column is the tuple the listener receives.
    Paths are under <code>packages/pixi-reels/src/</code>.
  </p>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60">
          <tr>
            <th class={th}>Event</th>
            <th class={th}>Payload</th>
            <th class={th}>Fires when</th>
            <th class={th}>Emitted from</th>
          </tr>
        </thead>
        <tbody>
          {SET_EVENTS.map(([group, rows]) => (
            <>
              <tr class="border-t border-border/60 bg-muted/30">
                <td colspan="4" class="px-4 py-1.5 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">{group} · {rows.length}</td>
              </tr>
              {rows.map(([name, payload, when, from]) => (
                <tr class="border-t border-border/60 align-top">
                  <td class="px-4 py-2 font-mono text-primary text-xs whitespace-nowrap">{name}</td>
                  <td class="px-4 py-2 font-mono text-xs text-muted-foreground">{payload}</td>
                  <td class="px-4 py-2 text-xs text-foreground/80">{when}</td>
                  <td class="px-4 py-2 font-mono text-[11px] text-muted-foreground">{from}</td>
                </tr>
              ))}
            </>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <h2>Per-reel events</h2>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60">
          <tr>
            <th class={th}>Event</th>
            <th class={th}>Payload</th>
            <th class={th}>Fires when</th>
            <th class={th}>Emitted from</th>
          </tr>
        </thead>
        <tbody>
          {REEL_EVENTS.map(([name, payload, when, from]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs whitespace-nowrap">{name}</td>
              <td class="px-4 py-2 font-mono text-xs text-muted-foreground">{payload}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{when}</td>
              <td class="px-4 py-2 font-mono text-[11px] text-muted-foreground">{from}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <h2>Hold &amp; Win board events</h2>

  <p>
    <code>HoldAndWinBoard.events</code> is a separate <code>EventEmitter</code>
    whose map is <code>HoldAndWinBoardEvents</code> in <code>board/HwTypes.ts</code>.
    Each event carries a single object. <code>respin:start</code> and
    <code>feature:skip</code> are emitted by the driver itself; every other
    event is a reducer effect replayed as a <code>{'{ type, payload }'}</code> pair.
  </p>

  <ul>
    <li><code>feature:enter {'{ seed, respins }'}</code>, <code>feature:skip {'{ inFlight, mode, speed?, payload? }'}</code>, <code>feature:reset {'{ clearedCoins }'}</code>, <code>feature:end {'{ coins, rounds, full }'}</code></li>
    <li><code>respin:start {'{ round, respinsLeft, spinning }'}</code>, <code>respin:end {'{ round, hits, respinsLeft }'}</code>, <code>respins:changed {'{ value, reason }'}</code></li>
    <li><code>cell:landed {'{ cell, coin | null }'}</code> in stagger order, <code>coin:locked {'{ coin, locked, capacity }'}</code>, <code>coin:released {'{ coin, remaining }'}</code></li>
    <li><code>board:full {'{ coins }'}</code>, <code>cells:activated {'{ cells, capacity }'}</code>, <code>speed:changed {'{ name, previous }'}</code> (names as strings)</li>
  </ul>

  <p>The state machine behind them is on the <a href="/architecture/pins-and-boards/">pins and boards page</a>.</p>

  <h2>The emitter</h2>

  <p>
    <code>EventEmitter&lt;TEvents extends Record&lt;string, unknown[]&gt;&gt;</code>
    maps each event name to a labelled tuple of argument types. Storage is a
    <code>Map</code> from name to <code>{'{ fn, context, once }'}</code> entries,
    plus one array of any-listeners. Everything except <code>emit</code> and
    <code>listenerCount</code> returns <code>this</code>.
  </p>

  <div class="not-prose my-6">
    <div class="rounded-xl border border-border bg-card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-muted/60">
          <tr><th class={th}>Method</th><th class={th}>Behaviour</th></tr>
        </thead>
        <tbody>
          {API.map(([sig, what]) => (
            <tr class="border-t border-border/60 align-top">
              <td class="px-4 py-2 font-mono text-primary text-xs whitespace-nowrap">{sig}</td>
              <td class="px-4 py-2 text-xs text-foreground/80">{what}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <h3>Dispatch semantics</h3>

  <ul>
    <li><strong>Snapshot.</strong> Both the listener array and the any-listener array are copied before dispatch. A listener added or removed during an emit does not change who receives that emit.</li>
    <li><strong>once by identity.</strong> A <code>once</code> entry is removed by entry identity before it is called, so a separate persistent <code>on()</code> registration of the same function survives.</li>
    <li><strong>Context.</strong> Listeners are called with <code>fn.apply(entry.context, args)</code>.</li>
    <li><strong>onAny last.</strong> Wildcard listeners run after the event's own listeners, with the event name as the first argument.</li>
    <li><strong>No error isolation.</strong> There is no try/catch in <code>emit</code>. A listener that throws stops the loop: later listeners and the any-listeners do not run for that emit, and the error propagates into whatever engine code called <code>emit</code>. Wrap risky listeners yourself.</li>
  </ul>

  <p>
    A typing caveat, from reading the types rather than from a comment: both
    event maps <code>extend Record&lt;string, unknown[]&gt;</code>, which adds a
    string index signature. A misspelled event name therefore probably still
    type-checks, with <code>unknown[]</code> arguments. Only the declared names
    get precise argument types. ADR 002 says typos are compile errors; the
    code is the source of truth here.
  </p>

  <p>
    Why <code>reelSet.events.on(...)</code> and not <code>reelSet.on(...)</code>:
    ADR 002 keeps the engine's events off the Container's own
    <code>on</code>/<code>off</code>/<code>emit</code> so they can never clash
    with PixiJS pointer events. The cost is the extra <code>.events.</code> hop.
  </p>

  <h2>Gotchas</h2>

  <ul>
    <li><code>spin:reelLanding</code> is not deduplicated. It fires on the animated stop, on a slam, and on every cascade refill stage. Count it per stage, not per spin.</li>
    <li>Held reels (<code>spin({'{ holdReels }'})</code>) emit no <code>spin:stopping</code> and no <code>spin:reelLanded</code>, yet count as landed and contribute their unchanged cells to <code>SpinResult.symbols</code>.</li>
    <li><code>skip:boosted</code> never fires in cascade mode, nor from <code>slamStop()</code> or <code>requestSkip()</code>. The speed restore at the next <code>spin()</code> only emits <code>speed:changed</code>.</li>
    <li><code>cascade:gravity:*</code> only fires under <code>mode: 'gravity-then-drop'</code>. <code>cascade:fall:*</code> never fires on <code>refill()</code>.</li>
    <li><code>nudge:cancelled</code> and <code>nudge:complete</code> are mutually exclusive. On cancel the strip still lands deterministically.</li>
    <li>The <code>signal</code> on every <code>cascade:*:symbol</code> payload aborts on a slam, always before the paired <code>:end</code>. Clean up parallel tweens there.</li>
    <li><code>pin:migrated</code>, <code>shape:changed</code> and <code>adjust:*</code> fire on MultiWays sets only.</li>
    <li><code>removeAllListeners()</code> with no argument also removes the <code>onAny</code> hooks, which is what <code>enableDebug().trace()</code> and <code>SpinMetrics</code> rely on.</li>
  </ul>

  <h2>Two interaction patterns</h2>

  <p>
    Wiring these events together gets you every major slot UX without
    custom state tracking:
  </p>

  <div class="not-prose my-6 grid gap-4 md:grid-cols-2">
    <div class="rounded-xl border border-border bg-card p-5">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-2">Pattern: Skip button</div>
      <p class="text-sm text-muted-foreground mb-3">
        Use <code>isSpinning</code> to branch the same button between "start" and "skip".
      </p>
      <pre class="text-[11px] !my-0"><code>{`button.addEventListener('click', () => {
  if (reelSet.isSpinning) reelSet.skip();
  else                    reelSet.spin();
});`}</code></pre>
    </div>

    <div class="rounded-xl border border-border bg-card p-5">
      <div class="text-[11px] font-mono uppercase tracking-wider text-primary mb-2">Pattern: Fetch + stop</div>
      <p class="text-sm text-muted-foreground mb-3">
        Real slots fetch the server answer while the reels are spinning, then call setResult() to release the stop.
      </p>
      <pre class="text-[11px] !my-0"><code>{`const p = reelSet.spin();
const r = await fetch('/spin').then(x => x.json());
reelSet.setAnticipation(r.anticipationReels);
reelSet.setResult(r.symbols);
await p;`}</code></pre>
    </div>
  </div>

  <h2>Listening on a single reel</h2>

  <p>
    Each <code>Reel</code> has its own typed emitter. Useful when only one
    column's state matters, for example a sticky wild tracker that needs to
    know exactly when reel 2 landed:
  </p>

  <pre><code>{`reelSet.getReel(2).events.on('landed', (symbols) => {
  if (symbols.includes('wild')) stickyWilds.push({ reel: 2, ... });
});`}</code></pre>

