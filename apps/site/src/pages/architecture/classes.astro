---
import Architecture from '../../layouts/Architecture.astro';
import Diagram from '../../components/arch/Diagram.astro';
import Box from '../../components/arch/Box.astro';
import Edge from '../../components/arch/Edge.astro';
import Group from '../../components/arch/Group.astro';
import Legend from '../../components/arch/Legend.astro';
import Callout from '../../components/arch/Callout.astro';

// ReelSet.destroy() in source order (core/ReelSet.ts:3702-3721).
const TEARDOWN: [string, string][] = [
  ['_spotlight.destroy()', 'spotlight tweens and overlay containers go first'],
  ['_spinController.destroy()', 'its TickerRef removes every ticker callback it added'],
  ['reel.destroy() for each reel', 'motion, sequencer, symbols and the reel container'],
  ['_destroyAllPinOverlays()', 'pin:overlayDestroyed per overlay, then each is released to the pool'],
  ['_symbolFactory.destroy()', 'the ObjectPool disposes every idle symbol'],
  ['_viewport.destroy()', 'promotedLayer.detachAll() first, then super.destroy({ children: true })'],
  ['_pins.clear()', 'the pin map is emptied; no events'],
  ["_events.emit('destroyed')", 'expand() listens for this to drop its abort listener'],
  ['_events.removeAllListeners()', 'the bus is gone after this line'],
  ['super.destroy({ children: true })', 'the PixiJS Container teardown'],
];
const TB_X = 60;
const TB_W = 600;
const TB_H = 60;
const TB_PITCH = 80;
const TB_Y0 = 20;

const CARDS: [string, string, string][] = [
  ['ReelSetBuilder', 'builder', 'A fluent, chainable configurator. You call .reels(5).visibleCells(3)... and end with .build(). Every required piece of setup is forced into one place: forget .ticker(app.ticker) and build() throws before the game boots. The builder page walks build() step by step.'],
  ['ReelSet', 'scene graph root', 'The thing you app.stage.addChild(reelSet). A PixiJS Container that owns every reel, the spin controller, the speed manager, the win spotlight and the symbol pool. The public verbs live here: spin(), setResult(), setAnticipation(), skipSpin(), destroy(). Its only display child is the ReelViewport.'],
  ['Reel', 'one strip', 'One strip of symbols, longer than the window by the buffer cells on each end. It spins along whichever axis the set uses (vertical or horizontal, forward or reverse). A Reel owns its symbols, its container, its motion, its stop queue and its own event bus. You rarely touch one directly; you drive the ReelSet and let it fan out.'],
  ['ReelViewport', 'clip and layers', 'The window you look through. Holds one mask Graphics for the whole masked container, plus the layers above the mask (unmasked, dim, spotlight, promoted) that presentation uses to break out of it. The viewport page has the five layers.'],
  ['ReelAxis', 'orientation', 'The small object that turns main-axis and cross-axis numbers into screen x and y. reelAxis(orientation, direction) gives each reel its own, so a horizontal or reversed reel runs through exactly the same motion code.'],
  ['ReelMotion', 'the physics', 'Moves the strip every tick and derives each symbol position from its array index. When a symbol passes the far edge it rotates the array and tells the reel a wrap happened. That callback is where a spinning reel takes on its next identity.'],
  ['StopSequencer', 'landing queue', 'A queue holding the symbols a reel must land on, in order. The stop phase loads one frame into it; every wrap pops the next id. A forward reel consumes the frame end-first, a reverse reel head-first. When the queue is empty the reel stops.'],
  ['SpinController', 'conductor', 'Runs each reel through start, spin, optional anticipation and stop, gates stopping on setResult(), turns presses into slams or quickens, fires the spin:* events and resolves the promise you awaited. It owns the one TickerRef in the engine and the active phase per reel. It draws nothing.'],
  ['ReelPhase', 'state', 'Abstract base for one stage of a reel spin. Stock phases: StartPhase, SpinPhase, AnticipationPhase, StopPhase, AdjustPhase (MultiWays) and the three cascade phases (CascadeFallPhase, CascadePlacePhase, CascadeDropInPhase). The PhaseFactory maps a phase key to a constructor.'],
  ['SpinningMode', 'strategy', 'What a spin means. StandardMode runs every reel through the phase machine. CascadeMode handles tumble refills. ImmediateMode snaps straight to the result, which tests use. The builder default is new StandardMode().'],
  ['SpeedManager', 'tempo', 'Named bundles of timings. Ships with SpeedPresets.NORMAL and friends; switch at runtime with reelSet.setSpeed(name), which emits speed:changed. Constructed by the ReelSet from the builder speeds map.'],
  ['ReelSymbol', 'abstract cell', 'One visible cell. Subclass it to draw anything. Built-ins: SpriteSymbol, AnimatedSpriteSymbol, SpineSymbol, CardSymbol, EmptySymbol. Implement onActivate, onDeactivate, playWin, stopAnimation and resize for a new kind. The symbols page has the lifecycle.'],
  ['SymbolRegistry / SymbolFactory', 'pool', 'SymbolRegistry records which class and options render which id. SymbolFactory sits on top with an ObjectPool keyed by id, so scrolling a 5x3 set for five seconds allocates no new symbol objects once the pool is warm.'],
  ['FrameBuilder + middleware', 'pipeline', 'Decides which id fills each slot of a target strip. random-fill is priority 0, target-placement is priority 10, and your own middleware slots in by priority. It runs once per result, not on every wrap.'],
  ['SymbolSpotlight', 'wins', 'The win primitive. show(positions) dims the losers and runs playWin() on the winners in the spotlight layer; cycle(winLines) steps through lines and emits spotlight:start and spotlight:end.'],
  ['EventEmitter', 'pub / sub', 'Typed, colon-namespaced events on two buses: reelSet.events (ReelSetEvents) and reel.events (ReelEvents). The ReelSet uses its own emitter so it never collides with the Container events PixiJS itself emits.'],
  ['TickerRef', 'safe ticker', 'A wrapper around PIXI.Ticker that remembers every callback it adds and removes them all on destroy(). Nobody in the engine calls ticker.add() directly.'],
  ['Disposable', 'interface', 'The cleanup contract: destroy() plus a readonly isDestroyed. Anything that subscribes to a ticker, creates display objects or holds references implements it, and reelSet.destroy() cascades through the whole tree.'],
  ['FakeTicker + HeadlessSymbol', 'tests', 'The headless harness from pixi-reels/testing: a ticker you step by hand and a symbol that draws nothing. A full spin runs in Node without a renderer. See the testing page.'],
];
---
<Architecture
  title="Classes"
  subtitle="The ownership tree. Who owns what, who destroys what."
  eyebrow="Objects"
>
  <p>
    A reel set is a lot of objects. Five reels of a few symbols each means
    dozens of containers and sprites, plus the tweens that bounce them, the
    ticker callbacks that move them every frame, the pooled symbols waiting
    off screen, and the listeners your game attached. Slot games tear this
    down and build it again all the time: a bonus round opens, a free-spins
    board replaces the base board, the player switches games. If one ticker
    callback survives that teardown it will run on a reel that no longer
    exists and throw on the next frame; if one tween survives, it will animate
    a destroyed sprite. The library's own source calls dangling ticker
    callbacks the number one memory leak in the original engine.
  </p>

  <p>
    The answer is strict ownership. Every object in pixi-reels has exactly
    one parent, the parent is responsible for destroying it, and one call at
    the top, <code>reelSet.destroy()</code>, cascades down the whole tree in
    a fixed order. This page is that tree: who constructs what, who owns
    what, and in what order it all comes apart.
  </p>

  <Callout kind="plain">
    There is no garbage collector hiding inside the engine. Each class
    destroys the things it made, and nothing else. If you can draw the
    ownership tree, you know exactly what one <code>destroy()</code> frees.
  </Callout>

  <h2>Three layers</h2>

  <p>
    It helps to sort the classes into three layers before looking at the
    tree. The <strong>outer shell</strong> is what you build: the builder and
    the set it returns. The <strong>scene graph</strong> is what PixiJS
    renders: the viewport, the reel containers and the symbols inside them.
    The <strong>internals</strong> are the objects that exist for the duration
    of a spin and do the timing, the counting and the choosing; none of them
    draws anything. Ownership reads top to bottom through all three, and the
    parent always destroys its children.
  </p>

  <p>
    Construction is split between two places, and it is worth knowing which
    is which. The builder constructs the viewport, the symbol factory, the
    frame builder, the random provider, the phase factory and the reels, and
    hands them all to the ReelSet through one params object. The ReelSet then
    constructs the three subsystems that need the set to exist first: the
    SpeedManager, the SpinController and the SymbolSpotlight.
  </p>

  <h2>The ownership tree</h2>

  <p>
    Figure 1 is the ReelSet after <code>build()</code> returns. Notice that
    only one box, the viewport, is a display child that PixiJS draws; the
    other seven are plain objects the set holds. The reels at the bottom are
    owned by the set as objects, but their containers live inside the
    viewport, which is why the next figure opens one reel on its own.
  </p>

  <Diagram height={550} caption="What the ReelSet owns after build(). Eight subsystems plus the reels; the next figure opens one reel.">
    <Box x={20} y={80} w={200} h={60} title="ReelSetBuilder" kind="primary" sub="the only new you write" />
    <Edge from={[220, 110]} to={[260, 110]} label="build()" kind="primary" labelDx={-16} labelDy={-58} />

    <Group x={260} y={20} w={440} h={510} kind="tint" label="ReelSet" note="a PIXI.Container, Disposable" />

    <Box x={276} y={60} w={200} h={78} title="ReelViewport" sub={['the only display child', '5 layers, 1 mask']} />
    <Box x={488} y={60} w={196} h={78} title="SpinController" kind="accent" sub={['owns the TickerRef', 'active phase per reel']} />
    <Box x={276} y={154} w={200} h={78} title="SpeedManager" sub={['the speeds map', 'built in the ctor']} />
    <Box x={488} y={154} w={196} h={78} title="SymbolSpotlight" sub={['dim + spotlight', 'built in the ctor']} />
    <Box x={276} y={248} w={200} h={78} title="SymbolFactory" sub={['ObjectPool<ReelSymbol>', 'keyed by symbol id']} />
    <Box x={488} y={248} w={196} h={78} title="FrameBuilder" sub={['RandomSymbolProvider', 'middleware chain']} />
    <Box x={276} y={342} w={200} h={78} title="EventEmitter" sub={['ReelSetEvents', 'its own bus']} />
    <Box x={488} y={342} w={196} h={78} title="pins, ReelFactory" sub={['Map<key, CellPin>', 'closure from build()']} />
    <Box x={276} y={436} w={408} h={78} title="Reel[]" kind="ghost" sub={['one per reels(n), plus addReels()', 'containers sit in the viewport']} />
  </Diagram>

  <p>
    Figure 2 is one reel. Each reel carries six things: an axis object that
    says which way it travels, the motion that moves its strip every tick, a
    queue of the symbols it must land on, the symbols themselves, the PixiJS
    container they sit in, and a small event bus of its own. Notice that the
    container's draw order is its reel index, positive or negative depending
    on the stacking you chose, which is what decides whether the last reel
    draws in front or behind.
  </p>

  <Diagram height={370} caption="What one Reel owns. Its container is a display child of viewport.maskedContainer; the Reel object itself belongs to the ReelSet.">
    <Group x={20} y={20} w={680} h={330} kind="solid" label="Reel i" note="implements Disposable" />
    <Box x={44} y={60} w={308} h={78} title="ReelAxis" kind="code" sub={['reelAxis(orientation, dir)', 'toScreen, mainProp']} />
    <Box x={368} y={60} w={308} h={78} title="ReelMotion" kind="code" sub={['moves the strip every tick', 'index -> position, wraps']} />
    <Box x={44} y={154} w={308} h={78} title="StopSequencer" kind="code" sub={['the landing queue', 'next() on every wrap']} />
    <Box x={368} y={154} w={308} h={78} title="symbols: ReelSymbol[]" kind="code" sub={['buffer + visible + buffer', 'from the SymbolFactory']} />
    <Box x={44} y={248} w={308} h={78} title="container" kind="code" sub={['PIXI.Container', 'zIndex = +/- reelIndex']} />
    <Box x={368} y={248} w={308} h={78} title="events" kind="code" sub={['EventEmitter<ReelEvents>', 'phase:*, landed, symbol:created']} />
  </Diagram>

  <div class="not-prose my-8">
    <Legend items={[
      { kind: 'primary', label: 'Public API', note: 'the builder; you construct this' },
      { kind: 'accent', label: 'Conductor', note: 'SpinController drives every reel' },
      { kind: 'subtle', label: 'Subsystems', note: 'owned by the ReelSet, destroyed with it' },
      { kind: 'muted', label: 'Per reel', note: 'dark boxes are owned by one Reel' },
    ]} />
  </div>

  <h2>What each class does, in plain English</h2>

  <p>
    Every class in the two figures, one card each. If a name on another page
    feels opaque, this is the place to look it up.
  </p>

  <div class="not-prose my-6 grid gap-2 text-sm">
    {CARDS.map(([name, role, text]) => (
      <div class="rounded-lg border border-border bg-card px-4 py-3">
        <div class="flex items-center gap-2">
          <code class="font-mono text-primary text-sm">{name}</code>
          <span class="text-xs text-muted-foreground">{role}</span>
        </div>
        <p class="mt-1 text-foreground/80">{text}</p>
      </div>
    ))}
  </div>

  <h2>Teardown order</h2>

  <p>
    <code>ReelSet.destroy()</code> is the single source of truth for
    teardown. It guards against a second call, marks the set destroyed, and
    then runs the ten lines in figure 3, in that order. The order is not
    arbitrary. The spin controller goes before the reels so no frame callback
    lands on a dead reel. The symbol pool goes before the viewport so that
    symbols released into the pool are detached from the viewport's promoted
    layer before that layer dies. And the <code>destroyed</code> event fires
    one line before the listeners are dropped, so anyone waiting on it still
    hears it. Read the figure top to bottom and notice that each step only
    touches things the steps above it have not freed yet.
  </p>

  <Diagram height={TB_Y0 + (TEARDOWN.length - 1) * TB_PITCH + TB_H + 20} caption="ReelSet.destroy(), one box per line of source. Each step only touches things the previous steps have not freed yet.">
    {TEARDOWN.map(([title, note], i) => (
      <Box x={TB_X} y={TB_Y0 + i * TB_PITCH} w={TB_W} h={TB_H} title={`${i + 1}. ${title}`} sub={note} align="left" kind={i === TEARDOWN.length - 1 ? 'primary' : i === 5 ? 'accent' : 'subtle'} />
    ))}
    {TEARDOWN.map((_, i) => i < TEARDOWN.length - 1 && (
      <Edge from={[TB_X + TB_W / 2, TB_Y0 + i * TB_PITCH + TB_H]} to={[TB_X + TB_W / 2, TB_Y0 + (i + 1) * TB_PITCH]} />
    ))}
  </Diagram>

  <p>
    Two of the steps need a word of explanation. A <em>pin</em> is a cell that
    stays put across spins (a sticky wild, a held coin), and the engine draws
    it with an overlay that is itself a pooled symbol. That is why the pin
    overlays at step 4 are destroyed after the reels but before the pool:
    each overlay is released back into the pool, and the pool at step 5 then
    disposes of everything it holds. The second is step 9. Once the listeners
    are gone the bus is gone too, which is why the error handler in <code>nudge()</code> checks <code>isDestroyed</code> before trying to emit <code>nudge:cancelled</code>: an emit after this line would be shouting
    into an empty room.
  </p>

  <Callout kind="gotcha">
    Destroy the set, not its parts. The controller's ticker callback and the
    set's listeners are only removed by <code>reelSet.destroy()</code>, so
    destroying a reel or the viewport on its own does not free them. One call
    at the top does all ten steps.
  </Callout>

  <h2>The Disposable contract</h2>

  <p>
    Every class that holds a resource promises the same two things: a <code>destroy()</code> method, and a flag that says whether it has already
    run. That is the whole interface.
  </p>

  <pre><code>{`export interface Disposable {
  destroy(): void;
  readonly isDestroyed: boolean;
}`}</code></pre>

  <p>
    Anything that subscribes to a ticker, creates display objects or holds
    references implements it. Every <code>destroy()</code> in the engine is
    safe to call twice: it returns early when <code>isDestroyed</code> is
    already set, which is what lets the cascade be simple rather than
    careful. If you add a subsystem of your own that holds resources, it must
    implement <code>Disposable</code> and be destroyed from the chain above,
    or it leaks. The list below is who owns what, so you can see which call
    frees which resource.
  </p>

  <div class="not-prose my-4 grid gap-2 text-sm">
    {[
      ['ReelSet', 'viewport, reels, symbol factory, frame builder, spin controller, speed manager, spotlight, pins, events'],
      ['Reel', 'axis, motion, stopSequencer, symbols, container, events, occupied stubs'],
      ['SpinController', 'TickerRef, the active phase per reel, cached frames'],
      ['SymbolSpotlight', 'gsap timelines, the dim request, reparented winner views'],
      ['SymbolFactory', 'ObjectPool<ReelSymbol>; pool.destroy() disposes every idle symbol'],
      ['ReelViewport', 'masked, unmasked, dim, spotlight and promoted layers; the mask Graphics'],
      ['TickerRef', 'every ticker callback it registered'],
      ['ReelSymbol', 'its view container and whatever the subclass allocates in onDestroy()'],
    ].map(([k, v]) => (
      <div class="flex items-center gap-3 rounded-lg border border-border bg-card px-3 py-2">
        <code class="font-mono text-primary text-sm min-w-[160px]">{k}</code>
        <span class="text-muted-foreground text-xs">owns: {v}</span>
      </div>
    ))}
  </div>

  <h2>The TickerRef rule</h2>

  <p>
    A PixiJS ticker calls a list of functions once per frame, forever, until
    each one is removed. Forgetting to remove one is the easiest leak to
    write and the hardest to see: the game keeps running, a little slower,
    until the dead callback touches something that is gone. The engine's
    answer is a thin wrapper, <code>TickerRef</code>, that remembers every
    callback it adds and removes them all in one <code>destroy()</code>. The
    rule that follows is simple: nobody in the engine calls <code>ticker.add()</code> directly.
  </p>

  <Callout kind="why">
    There is exactly one TickerRef, and the SpinController owns it. The
    controller adds its one per-frame callback to it and destroys it in its
    own <code>destroy()</code>, which is why the controller is the second
    thing the set tears down: after that line, nothing in the set runs on a
    frame. The testing subpath swaps a <code>FakeTicker</code> in at the same
    seam, so a whole spin can be stepped by hand in Node.
  </Callout>

  <h2>Extension points</h2>

  <p>
    Five seams are designed to be replaced. Each row says what you would
    reach for it to do and how to plug your version in.
  </p>

  <div class="not-prose my-6 rounded-lg border border-border bg-card overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-muted/60">
        <tr>
          <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">Extend</th>
          <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">When you want</th>
          <th class="text-left px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-muted-foreground">How</th>
        </tr>
      </thead>
      <tbody>
        {[
          ['ReelSymbol', 'a new way of drawing a cell', 'subclass it, implement the five required members, and register it with builder.symbols(r => r.register(id, Class, opts)). The symbols page has the lifecycle and every optional hook.'],
          ['ReelPhase<TConfig>', 'a new stage in the spin', 'register a factory with builder.phases(f => f.register(...)). Your configurators always run after the tumble and MultiWays defaults. See the spin lifecycle page.'],
          ['SpinningMode', 'a different idea of what a spin is', 'pass an instance to builder.spinningMode(mode).'],
          ['FrameMiddleware', 'a say in which symbols land where', '{ name, priority, process(ctx, next) }. Lower priority runs first; a middleware that does not call next() stops the rest. Random fill and target placement are themselves middleware. See the frame pipeline page.'],
          ['MaskStrategy', 'a custom clip shape', '{ version: 2, build(ctx), update(g, ctx) }, or a DrawableMaskStrategy with draw(g, ctx) so it composes with others. See the viewport page.'],
        ].map(([e, w, h]) => (
          <tr class="border-t border-border align-top">
            <td class="px-4 py-2 font-mono text-xs">{e}</td>
            <td class="px-4 py-2 text-foreground/80">{w}</td>
            <td class="px-4 py-2 text-foreground/80">{h}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p>
    The pages for each seam: <a href="/architecture/symbols/">symbols</a>, <a href="/architecture/spin-lifecycle/">spin lifecycle</a>, <a href="/architecture/frame-pipeline/">the frame pipeline</a> and <a href="/architecture/viewport-and-masks/">viewport and masks</a>.
  </p>

  <h2>Where this lives</h2>

  <div class="not-prose my-6 grid gap-3 sm:grid-cols-2">
    <div class="rounded-lg border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-brand-text mb-1">packages/pixi-reels/src/core/</div>
      <ul class="text-sm space-y-1 text-foreground/80">
        <li><code>ReelSetBuilder.ts</code> the builder and <code>build()</code></li>
        <li><code>ReelSet.ts</code> the set, its constructor order and <code>destroy()</code></li>
        <li><code>Reel.ts</code> one strip, plus the internal <code>OccupiedStub</code></li>
        <li><code>ReelViewport.ts</code> the layers and the mask contract</li>
        <li><code>ReelAxis.ts</code>, <code>ReelMotion.ts</code>, <code>StopSequencer.ts</code></li>
      </ul>
    </div>
    <div class="rounded-lg border border-border bg-card p-4">
      <div class="text-[11px] font-mono uppercase tracking-wider text-brand-text mb-1">elsewhere</div>
      <ul class="text-sm space-y-1 text-foreground/80">
        <li><code>spin/SpinController.ts</code>, <code>spin/phases/</code>, <code>spin/modes/</code></li>
        <li><code>symbols/ReelSymbol.ts</code>, <code>SymbolRegistry.ts</code>, <code>SymbolFactory.ts</code>; <code>pool/ObjectPool.ts</code></li>
        <li><code>frame/FrameBuilder.ts</code>, <code>RandomSymbolProvider.ts</code></li>
        <li><code>speed/SpeedManager.ts</code>, <code>spotlight/SymbolSpotlight.ts</code></li>
        <li><code>events/EventEmitter.ts</code>, <code>utils/Disposable.ts</code>, <code>utils/TickerRef.ts</code></li>
      </ul>
    </div>
  </div>

  <Callout kind="remember">
    Every object has one owner, every owner destroys what it made, and <code>reelSet.destroy()</code> runs the whole cascade in an order that
    stops the ticker first and drops the listeners last. If you add something
    that holds a resource, give it a <code>destroy()</code> and hang it off
    that chain.
  </Callout>
</Architecture>
