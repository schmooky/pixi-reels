    <Box x={372} y={40} w={160} h={66} title="M wraps" size={12} sub={['one id per wrap', 'until !hasRemaining']} />
    <Box x={548} y={40} w={160} h={66} title="land()" kind="accent" size={12} sub={['snap, notify,', "raise 'landing'"]} />
    <Box x={724} y={40} w={160} h={66} title="bounce()" kind="primary" size={12} sub={['overshoot along mainProp', 'by polarity * distance']} />
    <Edge from={[180, 73]} to={[196, 73]} />
    <Edge from={[356, 73]} to={[372, 73]} />
