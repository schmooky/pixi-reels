---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import CodeShowcase from '../components/CodeShowcase.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Mechanics from '../components/landing/Mechanics.astro';
import Partners from '../components/Partners.astro';
import {
  SITE,
  softwareApplicationLd,
  softwareSourceCodeLd,
  webSiteLd,
  breadcrumbLd,
} from '../lib/seo.ts';

const jsonLd = [
  webSiteLd(),
  softwareApplicationLd(),
  softwareSourceCodeLd(),
  breadcrumbLd([{ name: SITE.name, url: '/' }]),
];
---
<Base
  title={`${SITE.name}. ${SITE.tagline}`}
  description={SITE.description}
  path="/"
  type="website"
  jsonLd={jsonLd}
>
  <Hero />
  <Mechanics />
  <CodeShowcase />
  <Partners />
  <FeatureGrid />
</Base>

<script>
  // Scroll reveal: a `.reveal` block appears (global.css) once it enters the
  // view, once. Under reduced motion the CSS shows everything at rest, and
  // the observer is only a no-op class toggle.
  const blocks = document.querySelectorAll<HTMLElement>('.reveal');
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      }
    },
    { rootMargin: '0px 0px -10% 0px' },
  );
  blocks.forEach((b) => io.observe(b));
</script>
