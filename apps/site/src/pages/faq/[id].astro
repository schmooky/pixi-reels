---
import Base from '../../layouts/Base.astro';
import {
  FAQ,
  FAQ_ANSWERED,
  FAQ_GROUP_TITLE,
  type FaqQuestionResolved,
} from '../../content/faq.ts';
import { ChevronLeft, ArrowRight } from 'lucide-react';
import { SITE, qaPageLd, articleLd, breadcrumbLd } from '../../lib/seo.ts';

// One page per ANSWERED question. Adding an answer in faq.ts mints a page
// here automatically; open questions stay on the index until answered.
export function getStaticPaths() {
  return FAQ_ANSWERED.map((q) => ({ params: { id: q.id }, props: { q } }));
}

interface Props {
  q: FaqQuestionResolved;
}
const { q } = Astro.props as Props;
const groupTitle = FAQ_GROUP_TITLE[q.group];
const path = `/faq/${q.id}/`;

const escapeHtml = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Plain prose → HTML: blank lines split paragraphs, `code` spans become <code>.
function renderAnswer(text: string): string {
  return text
    .split(/\n\n+/)
    .map((p) => {
      const html = escapeHtml(p).replace(
        /`([^`]+)`/g,
        '<code class="rounded-sm bg-muted px-1.5 py-0.5 font-mono text-[0.85em]">$1</code>',
      );
      return `<p class="leading-7 text-foreground/85">${html}</p>`;
    })
    .join('');
}
const plain = (s: string) => s.replace(/`/g, '');

const answerEn = q.answer!.en;
const description = plain(answerEn).slice(0, 155);

// Related: other questions in the same group (answered first, then open).
const related: FaqQuestionResolved[] = (FAQ.find((g) => g.id === q.group)?.questions ?? [])
  .map((x) => ({ ...x, group: q.group }))
  .filter((x) => x.id !== q.id)
  .sort((a, b) => Number(!!b.answer) - Number(!!a.answer))
  .slice(0, 8);

const editUrl = `${SITE.githubRepo}/edit/main/apps/site/src/content/faq.ts`;
---
<Base
  title={`${q.en} · ${SITE.name} FAQ`}
  description={description}
  path={path}
  type="article"
  article={{ section: 'FAQ', tags: [q.group] }}
  jsonLd={[
    qaPageLd({ question: q.en, answer: plain(answerEn), path }),
    articleLd({ title: q.en, description, path }),
    breadcrumbLd([
      { name: SITE.name, url: '/' },
      { name: 'FAQ', url: '/faq/' },
      { name: groupTitle.en, url: `/faq/#${q.group}` },
      { name: q.en, url: path },
    ]),
  ]}
>
  <div class="container max-w-[760px] py-12 animate-fade-in">
    <header class="mb-8">
      <a href="/faq/" class="mb-6 inline-flex items-center gap-1 font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground transition-colors hover:text-foreground">
        <ChevronLeft size={14} strokeWidth={2} />
        All questions
      </a>
      <p class="eyebrow">
        FAQ
        <span class="text-muted-foreground/60">/</span>
        <a href={`/faq/#${q.group}`} class="hover:underline">{groupTitle.en}</a>
        <span class="text-muted-foreground/60">/</span>
        Answered
      </p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">{q.en}</h1>
    </header>

    <article class="space-y-4">
      <div class="space-y-3" set:html={renderAnswer(answerEn)} />

      {q.links && q.links.length > 0 && (
        <div class="not-prose mt-8 border-y border-border py-4">
          <div class="mb-2 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground">See it work</div>
          <ul class="space-y-1.5">
            {q.links.map((l) => (
              <li>
                <a href={l.href} class="group inline-flex items-center gap-1.5 text-sm font-medium text-foreground">
                  {l.label}
                  <ArrowRight size={14} strokeWidth={2.5} className="transition-transform duration-[133ms] ease-[cubic-bezier(0.333,1.6,0.667,1)] group-hover:translate-x-1" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </article>

    {related.length > 0 && (
      <section class="mt-12">
        <h2 class="eyebrow mb-4">More in {groupTitle.en}</h2>
        <ul class="divide-y divide-border border-y border-border">
          {related.map((r) => {
            const answered = !!r.answer;
            const href = answered ? `/faq/${r.id}/` : `/faq/#${r.id}`;
            return (
              <li>
                <a href={href} class="group flex items-center gap-4 py-2.5 text-sm">
                  <span class:list={['min-w-0 flex-1 truncate', answered ? 'text-foreground' : 'text-muted-foreground']}>{r.en}</span>
                  {answered ? (
                    <ArrowRight size={14} strokeWidth={2.5} className="shrink-0 text-muted-foreground transition-transform duration-[133ms] ease-[cubic-bezier(0.333,1.6,0.667,1)] group-hover:translate-x-1 group-hover:text-foreground" />
                  ) : (
                    <span class="shrink-0 font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">open</span>
                  )}
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <footer class="mt-8 text-xs text-muted-foreground">
      Spotted a better answer? <a href={editUrl} class="text-foreground underline decoration-brand-text underline-offset-4">Improve this on GitHub →</a>
    </footer>
  </div>
</Base>
