---
import Base from '../../layouts/Base.astro';
import { FAQ, FAQ_COUNT, FAQ_ANSWERED, FAQ_ANSWERED_COUNT } from '../../content/faq.ts';
import { ArrowRight, Search } from 'lucide-react';
import { SITE, articleLd, breadcrumbLd, faqLd } from '../../lib/seo.ts';

const title = 'FAQ. how do I build this slot mechanic?';
const description =
  'A searchable knowledge base of slot-development questions answered with pixi-reels: how to spin, respin, set symbols, run Hold & Win, lock coins, reveal a mystery value, fly coins into a collector, play a destroy animation, and hundreds more.';

const stripCode = (s: string) => s.replace(/`/g, '');
// FAQPage rich-result data is built from the ANSWERED questions only.
// Google needs a real answer per Q. Open questions are still listed and
// on-page searchable, just not in the structured data yet.
const faqEntries = FAQ_ANSWERED.map((q) => ({
  question: q.en,
  answer: stripCode(q.answer!.en),
}));

const editUrl = `${SITE.githubRepo}/edit/main/apps/site/src/content/faq.ts`;
---
<Base
  title={`FAQ · ${SITE.name}`}
  description={description}
  path="/faq/"
  jsonLd={[
    faqLd(faqEntries),
    articleLd({ title, description, path: '/faq/' }),
    breadcrumbLd([
      { name: SITE.name, url: '/' },
      { name: 'FAQ', url: '/faq/' },
    ]),
  ]}
>
  <section class="border-b border-border py-14 sm:py-16">
    <div class="container max-w-3xl">
      <p class="eyebrow">
        FAQ
        <span class="text-muted-foreground/60">/</span>
        Knowledge base
      </p>
      <h1 class="display mt-4 text-4xl sm:text-5xl">How do I…?</h1>
      <p class="mt-5 max-w-xl text-lg text-muted-foreground">
        The questions a slot developer actually asks — answered with pixi-reels.
        Searchable, and growing.
        <span class="font-medium text-foreground/80">{FAQ_ANSWERED_COUNT}</span> of
        <span class="font-medium text-foreground/80">{FAQ_COUNT}</span> answered so far.
      </p>

      <div class="relative mt-8 max-w-lg">
        <Search size={16} strokeWidth={2} className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground" />
        <input
          id="faq-search"
          type="search"
          autocomplete="off"
          placeholder={`Search ${FAQ_COUNT} questions — try 'respin', 'mystery', 'collector'…`}
          aria-label="Search the FAQ"
          class="w-full rounded-sm border border-border bg-background py-2.5 pl-10 pr-4 font-mono text-sm outline-none transition-colors duration-[133ms] placeholder:font-mono placeholder:text-muted-foreground focus:border-foreground"
        />
      </div>
      <p id="faq-noresults" class="mt-4 hidden text-sm text-muted-foreground">
        No questions match. <a class="text-foreground underline decoration-brand-text underline-offset-4" href={editUrl}>Add it →</a>
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="container max-w-3xl space-y-14">
      {FAQ.map((group, i) => (
        <div class="faq-group" id={group.id} data-group={group.id}>
          <h2 class="eyebrow">{String(i + 1).padStart(2, '0')} / {group.title.en}</h2>
          <p class="mb-5 mt-2 max-w-xl text-sm text-muted-foreground">{group.blurb.en}</p>
          <ul class="divide-y divide-border border-y border-border">
            {group.questions.map((q) => {
              const answered = !!q.answer;
              const Row = answered ? 'a' : 'div';
              const href = answered ? `/faq/${q.id}/` : undefined;
              return (
                <li
                  class="faq-q"
                  id={q.id}
                  data-text={q.en.toLowerCase()}
                >
                  <Row
                    href={href}
                    class="group flex items-baseline gap-4 py-3"
                    title={answered ? 'Answered' : 'Open question'}
                  >
                    <span
                      class:list={[
                        'min-w-0 flex-1 text-sm font-medium',
                        answered ? 'text-foreground' : 'text-muted-foreground',
                      ]}
                    >{q.en}</span>
                    {answered ? (
                      <ArrowRight size={16} strokeWidth={2.5} className="shrink-0 self-center text-muted-foreground transition-transform duration-[133ms] ease-[cubic-bezier(0.333,1.6,0.667,1)] group-hover:translate-x-1 group-hover:text-foreground" />
                    ) : (
                      <span class="shrink-0 font-mono text-[11px] uppercase tracking-[0.14em] text-muted-foreground">open</span>
                    )}
                  </Row>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <script is:inline>
    (() => {
      const input = document.getElementById('faq-search');
      const groups = Array.from(document.querySelectorAll('.faq-group'));
      const noResults = document.getElementById('faq-noresults');
      if (!input) return;
      const norm = (s) => s.toLowerCase().trim();
      const apply = () => {
        const q = norm(input.value);
        let anyVisible = false;
        for (const g of groups) {
          let groupVisible = false;
          for (const item of g.querySelectorAll('.faq-q')) {
            const hit = !q || (item.dataset.text || '').includes(q);
            item.hidden = !hit;
            if (hit) groupVisible = true;
          }
          g.hidden = !groupVisible;
          if (groupVisible) anyVisible = true;
        }
        if (noResults) noResults.hidden = anyVisible;
      };
      input.addEventListener('input', apply);
      // Support /faq/?q=respin and deep #anchors.
      const params = new URLSearchParams(location.search);
      const initial = params.get('q');
      if (initial) { input.value = initial; apply(); }
    })();
  </script>
</Base>
