---
const features = [
  { title: 'Fluent builder', body: 'Chain the settings, then build() checks them and throws one error that lists whatever is missing.' },
  { title: 'Typed events', body: 'Events such as spin:reelLanded and speed:changed, each with a typed payload.' },
  { title: 'Headless testing', body: 'createTestReelSet and FakeTicker run a whole spin in Node, with no renderer and no DOM.' },
  { title: 'Mechanic recipes', body: 'More than 200 runnable demos on the mechanics pages, each shown with its source.' },
  { title: 'Agent-friendly debug', body: 'enableDebug() attaches JSON snapshots and per-spin timings to window, so agents inspect state without reading the canvas. pixi-reels/debug draws the same on the canvas: cells, axes, a metrics plaque and a phase timeline.' },
  { title: 'Extension points', body: 'Write your own symbols, phases or spinning modes against a named interface.' },
];
---
<section class="py-20 sm:py-24">
  <div class="container">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">In the box</p>
      <h2 class="display mt-4 text-4xl sm:text-5xl lg:text-6xl">
        What is in the package.
      </h2>
    </div>

    {/*
      A spec sheet, not a card grid: hairlines, a mono index, no icons. The
      copy carries it.
    */}
    <ol class="mt-12 grid border-t border-border sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f, i) => (
        <li class="spec reveal border-b border-border py-7" style={`--motion-delay: ${(i % 3) * 50}ms`}>
          <h3 class="font-display text-2xl font-bold tracking-tight">{f.title}</h3>
          <p class="mt-2 max-w-sm text-[15px] leading-relaxed text-muted-foreground">{f.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Hairline between columns: every column but the first, at each breakpoint. */
  @media (min-width: 640px) {
    .spec { padding-right: 2rem; }
    .spec:nth-child(2n) { border-left: 1px solid hsl(var(--border)); padding-left: 2rem; }
  }
  @media (min-width: 1024px) {
    .spec:nth-child(2n) { border-left: 0; padding-left: 0; }
    .spec:nth-child(3n + 2), .spec:nth-child(3n) { border-left: 1px solid hsl(var(--border)); padding-left: 2rem; }
  }
</style>
