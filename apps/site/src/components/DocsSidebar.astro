---
import type { NavSection } from '../content/nav.ts';
interface Props {
  nav: NavSection[];
  pathname: string;
  /**
   * The viewport width at which the sidebar sits beside the content instead
   * of above it. `md` (the default) suits text pages; the architecture pages
   * use `lg` so their 720px diagrams get the full column on laptops and in
   * narrow windows, with the nav folded into a toggle until then.
   */
  breakpoint?: 'md' | 'lg';
}
const { nav, pathname, breakpoint = 'md' } = Astro.props;
const lg = breakpoint === 'lg';
---
<aside class:list={[
  'pr-4',
  lg
    ? 'lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-5.5rem)] lg:overflow-y-auto'
    : 'md:sticky md:top-20 md:self-start md:max-h-[calc(100vh-5.5rem)] md:overflow-y-auto',
]}>
  <button
    id="sidebar-toggle"
    class:list={[
      'mb-4 flex w-full items-center justify-between border-y border-border py-2 font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-foreground',
      lg ? 'lg:hidden' : 'md:hidden',
    ]}
    aria-expanded={lg ? 'false' : 'true'}
    aria-controls="sidebar-nav"
  >
    <span>On this section</span>
    <svg id="sidebar-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden style={lg ? 'transform: rotate(-90deg)' : undefined}>
      <path d="M4 6l4 4 4-4"/>
    </svg>
  </button>
  <nav id="sidebar-nav" class:list={['divide-y divide-border', { 'hidden lg:block': lg }]}>
    {nav.map((section) => (
      <div class="py-5 first:pt-0 last:pb-0">
        <div class="mb-2 font-mono text-[11px] font-medium uppercase tracking-[0.18em] text-muted-foreground">
          {section.title}
        </div>
        <ul class="border-l border-border">
          {section.items.map((item) => {
            const active = pathname === item.href || pathname === item.href.slice(0, -1);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    '-ml-px block border-l-2 py-1.5 pl-3 text-sm transition-colors duration-[133ms]',
                    active
                      ? 'border-brand font-medium text-foreground'
                      : 'border-transparent text-muted-foreground hover:text-foreground',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<script>
  const toggle = document.getElementById('sidebar-toggle');
  const nav = document.getElementById('sidebar-nav');
  const chevron = document.getElementById('sidebar-chevron');

  toggle?.addEventListener('click', () => {
    const isOpen = !nav?.classList.contains('hidden');
    nav?.classList.toggle('hidden', isOpen);
    toggle.setAttribute('aria-expanded', String(!isOpen));
    if (chevron) chevron.style.transform = isOpen ? 'rotate(-90deg)' : '';
  });
</script>
