---
/**
 * Recipe card thumbnail. 16:10. The slug's hand-drawn cover
 * (`recipes-index/covers.ts`) wins, so the index reads as one set; a page
 * without a cover falls back to its preview media at
 * `public/recipes/<slug>/card.<ext>` (or an explicit `image` override), then
 * to a generated placeholder. See `lib/recipeMedia.ts` for the lookup.
 */
import { findCardMedia } from '../lib/recipeMedia.ts';
import { hasRecipeCover } from './recipes-index/covers.ts';
import RecipeCover from './recipes-index/RecipeCover.astro';
import RecipePlaceholder from './RecipePlaceholder.astro';

interface Props {
  slug: string;
  title: string;
  /** Optional explicit public URL override. */
  image?: string;
}

const { slug, title, image } = Astro.props as Props;
const cover = hasRecipeCover(slug);
const media = cover ? null : findCardMedia(slug, image);
---
<div class="relative aspect-[16/10] w-full overflow-hidden border-b border-border bg-muted/30">
  {media?.kind === 'image' && (
    <img
      src={media.src}
      alt={`${title} preview`}
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover"
    />
  )}
  {media?.kind === 'video' && (
    <video
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={`${title} preview`}
      class="h-full w-full object-cover"
    >
      <source src={media.src} />
    </video>
  )}
  {cover && <RecipeCover slug={slug} />}
  {!media && !cover && <RecipePlaceholder title={title} />}
</div>
