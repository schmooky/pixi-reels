---
/**
 * Discreet, theme-aware "assets provided by <studio>" badge.
 *
 * Placed at the foot of a recipe whose demo art is a partner studio's.
 * The logo SVG is inlined and authored fill-less, so `currentColor` drives
 * it: ink in light, paper in dark. The caption is small and italic. No
 * provenance detail beyond the attribution itself.
 *
 * Usage in MDX: `<AssetCredit studio="Thunderkick" />`
 */
import thunderkickSvg from '../../public/credits/thunderkick.svg?raw';

interface Props {
  studio?: string;
}

const { studio = 'Thunderkick' } = Astro.props;

const LOGO_BY_STUDIO: Record<string, string> = {
  Thunderkick: thunderkickSvg,
};
const logo = LOGO_BY_STUDIO[studio];
---

<aside class="asset-credit" aria-label={`Assets provided by ${studio}`}>
  {logo && <span class="asset-credit__logo" set:html={logo} />}
  <span class="asset-credit__text">Assets provided by {studio}</span>
</aside>

<style>
  .asset-credit {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    width: fit-content;
    max-width: 100%;
    margin-top: 2.5rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.5rem;
    background: hsl(var(--muted) / 0.4);
  }

  /* Fill-less logo paths inherit currentColor. drive it from --foreground so
     the mark reads as ink on light, paper on dark. */
  .asset-credit__logo {
    display: inline-flex;
    flex: none;
    color: hsl(var(--foreground));
  }
  .asset-credit__logo :global(svg) {
    display: block;
    height: 0.95rem;
    width: auto;
  }

  .asset-credit__text {
    font-size: 0.78rem;
    font-style: italic;
    color: hsl(var(--muted-foreground));
  }
</style>
