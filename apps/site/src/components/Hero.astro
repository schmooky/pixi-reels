---
import CopyCommand from './CopyCommand.astro';
import { LandingReels, landingAspect } from './landing/LandingReels.tsx';

const aspect = landingAspect('hero');
---
<section class="relative overflow-hidden border-b border-border/60">
  <div class="grid-bg absolute inset-0 opacity-50 pointer-events-none" aria-hidden></div>

  <div class="container relative grid items-center gap-12 py-20 sm:py-24 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:py-28">
    <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
      <h1 class="max-w-3xl text-balance text-4xl font-semibold tracking-tight sm:text-6xl">
        Slot reels, <span class="text-muted-foreground">ready to spin.</span>
      </h1>

      <p class="mt-5 max-w-xl text-balance text-lg text-muted-foreground">
        A fluent reel engine for PixiJS v8.<br/>Go from <code class="rounded bg-muted px-1.5 py-0.5 font-mono text-[0.85em] text-foreground">npm install</code> to a
        spinning slot in ten lines.<br/>Fully typed, headless-testable, MIT.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
        <a
          href="/guides/getting-started/"
          class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground shadow transition-colors hover:bg-primary/90"
        >
          Get started
        </a>
        <a
          href="/recipes/"
          class="inline-flex h-11 items-center justify-center rounded-md border border-border bg-background px-6 text-sm font-medium text-foreground shadow-sm transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          Browse recipes 👉
        </a>
      </div>

      <div class="mt-6">
        <CopyCommand command="npm i pixi-reels" />
      </div>
    </div>

    {/*
      The reels on the right are the engine itself: a 5x3 ReelSet built with
      the public builder, spinning on a loop while it is on screen. The well
      behind it is drawn by the island; this wrapper only reserves the exact
      box (via aspect-ratio) so the hero never reflows when the canvas mounts.
    */}
    <div class="relative mx-auto w-full max-w-[620px]">
      <div class="absolute -inset-6 rounded-[2rem] bg-foreground/5 blur-2xl" aria-hidden></div>
      <div
        class="hero-well relative overflow-hidden rounded-2xl shadow-2xl shadow-black/30"
        style={`aspect-ratio: ${aspect};`}
        data-hero-reels
      >
        <div class="hero-well__skeleton absolute inset-0 flex items-center justify-center" aria-hidden="true">
          <div class="flex flex-col items-center gap-3 text-white/30">
            <div class="h-8 w-8 animate-spin rounded-full border-2 border-current border-t-transparent"></div>
            <p class="font-mono text-[11px] uppercase tracking-wider">Warming up the reels</p>
          </div>
        </div>
        <LandingReels variant="hero" client:only="react" />
      </div>
      <p class="mt-3 text-center font-mono text-[11px] uppercase tracking-wider text-muted-foreground">
        Live <span class="mx-1 text-border">·</span> a real ReelSet, not a video <span class="mx-1 text-border">·</span> click to spin or slam
      </p>
    </div>
  </div>
</section>

<style>
  /* Same surface as every code-ish element (global.css --code-bg). */
  .hero-well {
    background: hsl(var(--code-bg));
    border: 1px solid hsl(var(--code-border));
  }
  /* Hide the skeleton once the React island has rendered its host. */
  .hero-well:has(astro-island > *) .hero-well__skeleton {
    display: none;
  }
</style>
