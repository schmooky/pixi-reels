---
/**
 * A labelled rectangle inside a `<Diagram>`. Title on one line, optional
 * sub-lines beneath it, optional badge in the top-left, optional link.
 *
 * Kinds: primary (ink), accent (tinted, strong border), subtle (card),
 * muted (soft surface), ghost (dashed outline), code (dark surface).
 */
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  /** One line, or several. */
  sub?: string | string[];
  kind?: 'primary' | 'accent' | 'subtle' | 'muted' | 'ghost' | 'code';
  badge?: string;
  href?: string;
  /** Corner radius. */
  r?: number;
  /** Title font size. */
  size?: number;
  /** Title in the monospace face (default true: most boxes are class names). */
  mono?: boolean;
  /** Horizontal alignment of the text block. */
  align?: 'center' | 'left';
  /** Extra class on the wrapping <g>. */
  class?: string;
}
const {
  x, y, w, h, title, sub, kind = 'subtle', badge, href, r = 10, size = 13, mono = true, align = 'center', class: className,
} = Astro.props as Props;

const subLines = sub === undefined ? [] : Array.isArray(sub) ? sub : [sub];
const subSize = Math.max(10, size - 2.5);
const lineH = subSize * 1.3;
const blockH = size + (subLines.length ? 6 + subLines.length * lineH - (lineH - subSize) : 0);
const top = y + (h - blockH) / 2;
const titleY = top + size * 0.85;
const tx = align === 'center' ? x + w / 2 : x + 14;
const anchor = align === 'center' ? 'middle' : 'start';
---
{href ? (
  <a href={href} class:list={['box', `box-${kind}`, className]}>
    <rect x={x} y={y} width={w} height={h} rx={r} class="box-bg" />
    {badge && (
      <g>
        <rect x={x + 8} y={y + 8} width={badge.length * 6.6 + 10} height="16" rx="5" class="box-badge-bg" />
        <text x={x + 13} y={y + 19.5} font-size="10" font-weight="600" class="box-badge mono">{badge}</text>
      </g>
    )}
    <text x={tx} y={titleY} text-anchor={anchor} font-size={size} font-weight="600" class:list={['box-title', { mono }]}>{title}</text>
    {subLines.map((line, i) => (
      <text x={tx} y={titleY + 6 + (i + 1) * lineH} text-anchor={anchor} font-size={subSize} class="box-sub">{line}</text>
    ))}
    <slot />
  </a>
) : (
  <g class:list={['box', `box-${kind}`, className]}>
    <rect x={x} y={y} width={w} height={h} rx={r} class="box-bg" />
    {badge && (
      <g>
        <rect x={x + 8} y={y + 8} width={badge.length * 6.6 + 10} height="16" rx="5" class="box-badge-bg" />
        <text x={x + 13} y={y + 19.5} font-size="10" font-weight="600" class="box-badge mono">{badge}</text>
      </g>
    )}
    <text x={tx} y={titleY} text-anchor={anchor} font-size={size} font-weight="600" class:list={['box-title', { mono }]}>{title}</text>
    {subLines.map((line, i) => (
      <text x={tx} y={titleY + 6 + (i + 1) * lineH} text-anchor={anchor} font-size={subSize} class="box-sub">{line}</text>
    ))}
    <slot />
  </g>
)}
