---
/**
 * A cluster outline inside a `<Diagram>`: a panel with a small
 * uppercase label in its top-left corner. Boxes placed inside it (by
 * coordinates) read as members of the group. Leave 40 units at the top for
 * the label.
 */
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  label?: string;
  /** A second, quieter phrase after the label. Keep it short. */
  note?: string;
  kind?: 'dashed' | 'solid' | 'tint' | 'plain';
  r?: number;
  labelBottom?: boolean;
  class?: string;
}
const { x, y, w, h, label, note, kind = 'dashed', r = 2, labelBottom = false, class: className } = Astro.props as Props;
const ly = labelBottom ? y + h - 12 : y + 24;
---
<g class:list={['group', `group-${kind}`, className]}>
  <rect x={x} y={y} width={w} height={h} rx={r} class="group-bg" />
  {label && (
    <text x={x + 16} y={ly} font-size="12" font-weight="700" class="group-label mono">{label}{note && <tspan class="t-faint" font-weight="400" style="text-transform:none;letter-spacing:0"> · {note}</tspan>}</text>
  )}
  <slot />
</g>
