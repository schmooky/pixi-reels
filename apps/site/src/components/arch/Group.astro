---
/**
 * A cluster outline inside a `<Diagram>`: a soft rounded panel with a small
 * uppercase label in its top-left corner. Boxes placed inside it (by
 * coordinates) read as members of the group.
 */
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  label?: string;
  /** A second, quieter line after the label. */
  note?: string;
  kind?: 'dashed' | 'solid' | 'tint' | 'plain';
  r?: number;
  /** Put the label at the bottom instead of the top. */
  labelBottom?: boolean;
  class?: string;
}
const { x, y, w, h, label, note, kind = 'dashed', r = 14, labelBottom = false, class: className } = Astro.props as Props;
const ly = labelBottom ? y + h - 9 : y + 18;
---
<g class:list={['group', `group-${kind}`, className]}>
  <rect x={x} y={y} width={w} height={h} rx={r} class="group-bg" />
  {label && (
    <text x={x + 14} y={ly} font-size="10" font-weight="600" class="group-label mono">{label}{note && <tspan class="t-faint" font-weight="400" style="text-transform:none;letter-spacing:0"> · {note}</tspan>}</text>
  )}
  <slot />
</g>
