---
/**
 * A sequence of beats on one line (`fall -- wait -- place -- dropIn`), for the
 * guides. Optional markers above a beat (a press, a win), a label on a
 * connector, and spans grouping consecutive beats under the line; a `loop`
 * span is a return edge with its arrowhead at `from`.
 *
 * The figure is a CSS grid with one column per beat and one per connector.
 * Under 640px of container width it turns into a column: beats stack, the
 * connectors become vertical hairlines, markers sit beside their beat and
 * spans become brackets on the left. It never scrolls sideways.
 */
interface Marker { at: number; label: string }
interface Edge { after: number; label: string }
interface Span { from: number; to: number; label: string; loop?: boolean }
interface Props {
  beats: string[];
  markers?: Marker[];
  edges?: Edge[];
  spans?: Span[];
  /** Beats drawn on the brand fill. */
  highlight?: number[];
  /** Accessible name for the figure. */
  title?: string;
  caption?: string;
}
const { beats, markers = [], edges = [], spans = [], highlight = [], title, caption } = Astro.props as Props;
const last = beats.length - 1;
const cols = beats.map((_, i) => (i === last ? 'auto' : 'auto minmax(1.5rem, 1fr)')).join(' ');
const markerAt = (i: number) => markers.find((m) => m.at === i)?.label;
const edgeAfter = (i: number) => edges.find((e) => e.after === i)?.label;
---
<figure class="docs-timeline not-prose my-6 font-mono" aria-label={title}>
  <div class="tl" style={`--cols: ${cols}`}>
    {beats.map((beat, i) => (
      <>
        <div class="tl-beat" style={`--i: ${i}`}>
          <span class:list={['tl-chip', { hot: highlight.includes(i) }]}>{beat}</span>
        </div>
        {markerAt(i) && (
          <div class="tl-marker" style={`--i: ${i}`}>
            <span class="tl-marker-label">{markerAt(i)}</span>
          </div>
        )}
        {i < last && (
          <div class="tl-edge" style={`--i: ${i}`}>
            {edgeAfter(i) && <span class="tl-edge-label">{edgeAfter(i)}</span>}
          </div>
        )}
      </>
    ))}
    {spans.map((s) => (
      <div class:list={['tl-span', { loop: s.loop }]} style={`--from: ${s.from}; --to: ${s.to}`}>
        <span class="tl-span-label">{s.label}</span>
      </div>
    ))}
  </div>
  {caption && <figcaption class="mt-3 font-sans text-sm leading-6 text-muted-foreground">{caption}</figcaption>}
</figure>

<style>
  .docs-timeline {
    container-type: inline-size;
    font-size: 12px;
    line-height: 1.25;
    color: hsl(var(--foreground));
  }
  .tl {
    display: grid;
    align-items: center;
  }
  .tl-beat {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .tl-chip {
    display: inline-block;
    padding: 0.3rem 0.5rem;
    border: 1px solid hsl(var(--border));
    border-radius: 2px;
    background: hsl(var(--card));
    white-space: nowrap;
  }
  .tl-chip.hot {
    border-color: hsl(var(--brand));
    background: hsl(var(--brand));
    color: hsl(var(--brand-foreground));
  }
  .tl-marker {
    display: flex;
    align-items: center;
  }
  .tl-marker::before,
  .tl-marker::after,
  .tl-span.loop::before {
    content: '';
    width: 0;
    height: 0;
    border: 4px solid transparent;
  }
  .tl-marker-label {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: hsl(var(--brand-text));
    white-space: nowrap;
  }
  .tl-edge {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .tl-edge::before {
    content: '';
    position: absolute;
    background: hsl(var(--border));
  }
  .tl-edge-label,
  .tl-span-label {
    position: relative;
    z-index: 1;
    padding: 0.125rem 0.375rem;
    font-size: 11px;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background));
    text-align: center;
  }
  .tl-span {
    position: relative;
    display: flex;
    border: 1px solid hsl(var(--border));
  }
  .tl-span.loop::before {
    position: absolute;
  }

  /* Row: one column per beat, one per connector. */
  @container (min-width: 640px) {
    .tl {
      grid-template-columns: var(--cols);
      grid-template-rows: auto auto auto;
    }
    .tl-beat {
      grid-column: calc(var(--i) * 2 + 1);
      grid-row: 2;
    }
    .tl-marker {
      grid-column: calc(var(--i) * 2 + 1);
      grid-row: 1;
      flex-direction: column;
    }
    /* label, then a hairline down, then an arrowhead onto the beat */
    .tl-marker::before {
      order: 1;
      width: 1px;
      height: 0.625rem;
      margin-top: 0.125rem;
      border: 0;
      background: hsl(var(--border));
    }
    .tl-marker::after {
      order: 2;
      border-top-color: hsl(var(--border));
    }
    .tl-edge {
      grid-column: calc(var(--i) * 2 + 2);
      grid-row: 2;
      min-height: 1rem;
    }
    .tl-edge::before {
      left: 0;
      right: 0;
      top: 50%;
      height: 1px;
    }
    .tl-span {
      grid-column: calc(var(--from) * 2 + 1) / calc(var(--to) * 2 + 2);
      grid-row: 3;
      margin: 0.5rem 0.25rem 0.6em;
      height: 1.25rem;
      border-top: 0;
      justify-content: center;
      align-items: flex-end;
    }
    .tl-span-label {
      bottom: -0.6em;
    }
    .tl-span.loop::before {
      left: -4px;
      top: -7px;
      border-bottom-color: hsl(var(--brand-text));
    }
  }

  /* Column: beats stack, connectors go vertical, spans bracket the left. */
  @container (max-width: 639.98px) {
    .tl {
      grid-template-columns: auto auto minmax(0, 1fr);
      column-gap: 0.5rem;
      padding-left: 0.5rem;
    }
    .tl-beat {
      grid-column: 2;
      grid-row: calc(var(--i) * 2 + 1);
    }
    .tl-marker {
      grid-column: 3;
      grid-row: calc(var(--i) * 2 + 1);
    }
    /* an arrowhead pointing at the beat, then the label */
    .tl-marker::before {
      border-right-color: hsl(var(--border));
      margin-right: 0.25rem;
    }
    .tl-marker::after {
      display: none;
    }
    .tl-edge {
      grid-column: 2;
      grid-row: calc(var(--i) * 2 + 2);
      min-height: 1.5rem;
    }
    .tl-edge::before {
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
    }
    .tl-span {
      grid-column: 1;
      grid-row: calc(var(--from) * 2 + 1) / calc(var(--to) * 2 + 2);
      width: 1.25rem;
      margin: 0.25rem 0.25rem 0.25rem 0;
      border-right: 0;
      justify-content: flex-start;
      align-items: center;
    }
    .tl-span-label {
      left: -0.6em;
      padding: 0.375rem 0.125rem;
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }
    .tl-span.loop::before {
      right: -7px;
      top: -4px;
      border-left-color: hsl(var(--brand-text));
    }
  }
</style>
