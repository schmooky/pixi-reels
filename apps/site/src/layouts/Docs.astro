---
import Base from './Base.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import { LEARN_NAV, REFERENCE_NAV, type NavSection } from '../content/nav.ts';
import { articleLd, breadcrumbLd, SITE } from '../lib/seo.ts';

type Section = 'learn' | 'reference' | 'api';

interface Props {
  title?: string;
  description?: string;
  section?: Section;
  eyebrow?: string;
  frontmatter?: {
    title?: string;
    /** The browser and search title, when it should say more than the heading. */
    seoTitle?: string;
    description?: string;
    section?: Section;
    eyebrow?: string;
  };
}

const props = Astro.props as Props;
const fm = props.frontmatter ?? {};
const title = props.title ?? fm.title ?? 'pixi-reels';
const description =
  props.description ??
  fm.description ??
  `${title}. pixi-reels, open-source slot machine reel engine for PixiJS v8.`;
const section = (props.section ?? fm.section ?? 'learn') as Section;
const eyebrow = props.eyebrow ?? fm.eyebrow;
const pathname = Astro.url.pathname;

// Auto-detect the API and reference sections by URL when frontmatter doesn't
// set them. TypeDoc-generated pages live under /api/, hand-written narrative
// under /reference/.
const resolvedSection: Section = section === 'learn' && pathname.startsWith('/api/')
  ? 'api'
  : section === 'learn' && pathname.startsWith('/reference/')
    ? 'reference'
    : section;

const navMap: Record<Section, NavSection[]> = {
  learn: LEARN_NAV,
  reference: REFERENCE_NAV,
  api: REFERENCE_NAV,
};
const nav = navMap[resolvedSection] ?? [];

const sectionLabel: Record<Section, string> = {
  learn: 'Learn',
  reference: 'Reference',
  api: 'API reference',
};

const jsonLd = [
  articleLd({ title, description, path: pathname }),
  breadcrumbLd([
    { name: SITE.name, url: '/' },
    { name: sectionLabel[resolvedSection], url: `/${resolvedSection}/` },
    { name: title, url: pathname },
  ]),
];
---
<Base
  title={`${fm.seoTitle ?? title} · ${SITE.name}`}
  description={description}
  path={pathname}
  type="article"
  article={{ section: sectionLabel[resolvedSection] }}
  jsonLd={jsonLd}
>
  <div class="container grid gap-10 py-12 md:grid-cols-[220px_minmax(0,1fr)]">
    {nav.length > 0 && <DocsSidebar nav={nav} pathname={pathname} />}
    <article class:list={["prose-docs min-w-0 max-w-3xl animate-fade-in", { 'md:col-span-2 mx-auto': nav.length === 0 }]}>
      <p class="eyebrow my-0 leading-none">{eyebrow ?? sectionLabel[resolvedSection]}</p>
      <h1 class="display mb-8 mt-4 text-4xl sm:text-5xl">{title}</h1>
      <slot />
    </article>
  </div>
</Base>
