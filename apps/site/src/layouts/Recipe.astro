---
import Base from './Base.astro';
import { articleLd, breadcrumbLd, SITE } from '../lib/seo.ts';
import RealGameVideo from '../components/RealGameVideo.astro';

interface RealGameVideoFrontmatter {
  webm?: string;
  mp4?: string;
  caption: string;
}

interface Props {
  title?: string;
  description?: string;
  tags?: string[];
  realGameVideo?: RealGameVideoFrontmatter;
  frontmatter?: {
    title?: string;
    description?: string;
    tags?: string[];
    realGameVideo?: RealGameVideoFrontmatter;
  };
}
const props = Astro.props as Props;
const fm = props.frontmatter ?? {};
const title = props.title ?? fm.title ?? 'Recipe';
const description = props.description ?? fm.description ?? `${title}. step-by-step slot recipe built with pixi-reels.`;
const tags = props.tags ?? fm.tags ?? [];
const realGameVideo = props.realGameVideo ?? fm.realGameVideo;
const pathname = Astro.url.pathname;

const jsonLd = [
  articleLd({ title, description, path: pathname }),
  // No HowTo here: a recipe page is an umbrella of independent demos, not an
  // ordered procedure. It used to emit one anyway, built from a `steps` field
  // that was `[]` on all twelve pages - i.e. a schema.org HowTo with zero
  // steps on every recipe URL.
  breadcrumbLd([
    { name: SITE.name, url: '/' },
    { name: 'Recipes', url: '/recipes/' },
    { name: title, url: pathname },
  ]),
];
---
<Base
  title={`${title} · ${SITE.name} recipe`}
  description={description}
  path={pathname}
  type="article"
  article={{ section: 'Recipes', tags }}
  jsonLd={jsonLd}
>
  <div class="container max-w-[880px] py-10 animate-fade-in">
    <header class="mb-10 border-b border-border pb-8">
      <a href="/recipes/" class="group inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground transition-colors hover:text-foreground">
        <svg class="h-3.5 w-3.5 transition-transform duration-[133ms] ease-[cubic-bezier(0.333,1.6,0.667,1)] group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 6l-6 6 6 6" />
        </svg>
        All recipes
      </a>
      <p class="eyebrow mt-8 flex">Recipe</p>
      <h1 class="display mt-4 text-4xl sm:text-5xl lg:text-6xl">{title}</h1>
      {description && <p class="mt-5 max-w-[620px] text-lg leading-relaxed text-muted-foreground">{description}</p>}
    </header>

    {realGameVideo && (
      <div class="mb-8">
        <RealGameVideo
          webm={realGameVideo.webm}
          mp4={realGameVideo.mp4}
          caption={realGameVideo.caption}
        />
      </div>
    )}

    <article class="prose-docs">
      <slot />
    </article>
  </div>
</Base>
