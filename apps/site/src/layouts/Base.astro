---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';
import { SITE, ogUrlForPath, type PageSeo } from '../lib/seo.ts';

interface Props extends Partial<PageSeo> {
  title?: string;
  description?: string;
}
const {
  title = `${SITE.name}. ${SITE.tagline}`,
  description = SITE.description,
  path,
  image,
  type,
  article,
  jsonLd,
  noIndex,
} = Astro.props as Props;

// Every route gets its own generated OG card (pages/og/[...path].png.ts),
// resolved from the path. A page can still override via the `image` prop.
const ogImage = image ?? ogUrlForPath(path ?? Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    {/*
      Set the theme class before first paint so there's no flash of the wrong
      mode. Reads an explicit choice from localStorage, else the OS preference.
      Kept inline (is:inline) so it ships verbatim and runs synchronously.
    */}
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const dark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', dark);
        // Lets CSS keep scroll-reveal blocks visible when scripts never run.
        document.documentElement.classList.add('js');
      })();
    </script>
    {/*
      A page the browser kept from before a deploy names island scripts
      (`/_astro/<name>.<hash>.js`) that the deploy removed. The host answers a
      missing file with the HTML page and status 200, so the island's import
      fails and it never renders: the landing reels stayed on "Warming up the
      reels". When an island script fails to load, reload once to fetch the
      current page.
    */}
    <script is:inline>
      (() => {
        const KEY = 'stale-island-reload';
        // Astro (7.3+) dispatches this from the island after its own retry
        // of the import failed; a failure inside the component is left alone.
        document.addEventListener('astro:hydration-error', (event) => {
          const error = event.detail && event.detail.error;
          const message = String((error && error.message) || error || '');
          // Chrome / Edge, Safari, Firefox wordings for a failed dynamic import.
          if (!/dynamically imported module|Importing a module script failed|error loading dynamically imported module/i.test(message)) return;
          // At most one reload a minute, so a script that is broken for good
          // shows its error instead of looping. Without sessionStorage there is
          // no way to tell, so no reload.
          try {
            const last = Number(sessionStorage.getItem(KEY) || 0);
            if (Date.now() - last < 60000) return;
            sessionStorage.setItem(KEY, String(Date.now()));
          } catch {
            return;
          }
          console.warn('pixi-reels: an island script failed to load; reloading once for the current page.', event.detail.componentUrl);
          location.reload();
        });
      })();
    </script>
    <SEO
      title={title}
      description={description}
      path={path}
      image={ogImage}
      type={type}
      article={article}
      jsonLd={jsonLd}
      noIndex={noIndex}
    />
    {/*
      Bricolage Grotesque is the display face for landing headlines (the
      optical-size axis keeps it tight at 96px and open at 24px).
      Roboto Condensed is used by the debug CardSymbol inside recipe canvases;
      Fira Code is the readout face for recipe HUDs and per-reel labels, where
      its ligatures turn an ASCII `->` into a single arrow glyph - which both
      reads better and is narrower, and narrow matters when a label has to fit
      inside one reel's width.

      All three are in ONE request so this stays a single stylesheet, loaded
      asynchronously so it never blocks first paint on pages that render
      neither. Pattern: preload + onload-promote, with a no-JS fallback.
      https://web.dev/articles/defer-non-critical-css
    */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Fira+Code:wght@400;500&family=Roboto+Condensed:wght@400;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Fira+Code:wght@400;500&family=Roboto+Condensed:wght@400;700&display=swap"
      />
    </noscript>
  </head>
  <body>
    <Nav />
    <main><slot /></main>
    <Footer />
  </body>
</html>
