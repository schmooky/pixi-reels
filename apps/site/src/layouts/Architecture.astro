---
import Base from './Base.astro';
import DocsSidebar from '../components/DocsSidebar.astro';
import { articleLd, breadcrumbLd, SITE } from '../lib/seo.ts';
import { ARCH_PAGES } from '../content/architectureNav.ts';
import { WIKI_NAV } from '../content/nav.ts';

interface Props {
  title?: string;
  subtitle?: string;
  eyebrow?: string;
  description?: string;
  frontmatter?: {
    title?: string;
    subtitle?: string;
    eyebrow?: string;
    description?: string;
  };
}
const props = Astro.props as Props;
const fm = props.frontmatter ?? {};
const title = props.title ?? fm.title ?? 'Architecture';
const subtitle = props.subtitle ?? fm.subtitle ?? '';
const eyebrow = props.eyebrow ?? fm.eyebrow ?? 'Architecture';
const description = props.description ?? fm.description ?? `${title}. pixi-reels architecture deep dive.`;
const pathname = Astro.url.pathname;

const jsonLd = [
  articleLd({ title, description, path: pathname }),
  breadcrumbLd([
    { name: SITE.name, url: '/' },
    { name: 'Docs', url: '/docs/' },
    { name: 'Architecture', url: '/docs/#architecture' },
    { name: title, url: pathname },
  ]),
];

const currentSlug = pathname.replace(/^\/architecture\//, '').replace(/\/$/, '');
const currentIdx = ARCH_PAGES.findIndex((p) => p.slug === currentSlug);
const prev = currentIdx > 0 ? ARCH_PAGES[currentIdx - 1] : null;
const next = currentIdx >= 0 && currentIdx < ARCH_PAGES.length - 1 ? ARCH_PAGES[currentIdx + 1] : null;

const nudge = 'h-3.5 w-3.5 transition-transform duration-[133ms] ease-[cubic-bezier(0.333,1.6,0.667,1)]';
---
<Base
  title={`${title} · ${SITE.name} architecture`}
  description={description}
  path={pathname}
  type="article"
  article={{ section: 'Architecture' }}
  jsonLd={jsonLd}
>
  <div class="container grid gap-10 py-12 lg:grid-cols-[220px_minmax(0,1fr)]">
    <DocsSidebar nav={WIKI_NAV} pathname={pathname} breakpoint="lg" />

    <article class="prose-docs arch-article min-w-0 max-w-[820px] animate-fade-in">
      <a href="/docs/" class="group not-prose mb-8 inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground transition-colors hover:text-foreground">
        <svg class:list={[nudge, 'group-hover:-translate-x-1']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
          <path d="M19 12H5M11 18l-6-6 6-6" />
        </svg>
        Docs / Architecture
      </a>
      <div class="eyebrow mt-8 flex">{eyebrow}</div>
      <h1 class="display mt-4 mb-4 text-4xl leading-[1] sm:text-5xl lg:text-6xl">{title}</h1>
      {subtitle && <p class="mb-10 max-w-2xl text-lg leading-relaxed text-muted-foreground sm:text-xl">{subtitle}</p>}

      <slot />

      {(prev || next) && (
        <nav class="not-prose mt-16 grid border-t border-border sm:grid-cols-2">
          {prev ? (
            <a href={`/architecture/${prev.slug}/`} class="group flex flex-col border-b border-border py-6 sm:border-r sm:pr-6">
              <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground transition-colors group-hover:text-foreground">
                <svg class:list={[nudge, 'group-hover:-translate-x-1']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
                  <path d="M19 12H5M11 18l-6-6 6-6" />
                </svg>
                Previous
              </span>
              <span class="mt-3 font-display text-xl font-bold tracking-tight">{prev.title}</span>
              <span class="mt-1 text-sm text-muted-foreground">{prev.subtitle}</span>
            </a>
          ) : <div class="hidden border-b border-border sm:block sm:border-r"></div>}
          {next ? (
            <a href={`/architecture/${next.slug}/`} class="group flex flex-col items-end border-b border-border py-6 text-right sm:pl-6">
              <span class="inline-flex items-center gap-1.5 font-mono text-[11px] uppercase tracking-[0.18em] text-muted-foreground transition-colors group-hover:text-foreground">
                Next
                <svg class:list={[nudge, 'group-hover:translate-x-1']} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden>
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </span>
              <span class="mt-3 font-display text-xl font-bold tracking-tight">{next.title}</span>
              <span class="mt-1 text-sm text-muted-foreground">{next.subtitle}</span>
            </a>
          ) : <div class="hidden border-b border-border sm:block"></div>}
        </nav>
      )}
    </article>
  </div>
</Base>
